tant;\n        width: 100% !important;\n      }\n      #content.centered {\n        grid-template-columns: minmax(0, 1fr) !important;\n        grid-template-rows: 1fr !important;\n        grid-template-areas: \"main\" !important;\n      }\n      /*\n        Mobile collection carousel. v15 wrote it as \"#article .block.collection.mobile .entries\"\n        (1,3,1) with no !important, so a shop's own \".block.collection.mobile .entries\" rule of the\n        same specificity, loaded later, could turn it back into a grid (soundmetaphors: \"1fr 1fr\").\n        The doubled class keeps that specificity without needing \".mobile\", which is only added on\n        the client: a shop's plain \"#article .block.collection .entries\" desktop rule (1,2,1) still\n        loses to it here, as it did on v15.\n      */\n      #article .block.collection .content.content,\n      #article .block.playlist .content.content {\n        max-width: 100%;\n        display: grid;\n      }\n      #article .block.collection .entries.entries,\n      #article .block.playlist .entries.entries {\n        -ms-overflow-style: none;\n        scrollbar-width: none;\n        --visible-cols: var(--collection-columns);\n        --col-gap: var(--gutter);\n        --col-hint: var(--gutter);\n        --scrollbar-padding: 20px;\n        --col-size: calc((100% / var(--visible-cols)) - var(--col-gap) - var(--col-hint));\n        display: grid;\n        grid-auto-flow: column;\n        grid-template-columns: var(--col-size);\n        grid-auto-columns: var(--col-size);\n        overflow-x: auto;\n        overflow-y: hidden;\n        grid-gap: var(--col-gap);\n      }\n      #article .block.collection .entries.entries::-webkit-scrollbar,\n      #article .block.playlist .entries.entries::-webkit-scrollbar {\n        display: none;\n      }\n      #article .row.twoColumn,\n      #article .row.threeColumn {\n        grid-template-columns: 1fr !important;\n      }\n      #article .block.items .entries:not(.listView):