<script id="bordello-speler-wit-js">
(function(){
	'use strict';
	if(window.bordelloSpelerWit||!window.jQuery)return;
	window.bordelloSpelerWit=true;
	var $=window.jQuery;
	var endpoint="\/?wc-ajax=%%endpoint%%";
	var cart='<svg viewBox="0 0 24 24"><path d="M3 4h3l2.4 10.2a1 1 0 001 .8h8.2a1 1 0 001-.8L20 8H7" fill="none"/><circle class="f" cx="10" cy="19.5" r="1.7"/><circle class="f" cx="17" cy="19.5" r="1.7"/></svg>';
	var bell='<svg viewBox="0 0 24 24"><path d="M6 17V11a6 6 0 1112 0v6l2 2H4z"/><path d="M10 21a2 2 0 004 0"/></svg>';
	var arrow='<svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>';
	var playSvg='<svg viewBox="0 0 12 12"><path d="M2 1l9 5-9 5z"/></svg>';
	var tracks=[];
	var info={};
	var pending={};
	var closed={};
	var queued=false;
	var groups=[];

	function ajaxUrl(a){return endpoint.replace('%%endpoint%%',a);}
	function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
	function hostOf(u){try{return new URL(u,location.href).hostname.replace(/^www\./,'');}catch(e){return '';}}
	function sameHost(u){return hostOf(u)===location.hostname.replace(/^www\./,'');}

	// Productpagina van een track: een link op dezelfde site die niet het audiobestand of de hoes is.
	function releaseUrl(t){
		if(!t)return '';
		if(typeof t.permalink_url==='string'&&t.permalink_url)return t.permalink_url;
		var best='';
		Object.keys(t).forEach(function(k){
			var v=t[k];
			if(best||typeof v!=='string'||!v||v===t.stream_url)return;
			if(!/^(https?:)?\/\/|^\//.test(v))return;
			if(/\/wp-content\/uploads\//.test(v)||/\.(mp3|m4a|ogg|wav|jpe?g|png|webp|gif)(\?|$)/i.test(v))return;
			if(/^(https?:)?\/\//.test(v)&&!sameHost(v))return;
			best=v;
		});
		return best;
	}
	function coverOf(t){
		if(!t)return '';
		if(typeof t.artwork_url==='string'&&t.artwork_url)return t.artwork_url;
		if(typeof t.cover==='string'&&t.cover)return t.cover;
		var found='';
		Object.keys(t).forEach(function(k){var v=t[k];if(!found&&typeof v==='string'&&/\.(jpe?g|png|webp|gif)(\?|$)/i.test(v))found=v;});
		return found;
	}
	// Producttitels zijn vaak "Artiest | Titel": dan de artiest niet nog eens ervoor zetten.
	function relTitle(r){
		var t=String(r.title||'').trim();
		if(t.indexOf('|')>=0)return t.replace(/\s*\|\s*/,' – ');
		return (r.artist&&t.toLowerCase().indexOf(String(r.artist).toLowerCase())!==0?r.artist+' – ':'')+t;
	}
	// Winkelwagenteller in de header bijwerken, zoals bordello-speler-kopen doet.
	function updateCount(fragments){
		var count=null;
		var html=fragments&&fragments['div.widget_shopping_cart_content'];
		if(html){
			var q=$('<div>').html(html).find('.woocommerce-mini-cart-item .quantity');
			if(q.length){count=0;q.each(function(){count+=parseInt($(this).text(),10)||0;});}
		}
		$('.show-cartss').each(function(){
			var now=parseInt($(this).text(),10)||0;
			$(this).text(count!==null?count:now+1);
		});
	}
	/* ---------- Wachtlijst vanuit het paneel (zelfde aanroepen als bordello-speler-kopen) ---------- */
	var joined={};
	var statusCache={};
	var popup=null,popupId=0,popupRect=null;
	var check='<svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>';
	function isLoggedIn(){return document.body.classList.contains('logged-in')||!!(window.wcwl_data&&parseInt(window.wcwl_data.user_id,10)>0);}
	function pluginText(key,fallback){return window.wcwl_data&&window.wcwl_data[key]?window.wcwl_data[key]:fallback;}
	function wlStatus(id,fresh){
		if(fresh||!statusCache[id]){
			statusCache[id]=$.ajax({url:ajaxUrl('bordello_waitlist_status'),type:'POST',data:{product_id:id},dataType:'json'});
			statusCache[id].fail(function(){delete statusCache[id];});
		}
		return statusCache[id];
	}
	function readMessage(response){
		if(response&&response.success&&response.data&&response.data.html){
			var doc=new DOMParser().parseFromString(response.data.html,'text/html');
			var p=doc.querySelector('.wcwl_notice p');
			return p?$.trim(p.textContent):'';
		}
		return response&&typeof response.data==='string'?response.data:'';
	}
	function openPage(url){
		var a=document.createElement('a');a.href=url;a.style.display='none';
		document.body.appendChild(a);a.click();document.body.removeChild(a);
	}
	function outsideClick(e){if(popup&&!popup.contains(e.target)&&!(e.target.closest&&e.target.closest('.bpl-wait')))closePopup();}
	function escKey(e){if('Escape'===e.key)closePopup();}
	function closePopup(){
		if(popup&&popup.parentNode)popup.parentNode.removeChild(popup);
		popup=null;
		document.removeEventListener('mousedown',outsideClick,true);
		document.removeEventListener('touchstart',outsideClick,true);
		document.removeEventListener('keydown',escKey,true);
		window.removeEventListener('resize',placePopup);
	}
	function placePopup(){
		if(!popup)return;
		var el=document.querySelector('.bpl-wait[data-wait="'+popupId+'"]');
		var r=el?el.getBoundingClientRect():popupRect;
		if(!r)return;
		popupRect=r;
		popup.style.left=Math.max(8,Math.min(r.left,window.innerWidth-popup.offsetWidth-8))+'px';
		popup.style.bottom=Math.max(8,window.innerHeight-r.top+8)+'px';
	}
	function showPopup(id,url,st,mode,message){
		closePopup();
		popupId=id;
		popup=document.createElement('div');
		popup.className='bordello-wl';
		popup.setAttribute('role','dialog');
		popup.setAttribute('aria-label','Waitlist');
		var html='<button type="button" class="bordello-wl-close" aria-label="Close">&times;</button>';
		if('login'===mode){
			html+='<p class="bordello-wl-text">Log in or create an account to join the waitlist for this record.</p><a class="bordello-wl-button" href="'+esc(st.login_url)+'">Log in / Register</a>';
		}else if('form'===mode){
			html+='<form class="bordello-wl-form" novalidate><p class="bordello-wl-text">Get an email as soon as this record is available.</p>'
				+(st.logged_in?'':'<input type="email" class="bordello-wl-email" placeholder="Email address" autocomplete="email" aria-label="Email address">')
				+(st.optin?'<label class="bordello-wl-optin"><input type="checkbox"><span>'+esc(st.optin_text)+'</span></label>':'')
				+'<button type="submit" class="bordello-wl-button">Join waitlist</button></form>';
		}else{
			html+='<p class="bordello-wl-text">'+esc(message)+'</p>';
		}
		html+='<p class="bordello-wl-msg" aria-live="polite"></p>';
		popup.innerHTML=html;
		document.body.appendChild(popup);
		placePopup();
		popup.querySelector('.bordello-wl-close').addEventListener('click',closePopup);
		document.addEventListener('mousedown',outsideClick,true);
		document.addEventListener('touchstart',outsideClick,true);
		document.addEventListener('keydown',escKey,true);
		window.addEventListener('resize',placePopup);
		var form=popup.querySelector('form');
		if(!form)return;
		var emailField=form.querySelector('.bordello-wl-email');
		var box=form.querySelector('.bordello-wl-optin input');
		var submit=form.querySelector('button[type="submit"]');
		var note=popup.querySelector('.bordello-wl-msg');
		if(emailField)emailField.focus();
		form.addEventListener('submit',function(ev){
			ev.preventDefault();
			var email=st.logged_in?st.email:$.trim(emailField.value);
			if(!st.logged_in&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){note.textContent=pluginText('email_error_message','Please enter a valid email address.');return;}
			if(box&&!box.checked){note.textContent=pluginText('optin_error_message','Please tick the box to agree.');return;}
			submit.disabled=true;
			note.textContent=pluginText('loading_message','Adding you to the waitlist')+'…';
			join(id,url,st,email,function(ok,text){
				submit.disabled=false;
				if(ok){form.hidden=true;note.textContent=text||'You have been added to the waitlist for this record.';setTimeout(closePopup,2500);}
				else{note.textContent=text||'Something went wrong, please try again.';}
			});
		});
	}
	function join(id,url,st,email,done){
		function finish(ok,message){
			if(ok){joined[id]=true;schedule();}
			if(done)done(ok,message);
			else if(!ok)showPopup(id,url,st,'message',message||'Something went wrong, please try again.');
			else showPopup(id,url,st,'message',message||'You have been added to the waitlist for this record.'),setTimeout(closePopup,2500);
		}
		$.ajax({url:st.ajax_url,type:'POST',dataType:'json',data:{action:'wcwl_process_user_waitlist_request',nonce:st.nonce,product_id:id,email:email,context:'join',language:'',archive:'false'}})
			.done(function(response){
				var message=readMessage(response);
				var accountCreated=!!(response&&response.success&&response.data&&response.data.redirectUrl!==undefined);
				if(st.logged_in){
					wlStatus(id,true).done(function(s2){finish(!!(s2&&s2.ok&&s2.on_waitlist),message);}).fail(function(){finish(false,message);});
				}else{
					finish(accountCreated||/added|already/i.test(message),message);
				}
			})
			.fail(function(){finish(false,'');});
	}
	function waitlistClick(pillEl){
		var id=parseInt(pillEl.getAttribute('data-wait'),10),url=pillEl.getAttribute('data-url');
		if(pillEl.classList.contains('is-loading'))return;
		pillEl.classList.add('is-loading');
		wlStatus(id,true)
			.done(function(st){
				pillEl.classList.remove('is-loading');
				if(!st||!st.ok){openPage(url);}
				else if(st.on_waitlist){joined[id]=true;schedule();}
				else if(st.must_login){showPopup(id,url,st,'login');}
				else if(st.logged_in&&!st.optin){join(id,url,st,st.email);}
				else{showPopup(id,url,st,'form');}
			})
			.fail(function(){pillEl.classList.remove('is-loading');openPage(url);});
	}

	function pathOf(u){try{return new URL(u,location.href).pathname;}catch(e){return u;}}

	function listItems(){return document.querySelectorAll('.fap-wrapper .fap-list > .fap-item');}
	function itemTitle(el){var t=el.querySelector('.fap-title');return (t?t.textContent:el.textContent||'').replace(/\s+/g,' ').trim();}
	function trackTitle(t){return String(t&&t.title||'').replace(/\s+/g,' ').trim();}

	// Na verwijderen in de speler: tracks bijhouden die nog in de lijst staan.
	function reconcile(){
		var items=listItems();
		if(!tracks.length||items.length===tracks.length)return items.length===tracks.length;
		var out=[],j=0;
		for(var i=0;i<tracks.length&&j<items.length;i++){
			if(trackTitle(tracks[i])===itemTitle(items[j])){out.push(tracks[i]);j++;}
		}
		if(j===items.length){tracks=out;return true;}
		return false;
	}

	function buildGroups(){
		groups=[];
		var last=null;
		tracks.forEach(function(t,i){
			var url=releaseUrl(t),key=url?pathOf(url):coverOf(t)||('t'+i);
			if(!last||last.key!==key){last={key:key,url:url,cover:coverOf(t),idx:[],names:[]};groups.push(last);}
			last.idx.push(i);last.names.push(trackTitle(t));
		});
	}

	function lookup(g){
		if(!g.url||info[g.key]||pending[g.key])return;
		pending[g.key]=true;
		$.ajax({url:ajaxUrl('bordello_release_info'),data:{url:pathOf(g.url)},dataType:'json'})
			.done(function(r){
				info[g.key]=r&&r.found?r:{found:false};
				if(r&&r.found&&r.simple&&!r.buyable&&(!r.in_stock||r.upcoming)&&isLoggedIn()&&joined[r.id]===undefined){
					joined[r.id]=false;
					wlStatus(r.id).done(function(st){if(st&&st.ok&&st.on_waitlist){joined[r.id]=true;schedule();}});
				}
			})
			.fail(function(){info[g.key]={found:false};})
			.always(function(){delete pending[g.key];schedule();});
	}

	function pill(g,r){
		if(!r||!r.found)return '';
		if(r.buyable)return '<a href="#" class="bpl-pill bpl-buy" data-id="'+r.id+'" data-url="'+esc(r.url)+'" title="Add to cart">'+esc(r.price)+'<b>'+cart+'</b></a>';
		if(!r.in_stock||r.upcoming){
			if(joined[r.id]===true)return '<a href="'+esc(r.url)+'" class="bpl-pill bpl-wait ajaxme" title="You are on the waitlist for this record"><b>'+check+'</b>On waitlist</a>';
			if(r.simple)return '<a href="#" class="bpl-pill bpl-wait" data-wait="'+r.id+'" data-url="'+esc(r.url)+'" title="Join the waitlist"><b>'+bell+'</b>Waitlist</a>';
			return '<a href="'+esc(r.url)+'" class="bpl-pill bpl-wait ajaxme" title="Join the waitlist"><b>'+bell+'</b>Waitlist</a>';
		}
		return '<a href="'+esc(r.url)+'" class="bpl-pill ajaxme">'+esc(r.price)+'<b>'+arrow+'</b></a>';
	}

	function render(){
		queued=false;
		var wrapper=document.querySelector('.fap-wrapper');
		var holder=wrapper&&wrapper.querySelector('.fap-playlist-wrapper');
		var toggle=wrapper&&wrapper.querySelector('.fap-toggle-playlist');
		if(!wrapper||!holder)return;

		var ok=tracks.length&&reconcile();
		if(ok)buildGroups();

		if(toggle){
			var n=ok?groups.length:listItems().length;
			if(toggle.getAttribute('data-count')!==String(n))toggle.setAttribute('data-count',n);
		}

		var panel=document.getElementById('bordello-pl');
		if(!ok||!groups.length){
			wrapper.classList.remove('bordello-grouped');
			if(panel)panel.remove();
			updateSub();
			return;
		}
		wrapper.classList.add('bordello-grouped');
		groups.forEach(lookup);
		var sig=groups.map(function(g){return g.key+':'+g.idx.join('.')+':'+g.names.join('|');}).join('||')+'#'+Object.keys(info).map(function(k){return k+(info[k].found?1:0);}).join(',')+'#'+Object.keys(joined).filter(function(k){return joined[k];}).join(',');
		if(panel&&panel.getAttribute('data-sig')===sig){markActive();return;}
		if(!panel){
			panel=document.createElement('div');
			panel.id='bordello-pl';
			holder.insertBefore(panel,holder.firstChild);
		}

		var html='<div class="bpl-head"><b>Playlist</b><span>'+groups.length+(groups.length===1?' release':' releases')+' · '+tracks.length+' tracks</span></div>';
		groups.forEach(function(g,gi){
			var r=info[g.key];
			var title=r&&r.found?relTitle(r):(g.names[0]||'Release');
			var meta=(r&&r.found&&r.label?r.label+' · ':'')+g.idx.length+(g.idx.length===1?' track':' tracks');
			var cover=g.cover||(r&&r.thumb)||'';
			html+='<div class="bpl-rel'+(closed[g.key]?' closed':'')+'" data-g="'+gi+'">'
				+'<div class="bpl-rh"><div class="bpl-cov"'+(cover?' style="background-image:url(\''+esc(cover)+'\')"':'')+'></div>'
				+'<div style="min-width:0"><div class="bpl-t">'+esc(title)+'</div><div class="bpl-m">'+esc(meta)+'</div></div>'
				+(pill(g,r)||'<span></span>')
				+'<span class="bpl-x" title="Remove release">×</span><span class="bpl-chev">⌄</span></div>'
				+'<ul class="bpl-tk">';
			g.idx.forEach(function(ti,k){
				html+='<li data-i="'+ti+'"><span class="bpl-pl">'+playSvg+'</span><span class="bpl-name">'+esc(g.names[k])+'</span></li>';
			});
			html+='</ul></div>';
		});
		panel.setAttribute('data-sig',sig);
		panel.innerHTML=html;
		markActive();
	}

	// Regel onder de titel: artiest · release · track x van y
	function updateSub(){
		var meta=document.querySelector('.fap-wrapper .fap-meta');
		if(!meta)return;
		var el=meta.querySelector('.bpl-sub');
		var items=listItems(),a=-1,i;
		for(i=0;i<items.length;i++){if(items[i].classList.contains('fap-active')){a=i;break;}}
		var g=null,k=0;
		if(a>=0)groups.forEach(function(gr){var p=gr.idx.indexOf(a);if(p>=0){g=gr;k=p;}});
		if(!g){if(el)el.remove();return;}
		var r=info[g.key],parts=[];
		if(r&&r.found){parts.push(relTitle(r));}
		parts.push('track '+(k+1)+' of '+g.idx.length);
		if(!el){el=document.createElement('div');el.className='bpl-sub';meta.appendChild(el);}
		var text=parts.join(' · ');
		if(el.textContent!==text)el.textContent=text;
	}

	function markActive(){
		var panel=document.getElementById('bordello-pl');
		if(!panel){updateSub();return;}
		var items=listItems(),a=-1;
		for(var i=0;i<items.length;i++){if(items[i].classList.contains('fap-active')){a=i;break;}}
		panel.querySelectorAll('.bpl-tk li').forEach(function(li){li.classList.toggle('on',parseInt(li.getAttribute('data-i'),10)===a);});		updateSub();
	}

	function schedule(){if(!queued){queued=true;window.requestAnimationFrame(render);}}

	document.addEventListener('click',function(e){
		var panel=e.target.closest&&e.target.closest('#bordello-pl');
		if(!panel)return;
		var rel=e.target.closest('.bpl-rel');
		var g=rel?groups[parseInt(rel.getAttribute('data-g'),10)]:null;
		if(!g)return;

		var buy=e.target.closest('.bpl-buy');
		if(buy){
			e.preventDefault();e.stopPropagation();
			if(buy.classList.contains('is-loading'))return;
			buy.classList.add('is-loading');
			$.ajax({url:ajaxUrl('add_to_cart'),type:'POST',dataType:'json',data:{product_id:buy.getAttribute('data-id'),quantity:1}})
				.done(function(res){
					if(res&&res.error&&res.product_url){window.location.href=res.product_url;return;}
					$(document.body).trigger('added_to_cart',[res&&res.fragments,res&&res.cart_hash]);
					updateCount(res&&res.fragments);
					$('#added-alert').stop(true,true).fadeIn('slow').delay(1500).fadeOut('slow');
					var before=buy.innerHTML;
					buy.innerHTML='Added<b><svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg></b>';
					setTimeout(function(){if(document.body.contains(buy))buy.innerHTML=before;},2500);
				})
				.fail(function(){window.location.href=buy.getAttribute('data-url');})
				.always(function(){buy.classList.remove('is-loading');});
			return;
		}
		var wl=e.target.closest('.bpl-wait[data-wait]');
		if(wl){e.preventDefault();e.stopPropagation();waitlistClick(wl);return;}
		if(e.target.closest('a.bpl-pill'))return;

		if(e.target.closest('.bpl-x')){
			e.preventDefault();e.stopPropagation();
			var items=listItems();
			try{if($.fullwidthAudioPlayer&&$.fullwidthAudioPlayer.pause)$.fullwidthAudioPlayer.pause();}catch(err){}
			g.idx.slice().reverse().forEach(function(i){var rm=items[i]&&items[i].querySelector('.fap-remove');if(rm)rm.click();});
			return;
		}
		if(e.target.closest('.bpl-rh')){
			closed[g.key]=!closed[g.key];
			rel.classList.toggle('closed',!!closed[g.key]);
			return;
		}
		var li=e.target.closest('.bpl-tk li');
		if(li){
			var it=listItems()[parseInt(li.getAttribute('data-i'),10)];
			if(it){var t=it.querySelector('.fap-title')||it;t.click();}
		}
	},true);

	$(document).on('onFapTracksAdded','#fap',function(e,t){tracks=Array.isArray(t)?t.slice():[];schedule();});
	$(document).on('onFapClear','#fap',function(){tracks=[];schedule();});

	function start(){
		schedule();
		if(window.MutationObserver){
			new MutationObserver(function(muts){
				for(var i=0;i<muts.length;i++){
					var m=muts[i];
					if(m.target&&m.target.closest&&m.target.closest('#bordello-pl'))continue;
					if(m.type==='attributes'){markActive();continue;}
					schedule();break;
				}
			}).observe(document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
		}
	}
	if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>
		<script id="bordello-related-js">
( function () {
	if ( window.bordelloRelated ) {
		return;
	}
	window.bordelloRelated = true;

	function update( box ) {
		var viewport = box.querySelector( '.bordello-related__viewport' );
		var track = box.querySelector( '.bordello-related__track' );
		var prev = box.querySelector( '.bordello-related__arrow--prev' );
		var next = box.querySelector( '.bordello-related__arrow--next' );
		if ( ! viewport || ! track || ! prev || ! next ) {
			return;
		}
		var max = track.scrollWidth - track.clientWidth;
		var overflow = max >= 4;
		prev.hidden = ! overflow;
		next.hidden = ! overflow;
		prev.disabled = track.scrollLeft < 4;
		next.disabled = track.scrollLeft > max - 4;

		// Pijltjes op het midden van de hoes.
		var thumb = track.querySelector( '.prod-thumb' );
		if ( thumb ) {
			var top = thumb.getBoundingClientRect().top - viewport.getBoundingClientRect().top + thumb.offsetHeight / 2;
			if ( top > 0 ) {
				viewport.style.setProperty( '--bordello-arrow-top', Math.round( top ) + 'px' );
			}
		}
	}

	var timer = null;
	function refresh() {
		window.clearTimeout( timer );
		timer = window.setTimeout( function () {
			Array.prototype.forEach.call( document.querySelectorAll( '.bordello-related' ), update );
		}, 30 );
	}

	// Eén pagina (de breedte van de rij) per klik.
	document.addEventListener( 'click', function ( event ) {
		var button = event.target && event.target.closest ? event.target.closest( '.bordello-related__arrow' ) : null;
		if ( ! button || button.disabled ) {
			return;
		}
		var box = button.closest( '.bordello-related' );
		var track = box && box.querySelector( '.bordello-related__track' );
		if ( ! track ) {
			return;
		}
		var direction = button.classList.contains( 'bordello-related__arrow--prev' ) ? -1 : 1;
		track.scrollBy( { left: direction * track.clientWidth, behavior: 'smooth' } );
	} );

	document.addEventListener( 'scroll', function ( event ) {
		var el = event.target;
		if ( el && el.classList && el.classList.contains( 'bordello-related__track' ) ) {
			refresh();
		}
	}, true );

	// Hoezen die later laden veranderen de hoogte.
	document.addEventListener( 'load', function ( event ) {
		if ( event.target && event.target.closest && event.target.closest( '.bordello-related' ) ) {
			refresh();
		}
	}, true );

	window.addEventListener( 'resize', refresh );
	window.addEventListener( 'load', refresh );

	// Ajaxify zet een nieuwe pagina in het scherm zonder te verversen: dan verschijnt de carrousel opeens.
	if ( window.MutationObserver ) {
		new MutationObserver( function ( mutations ) {
			for ( var i = 0; i < mutations.length; i++ ) {
				if ( mutations[ i ].addedNodes.length ) {
					refresh();
					return;
				}
			}
		} ).observe( document.body, { childList: true, subtree: true } );
	}

	refresh();
} )();
</script>
				<script id="bordello-ajaxify-fallback">
		( function () {
			'use strict';

			if ( window.bordelloAjaxifyFallback || ! window.jQuery ) {
				return;
			}
			window.bordelloAjaxifyFallback = true;

			function clean( url ) {
				var a = document.createElement( 'a' );
				a.href = url;
				return a.href.split( '#' )[ 0 ];
			}

			window.jQuery( document ).ajaxError( function ( event, xhr, settings ) {
				var History = window.History;
				var state = History && History.getState ? History.getState() : null;
				if ( ! state || ! state.url || ! settings || ( settings.type && 'GET' !== String( settings.type ).toUpperCase() ) ) {
					return;
				}
				// Alleen het ophalen van de pagina zelf, niet andere verzoeken (winkelwagen, wachtlijst, ...).
				if ( clean( settings.url ) !== clean( state.url ) ) {
					return;
				}
				window.location.href = state.url;
			} );
		} )();
		</script>
		<style id="bordello-kaart-wachtlijst-css">
.bordello-cwl{background:#fff;border:1px solid #e0e0e0;box-shadow:0 8px 28px rgba(0,0,0,.18);box-sizing:border-box;color:#23282d;font-family:"Open Sans",sans-serif;font-size:12.5px;line-height:1.45;max-width:calc(100vw - 16px);padding:14px 14px 12px;position:fixed;text-align:left;width:280px;z-index:100001}
.bordello-cwl *{box-sizing:border-box}
.bordello-cwl-close{background:none;border:0;color:#767676;cursor:pointer;font-size:18px;height:26px;line-height:26px;margin:0;padding:0;position:absolute;right:4px;top:4px;width:26px}
.bordello-cwl-text{margin:0 22px 10px 0;padding:0}
.bordello-cwl-form[hidden]{display:none}
.bordello-cwl-email{background:#fff;border:1px solid #cfcfcf;border-radius:0;box-shadow:none;color:#23282d;display:block;font:inherit;height:32px;margin:0 0 8px;padding:0 9px;width:100%}
.bordello-cwl-optin{align-items:flex-start;color:#555;cursor:pointer;display:flex;font-size:11.5px;gap:6px;line-height:1.4;margin:0 0 8px}
.bordello-cwl-optin input{flex:none;margin:2px 0 0}
.bordello-cwl-button{align-items:center;background:#23282d;border:1px solid #23282d;border-radius:999px;color:#fff!important;cursor:pointer;display:inline-flex;font-family:"Montserrat",sans-serif;font-size:12px;font-weight:700;height:32px;justify-content:center;line-height:1;margin:0;padding:0 16px;text-decoration:none!important}
.bordello-cwl-button[disabled]{cursor:default;opacity:.6}
.bordello-cwl-msg{color:#767676;font-size:11.5px;margin:8px 0 0;padding:0}
.bordello-cwl-msg:empty{display:none}
ul.products li.product .prod-thumb .bordello-waitlist-cta.is-joined{gap:7px}
ul.products li.product .prod-thumb .bordello-waitlist-cta.is-joined svg{flex:none;stroke:#000!important}
ul.products li.product .prod-thumb .bordello-waitlist-cta.is-loading{opacity:.6!important;pointer-events:none}
</style>
<script id="bordello-kaart-hover-js">
( function () {
	if ( window.bordelloKaartHover ) {
		return;
	}
	window.bordelloKaartHover = true;

	var $ = window.jQuery;
	var endpoint = "\/?wc-ajax=%%endpoint%%";
	var joined = {};
	var popup = null;
	var popupButton = null;

	function productId( li ) {
		var el = li.querySelector( '[data-product_id]' );
		var id = el ? el.getAttribute( 'data-product_id' ) : '';
		if ( ! id ) {
			var m = li.className.match( /\bpost-(\d+)\b/ );
			id = m ? m[ 1 ] : '';
		}
		return id;
	}

	function decorate() {
		Array.prototype.forEach.call( document.querySelectorAll( 'ul.products li.product' ), function ( li ) {
			var thumb = li.querySelector( '.prod-thumb' );
			if ( ! thumb ) {
				return;
			}

			// Uitverkocht of upcoming: "Join waitlist" meldt direct aan (zonder naar de productpagina te gaan).
			if ( li.classList.contains( 'outofstock' ) && ! thumb.querySelector( '.bordello-waitlist-cta' ) ) {
				var link = li.querySelector( 'a.woocommerce-LoopProduct-link, h3 a' );
				if ( link ) {
					var cta = document.createElement( 'a' );
					cta.className = 'bordello-waitlist-cta';
					cta.href = link.href;
					if ( li.classList.contains( 'upcoming' ) ) {
						cta.setAttribute( 'data-upcoming', '1' );
					}
					setCta( cta, !! joined[ productId( li ) ] );
					cta.setAttribute( 'data-product-id', productId( li ) );
					thumb.appendChild( cta );
				}
			}
		} );
	}


	/* ---------- Direct op de wachtlijst vanuit de kaart ---------- */

	function ajaxUrl( action ) {
		return endpoint.replace( '%%endpoint%%', action );
	}

	function escapeHtml( text ) {
		return String( text ).replace( /[&<>"']/g, function ( c ) {
			return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ c ];
		} );
	}

	function pluginText( key, fallback ) {
		return window.wcwl_data && window.wcwl_data[ key ] ? window.wcwl_data[ key ] : fallback;
	}

	// Aangemeld: eerst een vinkje, dan "On waitlist".
	function setCta( el, isJoined ) {
		if ( isJoined ) {
			el.classList.add( 'is-joined' );
			el.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg><span>On waitlist</span>';
		} else {
			el.classList.remove( 'is-joined' );
			el.textContent = el.getAttribute( 'data-upcoming' ) ? 'Join waitlist' : 'Notify me';
		}
	}

	function markJoined( id ) {
		joined[ id ] = true;
		Array.prototype.forEach.call( document.querySelectorAll( '.bordello-waitlist-cta[data-product-id="' + id + '"]' ), function ( b ) {
			setCta( b, true );
			b.setAttribute( 'title', 'You are on the waitlist for this record' );
		} );
	}

	function closePopup() {
		if ( popup && popup.parentNode ) {
			popup.parentNode.removeChild( popup );
		}
		popup = null;
		popupButton = null;
		document.removeEventListener( 'mousedown', outsideClick, true );
		document.removeEventListener( 'touchstart', outsideClick, true );
		document.removeEventListener( 'keydown', escapeKey, true );
		window.removeEventListener( 'resize', closePopup );
		window.removeEventListener( 'scroll', closePopup, true );
	}

	function outsideClick( event ) {
		if ( popup && ! popup.contains( event.target ) && ! ( popupButton && popupButton.contains( event.target ) ) ) {
			closePopup();
		}
	}

	function escapeKey( event ) {
		if ( 'Escape' === event.key ) {
			closePopup();
		}
	}

	// mode: 'login', 'form' (e-mailadres en/of toestemming) of 'message'.
	function showPopup( button, id, s, mode, message ) {
		closePopup();
		popupButton = button;
		popup = document.createElement( 'div' );
		popup.className = 'bordello-cwl';
		popup.setAttribute( 'role', 'dialog' );
		popup.setAttribute( 'aria-label', 'Waitlist' );

		var html = '<button type="button" class="bordello-cwl-close" aria-label="Close">&times;</button>';
		if ( 'login' === mode ) {
			html += '<p class="bordello-cwl-text">Log in or create an account to join the waitlist for this record.</p>' +
				'<a class="bordello-cwl-button" href="' + escapeHtml( s.login_url ) + '">Log in / Register</a>';
		} else if ( 'form' === mode ) {
			html += '<form class="bordello-cwl-form" novalidate>' +
				'<p class="bordello-cwl-text">Get an email as soon as this record is available.</p>' +
				( s.logged_in ? '' : '<input type="email" class="bordello-cwl-email" placeholder="Email address" autocomplete="email" aria-label="Email address">' ) +
				( s.optin ? '<label class="bordello-cwl-optin"><input type="checkbox"><span>' + escapeHtml( s.optin_text ) + '</span></label>' : '' ) +
				'<button type="submit" class="bordello-cwl-button">Join waitlist</button>' +
				'</form>';
		} else {
			html += '<p class="bordello-cwl-text">' + escapeHtml( message ) + '</p>';
		}
		html += '<p class="bordello-cwl-msg" aria-live="polite"></p>';
		popup.innerHTML = html;
		document.body.appendChild( popup );

		// Boven de knop, uitgelijnd met de rechterkant van de knop.
		var r = button.getBoundingClientRect();
		var width = popup.offsetWidth;
		popup.style.left = Math.max( 8, Math.min( r.right - width, window.innerWidth - width - 8 ) ) + 'px';
		popup.style.bottom = Math.max( 8, window.innerHeight - r.top + 8 ) + 'px';

		popup.querySelector( '.bordello-cwl-close' ).addEventListener( 'click', closePopup );
		document.addEventListener( 'mousedown', outsideClick, true );
		document.addEventListener( 'touchstart', outsideClick, true );
		document.addEventListener( 'keydown', escapeKey, true );
		window.addEventListener( 'resize', closePopup );
		window.addEventListener( 'scroll', closePopup, true );

		var form = popup.querySelector( 'form' );
		if ( ! form ) {
			return;
		}
		var emailField = form.querySelector( '.bordello-cwl-email' );
		var box = form.querySelector( '.bordello-cwl-optin input' );
		var submit = form.querySelector( 'button[type="submit"]' );
		var note = popup.querySelector( '.bordello-cwl-msg' );
		if ( emailField ) {
			emailField.focus();
		}
		form.addEventListener( 'submit', function ( event ) {
			event.preventDefault();
			var email = s.logged_in ? s.email : $.trim( emailField.value );
			if ( ! s.logged_in && ! /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test( email ) ) {
				note.textContent = pluginText( 'email_error_message', 'Please enter a valid email address.' );
				return;
			}
			if ( box && ! box.checked ) {
				note.textContent = pluginText( 'optin_error_message', 'Please tick the box to agree.' );
				return;
			}
			submit.disabled = true;
			note.textContent = pluginText( 'loading_message', 'Adding you to the waitlist' ) + '\u2026';
			join( button, id, s, email, function ( ok, text ) {
				submit.disabled = false;
				if ( ok ) {
					form.hidden = true;
					note.textContent = text || 'You have been added to the waitlist for this record.';
					window.setTimeout( closePopup, 2500 );
				} else {
					note.textContent = text || 'Something went wrong, please try again.';
				}
			} );
		} );
	}

	function readMessage( response ) {
		if ( response && response.success && response.data && response.data.html ) {
			var doc = new DOMParser().parseFromString( response.data.html, 'text/html' );
			var p = doc.querySelector( '.wcwl_notice p' );
			return p ? $.trim( p.textContent ) : '';
		}
		return response && typeof response.data === 'string' ? response.data : '';
	}

	function fetchStatus( id ) {
		return $.ajax( { url: ajaxUrl( 'bordello_card_waitlist_status' ), type: 'POST', data: { product_id: id }, dataType: 'json' } );
	}

	// Aanmelden via de wachtlijst-plugin zelf (dezelfde aanroep als de knop op de productpagina).
	function join( button, id, s, email, done ) {
		button.classList.add( 'is-loading' );

		function finish( ok, message ) {
			button.classList.remove( 'is-loading' );
			if ( ok ) {
				markJoined( id );
			}
			if ( done ) {
				done( ok, message );
			} else if ( ! ok ) {
				showPopup( button, id, s, 'message', message || 'Something went wrong, please try again.' );
			}
		}

		$.ajax( {
			url: s.ajax_url,
			type: 'POST',
			dataType: 'json',
			data: { action: 'wcwl_process_user_waitlist_request', nonce: s.nonce, product_id: id, email: email, context: 'join', language: '', archive: 'false' }
		} )
			.done( function ( response ) {
				var message = readMessage( response );
				var accountCreated = !! ( response && response.success && response.data && response.data.redirectUrl !== undefined );
				if ( s.logged_in ) {
					fetchStatus( id )
						.done( function ( s2 ) {
							finish( !! ( s2 && s2.ok && s2.on_waitlist ), message );
						} )
						.fail( function () {
							finish( false, message );
						} );
				} else {
					finish( accountCreated || /added|already/i.test( message ), message );
				}
			} )
			.fail( function () {
				finish( false, '' );
			} );
	}

	document.addEventListener( 'click', function ( event ) {
		var button = event.target && event.target.closest ? event.target.closest( '.bordello-waitlist-cta' ) : null;
		$ = $ || window.jQuery;
		if ( ! button || ! $ || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ) {
			return;
		}
		var id = button.getAttribute( 'data-product-id' );
		if ( ! id || joined[ id ] ) {
			return; // al aangemeld: de knop is dan gewoon een link naar de productpagina
		}
		event.preventDefault();
		event.stopPropagation();
		button.classList.add( 'is-loading' );
		fetchStatus( id )
			.done( function ( s ) {
				button.classList.remove( 'is-loading' );
				if ( ! s || ! s.ok ) {
					window.location.href = button.href; // geen wachtlijst-gegevens: de productpagina
				} else if ( s.on_waitlist ) {
					markJoined( id );
				} else if ( s.must_login ) {
					showPopup( button, id, s, 'login' );
				} else if ( s.logged_in && ! s.optin ) {
					join( button, id, s, s.email );
				} else {
					showPopup( button, id, s, 'form' );
				}
			} )
			.fail( function () {
				button.classList.remove( 'is-loading' );
				window.location.href = button.href;
			} );
	}, true );

	var timer = null;
	function schedule() {
		window.clearTimeout( timer );
		timer = window.setTimeout( decorate, 30 );
	}

	if ( window.MutationObserver ) {
		new MutationObserver( function ( mutations ) {
			for ( var i = 0; i < mutations.length; i++ ) {
				if ( mutations[ i ].addedNodes.length ) {
					schedule();
					return;
				}
			}
		} ).observe( document.body, { childList: true, subtree: true } );
	}
	window.addEventListener( 'load', schedule );
	decorate();
} )();
</script>
				<script>
		( function () {
			'use strict';

			if ( window.bordelloPlayerFix ) {
				return;
			}
			window.bordelloPlayerFix = true;

			var LOADING_CLASS = 'bordello-audio-loading';

			function addCss() {
				if ( document.getElementById( 'bordello-player-fix-css' ) || ! document.head ) {
					return;
				}
				var style = document.createElement( 'style' );
				style.id = 'bordello-player-fix-css';
				style.textContent =
					'@keyframes bordelloAudioPulse{0%,100%{opacity:1}50%{opacity:.35}}' +
					'html.' + LOADING_CLASS + ' .fap-progress-bar{animation:bordelloAudioPulse 1s ease-in-out infinite}' +
					'html.' + LOADING_CLASS + ' .fap-progress-bar,html.' + LOADING_CLASS + ' .fap-buffer-bar{cursor:progress}';
				document.head.appendChild( style );
			}

			function activeHowls() {
				return ( window.Howler && window.Howler._howls ) || [];
			}

			function isActive( howl ) {
				return activeHowls().indexOf( howl ) >= 0;
			}

			// Laat de voortgangsbalk knipperen zolang het nummer laadt of na een sprong buffert.
			function updateLoading() {
				var loading = false;
				var howls = activeHowls();

				for ( var i = 0; i < howls.length; i++ ) {
					var howl = howls[ i ];
					if ( ! howl || howl._webAudio || ! howl._sounds ) {
						continue;
					}
					if ( howl._autoplay && howl._state === 'loading' ) {
						loading = true;
					}
					for ( var j = 0; j < howl._sounds.length; j++ ) {
						var sound = howl._sounds[ j ];
						var node = sound && sound._node;
						if ( node && ! sound._paused && ( node.seeking || node.readyState < 3 ) ) {
							loading = true;
						}
					}
				}

				var root = document.documentElement;
				if ( root.classList.contains( LOADING_CLASS ) !== loading ) {
					root.classList.toggle( LOADING_CLASS, loading );
				}
			}

			// De browser blokkeert afspelen (automatisch afspelen zonder klik): meld dat aan
			// Howler, zodat de speler de playknop toont in plaats van te doen alsof hij speelt.
			function onPlayRejected( howl, sound, error ) {
				if ( ! error || error.name !== 'NotAllowedError' ) {
					return;
				}
				if ( isActive( howl ) && sound && ! sound._paused ) {
					try {
						howl.pause( sound._id );
					} catch ( e ) {}
				}
			}

			function hookHowl( howl ) {
				if ( ! howl || howl._webAudio || ! howl._sounds ) {
					return;
				}
				for ( var i = 0; i < howl._sounds.length; i++ ) {
					hookSound( howl, howl._sounds[ i ] );
				}
			}

			function hookSound( howl, sound ) {
				var node = sound && sound._node;
				if ( ! node || node.bordelloHooked || typeof node.addEventListener !== 'function' ) {
					return;
				}
				node.bordelloHooked = true;

				var nativePlay = node.play;
				node.play = function () {
					var result;
					try {
						result = nativePlay.apply( node, arguments );
					} catch ( error ) {
						onPlayRejected( howl, sound, error );
						return result;
					}
					if ( result && typeof result.then === 'function' ) {
						result.then( null, function ( error ) {
							onPlayRejected( howl, sound, error );
						} );
					}
					return result;
				};

				[ 'loadstart', 'waiting', 'seeking', 'seeked', 'playing', 'play', 'pause', 'canplay', 'canplaythrough', 'timeupdate', 'ended', 'emptied', 'stalled', 'error' ].forEach( function ( type ) {
					node.addEventListener( type, updateLoading, false );
				} );
			}

			function install() {
				var Howl = window.Howl;
				if ( ! Howl || ! Howl.prototype || typeof Howl.prototype.seek !== 'function' ) {
					return false;
				}
				var proto = Howl.prototype;
				if ( proto.bordelloFixed ) {
					return true;
				}
				proto.bordelloFixed = 2;

				var originalSeek = proto.seek;
				var originalEnded = proto._ended;
				var originalEmit = proto._emit;
				var originalLoad = proto.load;
				var originalPlay = proto.play;
				var originalPause = proto.pause;
				var originalUnload = proto.unload;

				function stillLoading( howl ) {
					return howl._state !== 'loaded' && ! howl._webAudio && howl._sounds && howl._sounds.length > 0;
				}

				// 1. De fout uit de video. Bij het wisselen van nummer zette Howler 2.0.0 twee dingen
				//    op het to-do-lijstje van het nieuwe nummer, terwijl dat nog laadt:
				//    a. de vraag "waar zijn we?" van de voortgangsbalk (seek() zonder waarde). Die werd
				//       nooit afgevinkt en hield de rest van het lijstje tegen;
				//    b. een stop(), omdat het oude nummer bij het weghalen 'end' meldde en de speler
				//       dan het huidige nummer stopt.
				//    De eerste klik op de balk vinkte de vraag af, en daarna voerde Howler de stop()
				//    alsnog uit: het nieuwe nummer stopte. Nu komt geen van beide nog op het lijstje.
				proto.seek = function () {
					var self = this;
					var args = arguments;
					var sound, node;

					// 1a. Positie opvragen tijdens het laden: meteen antwoorden.
					if ( self._state !== 'loaded' && self._sounds && ( args.length === 0 || ( args.length === 1 && self._getSoundIds().indexOf( args[ 0 ] ) >= 0 ) ) ) {
						sound = args.length ? self._soundById( args[ 0 ] ) : self._sounds[ 0 ];
						return sound ? ( sound._seek || 0 ) : 0;
					}

					if ( args.length === 0 || self._webAudio || self._state !== 'loaded' || ! self._sounds || ! self._sounds.length ) {
						return originalSeek.apply( self, args );
					}

					var seek, id;
					if ( args.length === 1 ) {
						if ( self._getSoundIds().indexOf( args[ 0 ] ) >= 0 ) {
							return originalSeek.apply( self, args );
						}
						id = self._sounds[ 0 ]._id;
						seek = parseFloat( args[ 0 ] );
					} else {
						seek = parseFloat( args[ 0 ] );
						id = parseInt( args[ 1 ], 10 );
					}

					sound = self._soundById( id );
					node = sound && sound._node;
					var sprite = sound && self._sprite[ sound._sprite ];

					// 3. Springen in een spelend nummer: verplaats het geluid direct. Howler 2.0.0
					//    pauzeert en herstart het geluid bij elke sprong en wacht dan op
					//    'canplaythrough'; bij snel klikken laadde het nummer daardoor opnieuw.
					//    Gepauzeerd of nog aan het starten: gewoon het gedrag van Howler.
					if ( ! node || ! sprite || sound._paused || node.paused || ! ( seek >= 0 ) ) {
						return originalSeek.apply( self, args );
					}

					self._clearTimer( id );
					sound._seek = seek;
					sound._ended = false;
					node.currentTime = seek;

					var timeout = Math.max( 0, ( sprite[ 0 ] + sprite[ 1 ] ) / 1000 - seek ) * 1000 / Math.abs( sound._rate || 1 );
					if ( timeout !== Infinity ) {
						self._endTimers[ id ] = setTimeout( self._ended.bind( self, sound ), timeout );
					}

					self._emit( 'seek', id );
					updateLoading();
					return self;
				};

				// 1b. Een nummer weghalen meldt geen 'end' meer.
				proto.unload = function () {
					var self = this;
					var result;

					self._emit = function ( event ) {
						return event === 'end' ? self : originalEmit.apply( self, arguments );
					};
					try {
						result = originalUnload.apply( self, arguments );
					} finally {
						delete self._emit;
					}

					updateLoading();
					return result;
				};

				// 2. Play of pauze terwijl het volgende nummer nog laadt. Dat nummer start zodra het
				//    geladen is. Een extra play() startte het nummer dubbel, een pause() werd genegeerd.
				proto.play = function ( sprite ) {
					var self = this;

					if ( typeof sprite === 'undefined' && self._autoplay && stillLoading( self ) ) {
						return self._sounds[ 0 ]._id;
					}

					var result = originalPlay.apply( self, arguments );
					hookHowl( self );
					updateLoading();
					return result;
				};

				proto.pause = function ( id ) {
					var self = this;

					if ( arguments.length < 2 && self._autoplay && stillLoading( self ) ) {
						self._autoplay = false;
						originalEmit.call( self, 'pause', typeof id === 'number' ? id : self._sounds[ 0 ]._id );
						updateLoading();
						return self;
					}

					return originalPause.apply( self, arguments );
				};

				// 4. Einde van een nummer: Howler 2.0.0 gebruikt een timer. Na bufferen loopt die
				//    timer voor op het geluid, waardoor de speler te vroeg naar het volgende nummer
				//    ging. Kijk eerst naar de echte positie, en negeer timers van een nummer dat al
				//    is gewisseld.
				proto._ended = function ( sound ) {
					var self = this;

					if ( self._state === 'unloaded' ) {
						return self;
					}

					var node = sound && sound._node;
					if ( ! self._webAudio && node && ! sound._paused && ! node.paused && ! node.ended && isFinite( node.duration ) ) {
						var sprite = self._sprite[ sound._sprite ];
						var stop = sprite ? Math.min( ( sprite[ 0 ] + sprite[ 1 ] ) / 1000, node.duration ) : node.duration;
						var left = stop - node.currentTime;

						if ( left > 0.25 ) {
							self._clearTimer( sound._id );
							self._endTimers[ sound._id ] = setTimeout( self._ended.bind( self, sound ), Math.max( 100, left * 1000 / Math.abs( sound._rate || 1 ) ) );
							return self;
						}
					}

					return originalEnded.apply( self, arguments );
				};

				proto.load = function () {
					var result = originalLoad.apply( this, arguments );
					hookHowl( this );
					updateLoading();
					return result;
				};

				// Spelers die al bestaan.
				activeHowls().forEach( hookHowl );
				updateLoading();
				return true;
			}

			addCss();
			if ( ! install() ) {
				var tries = 0;
				var timer = setInterval( function () {
					addCss();
					if ( install() || ++tries > 100 ) {
						clearInterval( timer );
					}
				}, 100 );
			}
		} )();
		</script>
				<script id="bordello-leesmeer">
		( function () {
			'use strict';

			if ( window.bordelloReadMore ) {
				return;
			}
			window.bordelloReadMore = true;

			var SLACK = 45; // maar één of twee regels meer: dan niet inklappen

			function setup( box ) {
				if ( box.getAttribute( 'data-rm' ) ) {
					return;
				}
				box.setAttribute( 'data-rm', '1' );

				if ( box.scrollHeight <= box.clientHeight + SLACK ) {
					box.classList.add( 'rm-open' ); // korte tekst: gewoon helemaal tonen
					return;
				}

				box.classList.add( 'rm-collapsible' );
				var button = document.createElement( 'button' );
				button.type = 'button';
				button.className = 'bordello-rm-toggle';
				button.setAttribute( 'aria-expanded', 'false' );
				button.setAttribute( 'aria-controls', box.id || '' );
				button.innerHTML = '<span>Read more</span><i class="fa fa-angle-down" aria-hidden="true"></i>';
				button.addEventListener( 'click', function () {
					var open = box.classList.toggle( 'rm-open' );
					button.setAttribute( 'aria-expanded', open ? 'true' : 'false' );
					button.firstChild.textContent = open ? 'Read less' : 'Read more';
					if ( ! open ) {
						// Na inklappen: terug naar het begin van de tekst als die boven beeld zit.
						var top = box.getBoundingClientRect().top;
						if ( top < 0 ) {
							window.scrollBy( 0, top - 120 );
						}
					}
				} );
				box.parentNode.insertBefore( button, box.nextSibling );
			}

			function scan() {
				var boxes = document.querySelectorAll( '.short-description > #summary' );
				for ( var i = 0; i < boxes.length; i++ ) {
					setup( boxes[ i ] );
				}
			}

			scan();
			document.addEventListener( 'DOMContentLoaded', scan );

			// Ajaxify vervangt de inhoud van de pagina: nieuwe productteksten meteen inklappen.
			if ( window.MutationObserver ) {
				new MutationObserver( scan ).observe( document.getElementById( 'big-wrapper' ) || document.body, { childList: true, subtree: true } );
			}
		} )();
		</script>
				<style id="bordello-speler-kopen-css">
		/* Rij onder de titel met de knop */
		.fap-wrapper .fap-meta .bordello-buy-row {
			display: flex;
			align-items: center;
			align-self: flex-start;
			gap: 10px;
			max-width: 100%;
			margin: 4px 0 0;
		}
		.fap-wrapper .fap-meta .bordello-buy-row[hidden] {
			display: none;
		}
		/* Witte pil zoals de hover-knop in de catalogus: prijs vetgedrukt in zwart, rechts een zwart rondje met wit icoon */
		.fap-wrapper .fap-meta .bordello-buy {
			display: inline-flex;
			flex: none;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
			max-width: 100%;
			height: 28px;
			margin: 0;
			padding: 0 3px 0 12px;
			border: 0;
			border-radius: 999px;
			background: #fff;
			box-shadow: 0 0 0 1px rgba(0, 0, 0, .12), 0 2px 8px rgba(0, 0, 0, .12);
			color: #000;
			font-family: "Open Sans", sans-serif;
			font-size: 12.5px;
			font-weight: 700;
			line-height: 1;
			text-decoration: none;
			white-space: nowrap;
			cursor: pointer;
			transition: background-color .15s ease, box-shadow .15s ease, opacity .15s ease;
		}
		.fap-wrapper .fap-meta .bordello-buy > span,
		.fap-wrapper .fap-meta .bordello-buy > i {
			line-height: 1;
		}
		/* Zwart rondje met wit icoon (winkelwagen, bel, vinkje of pijltje) */
		.fap-wrapper .fap-meta .bordello-buy .bordello-buy-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex: none;
			width: 22px;
			height: 22px;
			border-radius: 50%;
			background: #000;
			color: #fff;
			font-size: 13px;
			line-height: 1;
		}
		.fap-wrapper .fap-meta .bordello-buy .fa.bordello-buy-icon {
			font-size: 11px;
		}
		.fap-wrapper .fap-meta .bordello-buy:focus-visible {
			background: #f2f2f2;
			color: #000;
		}
		@media (hover: hover) {
			.fap-wrapper .fap-meta .bordello-buy:hover {
				background: #f2f2f2;
				color: #000;
			}
		}
		.fap-wrapper .fap-meta .bordello-buy.is-loading {
			opacity: .6;
			pointer-events: none;
		}
		/* Hoes vierkant, van boven tot onder in de speler en tegen de linkerkant, zonder rand eromheen */
		html .fap-wrapper > .fap-main {
			max-width: none;
		}
		html .fap-wrapper .fap-main > .fap-toolbar {
			height: 76px;
		}
		html .fap-wrapper .fap-toolbar > .fap-track-info {
			position: static;
			padding-left: 68px !important; /* 76px hoes + 16px ruimte - 24px rand van de speler */
		}
		html .fap-wrapper .fap-track-info > .fap-cover-wrapper {
			position: absolute;
			top: 0;
			left: -24px;
			width: 76px !important;
			height: 76px;
			margin: 0;
			border: 0 !important;
			border-radius: 0 !important;
			box-shadow: none;
		}
		/* Geen tijden in de speler; rechts van de voortgangsbalk staat welke track van de release speelt (2/4) */
		html .fap-wrapper .fap-timebar > .fap-current-time,
		html .fap-wrapper .fap-timebar > .fap-total-time {
			display: none !important;
		}
		html .fap-wrapper .fap-controls > .fap-timebar {
			padding: 0 44px;
		}
		html .fap-wrapper .fap-timebar > .bordello-track-pos {
			position: absolute;
			top: 50%;
			right: 0;
			color: #767676;
			font-family: "Open Sans", sans-serif;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: .04em;
			line-height: 1;
			white-space: nowrap;
			pointer-events: none;
			transform: translateY(-50%);
		}
		html .fap-wrapper .fap-timebar > .bordello-track-pos:empty {
			display: none;
		}
		@media (max-width: 767px) {
			.fap-wrapper .fap-meta .bordello-buy-row {
				gap: 8px;
				margin-top: 3px;
			}
			.fap-wrapper .fap-meta .bordello-buy {
				gap: 8px;
				height: 26px;
				padding: 0 2px 0 10px;
				font-size: 12px;
			}
			.fap-wrapper .fap-meta .bordello-buy .bordello-buy-icon {
				width: 22px;
				height: 22px;
				font-size: 12.5px;
			}
			.fap-wrapper .fap-meta .bordello-buy .fa.bordello-buy-icon {
				font-size: 10.5px;
			}
			html .fap-wrapper .fap-controls > .fap-timebar {
				padding: 0 34px 0 0;
			}
			html .fap-wrapper .fap-timebar > .bordello-track-pos {
				font-size: 10.5px;
			}
			/* Mobiel: hoes over de volle hoogte links, titel, knoppen en balk ernaast */
			html .fap-wrapper .fap-main > .fap-toolbar {
				height: 74px;
				padding-left: 72px; /* 74px hoes + 10px ruimte - 12px rand van de speler */
			}
			html .fap-wrapper .fap-toolbar > .fap-track-info {
				padding-left: 0 !important;
			}
			html .fap-wrapper .fap-track-info > .fap-cover-wrapper {
				left: -12px; /* tegen de linkerkant van de speler */
				width: 74px !important;
				height: 74px;
			}
		}
		/* Venstertje boven de knop: inloggen of e-mailadres voor de wachtlijst */
		.bordello-wl {
			position: fixed;
			z-index: 100001;
			box-sizing: border-box;
			width: 280px;
			max-width: calc(100vw - 16px);
			padding: 14px 14px 12px;
			border: 1px solid #e0e0e0;
			background: #fff;
			box-shadow: 0 8px 28px rgba(0, 0, 0, .14);
			color: #23282d;
			font-family: "Open Sans", sans-serif;
			font-size: 12.5px;
			font-weight: 400;
			line-height: 1.45;
			text-align: left;
		}
		.bordello-wl * {
			box-sizing: border-box;
		}
		.bordello-wl-close {
			position: absolute;
			top: 4px;
			right: 4px;
			width: 26px;
			height: 26px;
			margin: 0;
			padding: 0;
			border: 0;
			background: none;
			color: #767676;
			font-size: 18px;
			line-height: 26px;
			cursor: pointer;
		}
		.bordello-wl-close:hover {
			color: #000;
		}
		.bordello-wl-text {
			margin: 0 22px 10px 0;
			padding: 0;
		}
		.bordello-wl-form {
			margin: 0;
			padding: 0;
		}
		.bordello-wl-form[hidden] {
			display: none;
		}
		.bordello-wl-email {
			display: block;
			width: 100%;
			height: 32px;
			margin: 0 0 8px;
			padding: 0 9px;
			border: 1px solid #cfcfcf;
			border-radius: 0;
			background: #fff;
			color: #23282d;
			font: inherit;
			box-shadow: none;
		}
		.bordello-wl-email:focus {
			border-color: #23282d;
			outline: none;
		}
		.bordello-wl-optin {
			display: flex;
			align-items: flex-start;
			gap: 6px;
			margin: 0 0 8px;
			color: #555;
			font-size: 11.5px;
			line-height: 1.4;
			cursor: pointer;
		}
		.bordello-wl-optin input {
			flex: none;
			margin: 2px 0 0;
		}
		.bordello-wl-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			height: 30px;
			margin: 0;
			padding: 0 12px;
			border: 1px solid #23282d;
			border-radius: 0;
			background: #23282d;
			color: #fff !important;
			font-family: "Open Sans", sans-serif;
			font-size: 12px;
			font-weight: 600;
			line-height: 1;
			text-decoration: none !important;
			cursor: pointer;
		}
		.bordello-wl-button:hover {
			border-color: #000;
			background: #000;
		}
		.bordello-wl-button[disabled] {
			opacity: .6;
			cursor: default;
		}
		.bordello-wl-msg {
			margin: 8px 0 0;
			padding: 0;
			color: #767676;
			font-size: 11.5px;
		}
		.bordello-wl-msg:empty {
			display: none;
		}
		</style>
		<script>
		( function () {
			'use strict';

			if ( window.bordelloPlayerBuy || ! window.jQuery ) {
				return;
			}
			window.bordelloPlayerBuy = true;

			var $ = window.jQuery;
			var endpoint = "\/?wc-ajax=%%endpoint%%";
			var cartIcon = '<i class="icon-cart-outline bordello-buy-icon" aria-hidden="true"></i>';
			var bellIcon = '<span class="fa fa-bell-o bordello-buy-icon" aria-hidden="true"></span>';
			var checkIcon = '<span class="fa fa-check bordello-buy-icon" aria-hidden="true"></span>';
			var cache = {};
			var statusCache = {};
			var joined = {}; // product-ID: true = staat op de wachtlijst (bekend tijdens dit bezoek)
			var currentPath = null;
			var currentInfo = null;
			var currentTrackUrl = '';
			var row = null;
			var button = null;
			var popup = null;

			function ajaxUrl( action ) {
				return endpoint.replace( '%%endpoint%%', action );
			}

			function host( name ) {
				return String( name ).replace( /^www\./, '' );
			}

			function escapeHtml( text ) {
				return String( text ).replace( /[&<>"']/g, function ( c ) {
					return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ c ];
				} );
			}

			function isLoggedIn() {
				return document.body.classList.contains( 'logged-in' ) || !! ( window.wcwl_data && parseInt( window.wcwl_data.user_id, 10 ) > 0 );
			}

			// Teksten van de wachtlijst-plugin gebruiken als die er zijn.
			function pluginText( key, fallback ) {
				return window.wcwl_data && window.wcwl_data[ key ] ? window.wcwl_data[ key ] : fallback;
			}

			// Pad van de productlink in de speler, bijvoorbeeld /shop/vinyl/argento-miraggi/.
			function productPath() {
				var link = document.querySelector( '.fap-wrapper .fap-meta a.product-link' );
				var href = link ? link.getAttribute( 'href' ) || '' : '';
				if ( ! href || href.charAt( 0 ) === '#' || /^javascript:/i.test( href ) || host( link.hostname ) !== host( location.hostname ) ) {
					return '';
				}
				return link.pathname;
			}

			// De knop komt direct onder de titel in de speler.
			function getButton() {
				var meta = document.querySelector( '.fap-wrapper .fap-meta' );
				if ( ! meta ) {
					return null;
				}
				if ( ! row || ! meta.contains( row ) ) {
					row = document.createElement( 'div' );
					row.className = 'bordello-buy-row';
					row.hidden = true;
					button = document.createElement( 'a' );
					button.className = 'bordello-buy';
					button.addEventListener( 'click', onClick );
					row.appendChild( button );
					var title = meta.querySelector( 'a.product-link' );
					meta.insertBefore( row, title ? title.nextSibling : null );
				}
				return button;
			}

			// Het tracknummer (2/4) staat rechts van de voortgangsbalk, waar de tijd stond.
			function getPositionLabel() {
				var bar = document.querySelector( '.fap-wrapper .fap-timebar' );
				if ( ! bar ) {
					return null;
				}
				var label = bar.querySelector( '.bordello-track-pos' );
				if ( ! label ) {
					label = document.createElement( 'span' );
					label.className = 'bordello-track-pos';
					bar.appendChild( label );
				}
				return label;
			}

			// isLink: gewone link naar de productpagina; Ajaxify opent die zonder te herladen, zodat de muziek doorspeelt.
			function setButton( html, isLink, href, label ) {
				var btn = getButton();
				if ( ! btn ) {
					return;
				}
				btn.innerHTML = html;
				btn.className = 'bordello-buy' + ( isLink ? ' is-link ajaxme' : '' );
				btn.setAttribute( 'href', href || '#' );
				btn.setAttribute( 'title', label );
				btn.setAttribute( 'aria-label', label );
				row.hidden = false;
			}

			function hideButton() {
				if ( getButton() ) {
					row.hidden = true;
				}
			}

			function isWaitlist( info ) {
				return !! ( info && info.found && ! info.buyable && ( ! info.in_stock || info.upcoming ) );
			}

			function render( info ) {
				currentInfo = info;
				if ( ! info || ! info.found ) {
					hideButton();
					return;
				}
				var price = '<span class="bordello-buy-price">' + escapeHtml( info.price ) + '</span>';
				if ( info.buyable ) {
					setButton( price + cartIcon, false, info.url, 'Add to cart: ' + info.price );
				} else if ( isWaitlist( info ) ) {
					// Uitverkocht of binnenkort: direct op de wachtlijst.
					if ( joined[ info.id ] === true ) {
						setButton( '<span>On waitlist</span>' + checkIcon, true, info.url, 'You are on the waitlist for this record' );
					} else {
						setButton( '<span>Waitlist</span>' + bellIcon, true, info.url, info.upcoming ? 'Coming soon: join the waitlist' : 'Sold out: join the waitlist' );
						checkJoined( info );
					}
				} else {
					setButton( price + '<span class="fa fa-angle-right bordello-buy-icon" aria-hidden="true"></span>', true, info.url, 'View' );
				}
				updatePosition();
			}

			var fails = {};

			function lookup( path ) {
				if ( ! cache[ path ] ) {
					cache[ path ] = $.ajax( { url: ajaxUrl( 'bordello_track_product' ), data: { url: path }, dataType: 'json' } );
					cache[ path ].fail( function () {
						delete cache[ path ];
						// Mislukt (traag of even geen verbinding): de controle per seconde probeert het opnieuw, maximaal 3 keer.
						fails[ path ] = ( fails[ path ] || 0 ) + 1;
						if ( fails[ path ] < 3 && path === currentPath ) {
							currentPath = null;
						}
					} );
				}
				return cache[ path ];
			}

			// Productgegevens alvast ophalen, zodat de knop er direct is als de speler het nummer toont.
			function prefetch( url ) {
				try {
					var target = new URL( url, location.href );
					if ( host( target.hostname ) === host( location.hostname ) && ( fails[ target.pathname ] || 0 ) < 3 ) {
						lookup( target.pathname );
					}
				} catch ( e ) {}
			}

			function update() {
				var path = productPath();
				if ( path === currentPath ) {
					// Zelfde plaat: zet de knop terug als de speler zijn titelblok opnieuw heeft opgebouwd.
					var meta = document.querySelector( '.fap-wrapper .fap-meta' );
					if ( currentInfo && meta && ( ! row || ! meta.contains( row ) ) ) {
						render( currentInfo );
					}
					return;
				}
				currentPath = path;
				currentInfo = null;
				closePopup();
				hideButton();
				updatePosition();
				if ( ! path ) {
					return;
				}
				lookup( path ).done( function ( info ) {
					if ( path === currentPath ) {
						render( info );
					}
				} );
			}

			/* ---------- Welke track van de release speelt (2/4) ---------- */

			function trackKey( url ) {
				var a = document.createElement( 'a' );
				a.href = url;
				try {
					return decodeURIComponent( a.pathname );
				} catch ( e ) {
					return a.pathname;
				}
			}

			function playingUrl() {
				if ( currentTrackUrl ) {
					return currentTrackUrl;
				}
				var howls = window.Howler && window.Howler._howls;
				var src = howls && howls.length ? howls[ howls.length - 1 ]._src : '';
				return ( Array.isArray( src ) ? src[ 0 ] : src ) || '';
			}

			function updatePosition() {
				var label = getPositionLabel();
				if ( ! label ) {
					return;
				}
				var text = '';
				var info = currentInfo;
				var playing = playingUrl();
				if ( playing && info && info.found && info.tracks && info.tracks.length > 1 ) {
					var key = trackKey( playing );
					for ( var i = 0; i < info.tracks.length; i++ ) {
						if ( trackKey( info.tracks[ i ] ) === key ) {
							text = ( i + 1 ) + '/' + info.tracks.length;
							break;
						}
					}
				}
				label.textContent = text;
				label.setAttribute( 'title', text ? 'Track ' + text.replace( '/', ' of ' ) : '' );
			}

			// De speler meldt elk gekozen nummer.
			$( document ).on( 'onFapTrackSelect', '#fap', function ( event, track ) {
				currentTrackUrl = track && track.stream_url ? String( track.stream_url ) : '';
				updatePosition();
			} );

			/* ---------- Klik op een track: de hele release in de playlist ---------- */

			// De playlist van de speler (dezelfde lijst als de speler zelf gebruikt).
			var fapTracks = [];
			$( document ).on( 'onFapTracksAdded', '#fap', function ( event, tracks ) {
				fapTracks = Array.isArray( tracks ) ? tracks : [];
			} );
			$( document ).on( 'onFapClear', '#fap', function () {
				fapTracks = [];
			} );

			function sameTrack( a, b ) {
				return a === b || trackKey( a ) === trackKey( b );
			}

			// Productpagina van de release: de link van de track, anders de pagina waar je bent.
			function releasePermalink( link ) {
				var target = link.getAttribute( 'target' ) || '';
				if ( /^(https?:)?\//.test( target ) ) {
					return target;
				}
				return location.origin + location.pathname;
			}

			function playRelease( links, clicked ) {
				var api = $.fullwidthAudioPlayer;
				var hrefs = links.map( function ( a ) {
					return a.getAttribute( 'href' );
				} );
				var inRelease = function ( url ) {
					for ( var i = 0; i < hrefs.length; i++ ) {
						if ( sameTrack( url, hrefs[ i ] ) ) {
							return true;
						}
					}
					return false;
				};

				// Tracks van deze release die al in de playlist staan eerst weghalen, zodat de hele
				// release bij elkaar en op volgorde komt. Via de eigen verwijderknop van de speler.
				var items = document.querySelectorAll( '.fap-wrapper .fap-list > .fap-item' );
				var removals = [];
				if ( fapTracks.length && items.length === fapTracks.length ) {
					for ( var i = fapTracks.length - 1; i >= 0; i-- ) {
						var remove = items[ i ].querySelector( '.fap-remove' );
						if ( remove && fapTracks[ i ] && inRelease( fapTracks[ i ].stream_url ) ) {
							removals.push( remove );
						}
					}
				}
				if ( removals.length ) {
					try {
						api.pause(); // anders begint de speler even aan een ander nummer
					} catch ( e ) {}
					removals.forEach( function ( remove ) {
						remove.click();
					} );
				}

				// Alle tracks van de release achter elkaar toevoegen, daarna de aangeklikte afspelen.
				links.forEach( function ( a ) {
					api.addTrack( a.getAttribute( 'href' ), a.getAttribute( 'title' ) || $.trim( a.textContent ), '', a.getAttribute( 'rel' ) || '', releasePermalink( a ), false );
				} );
				api.addTrack( clicked.getAttribute( 'href' ), clicked.getAttribute( 'title' ) || $.trim( clicked.textContent ), '', clicked.getAttribute( 'rel' ) || '', releasePermalink( clicked ), true );
			}

			// Vóór de speler zelf reageren (capture), zodat niet alleen dat ene nummer wordt toegevoegd.
			document.addEventListener( 'click', function ( event ) {
				var link = event.target && event.target.closest ? event.target.closest( 'ul[data-playlist] .fap-single-track' ) : null;
				if ( ! link || ! $.fullwidthAudioPlayer || ! $.fullwidthAudioPlayer.addTrack || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ) {
					return;
				}
				var links = [].slice.call( link.closest( 'ul[data-playlist]' ).querySelectorAll( '.fap-single-track' ) ).filter( function ( a ) {
					return !! a.getAttribute( 'href' );
				} );
				if ( ! links.length ) {
					return;
				}
				event.preventDefault();
				event.stopPropagation();
				prefetch( releasePermalink( link ) );
				try {
					playRelease( links, link );
				} catch ( error ) {
					if ( window.console && console.error ) {
						console.error( error );
					}
				}
			}, true );

			/* ---------- In de winkelwagen ---------- */

			// Aantal in het winkelwagentje bovenin bijwerken.
			function updateCount( fragments ) {
				var count = null;
				var html = fragments && fragments[ 'div.widget_shopping_cart_content' ];
				if ( html ) {
					var items = $( '<div>' ).html( html ).find( '.woocommerce-mini-cart-item .quantity' );
					if ( items.length ) {
						count = 0;
						items.each( function () {
							count += parseInt( $( this ).text(), 10 ) || 0;
						} );
					}
				}
				$( '.show-cartss' ).each( function () {
					var now = parseInt( $( this ).text(), 10 ) || 0;
					$( this ).text( count !== null ? count : now + 1 );
				} );
			}

			function addToCart( info ) {
				var btn = getButton();
				btn.classList.add( 'is-loading' );

				$.post( ajaxUrl( 'add_to_cart' ), { product_id: info.id, quantity: 1 } )
					.done( function ( response ) {
						if ( ! response || response.error ) {
							// Bijvoorbeeld net uitverkocht: toon de productpagina met de melding.
							window.location.href = ( response && response.product_url ) || info.url;
							return;
						}
						$( document.body ).trigger( 'added_to_cart', [ response.fragments, response.cart_hash ] );
						updateCount( response.fragments );
						$( '#added-alert' ).stop( true, true ).fadeIn( 'slow' ).delay( 1500 ).fadeOut( 'slow' );
						setButton( '<span>Added</span>' + checkIcon, false, info.url, 'Added to cart' );
						setTimeout( function () {
							if ( currentInfo === info ) {
								render( info );
							}
						}, 2500 );
					} )
					.fail( function () {
						window.location.href = info.url;
					} )
					.always( function () {
						btn.classList.remove( 'is-loading' );
					} );
			}

			/* ---------- Op de wachtlijst ---------- */

			function status( info, fresh ) {
				if ( fresh || ! statusCache[ info.id ] ) {
					statusCache[ info.id ] = $.ajax( { url: ajaxUrl( 'bordello_waitlist_status' ), type: 'POST', data: { product_id: info.id }, dataType: 'json' } );
					statusCache[ info.id ].fail( function () {
						delete statusCache[ info.id ];
					} );
				}
				return statusCache[ info.id ];
			}

			// Ingelogd: laat meteen zien als je al op de wachtlijst staat.
			function checkJoined( info ) {
				if ( ! isLoggedIn() || ! info.simple || joined[ info.id ] !== undefined ) {
					return;
				}
				joined[ info.id ] = false;
				status( info ).done( function ( s ) {
					if ( s && s.ok && s.on_waitlist ) {
						joined[ info.id ] = true;
						if ( currentInfo === info ) {
							render( info );
						}
					}
				} );
			}

			function readMessage( response ) {
				if ( response && response.success && response.data && response.data.html ) {
					var doc = new DOMParser().parseFromString( response.data.html, 'text/html' );
					var p = doc.querySelector( '.wcwl_notice p' );
					return p ? $.trim( p.textContent ) : '';
				}
				return response && typeof response.data === 'string' ? response.data : '';
			}

			// Aanmelden via de wachtlijst-plugin zelf (dezelfde aanroep als de knop op de productpagina).
			function join( info, s, email, done ) {
				var btn = getButton();
				btn.classList.add( 'is-loading' );

				function finish( ok, message ) {
					btn.classList.remove( 'is-loading' );
					if ( ok ) {
						joined[ info.id ] = true;
						if ( currentInfo === info ) {
							render( info );
						}
					}
					if ( done ) {
						done( ok, message );
					} else if ( ! ok ) {
						showPopup( info, s, 'message', message || 'Something went wrong, please try again.' );
					}
				}

				$.ajax( {
					url: s.ajax_url,
					type: 'POST',
					dataType: 'json',
					data: {
						action: 'wcwl_process_user_waitlist_request',
						nonce: s.nonce,
						product_id: info.id,
						email: email,
						context: 'join',
						language: '',
						archive: 'false'
					}
				} )
					.done( function ( response ) {
						var message = readMessage( response );
						var accountCreated = !! ( response && response.success && response.data && response.data.redirectUrl !== undefined );
						if ( s.logged_in ) {
							// Ingelogd: vraag na of het gelukt is.
							status( info, true )
								.done( function ( s2 ) {
									finish( !! ( s2 && s2.ok && s2.on_waitlist ), message );
								} )
								.fail( function () {
									finish( false, message );
								} );
						} else {
							finish( accountCreated || /added|already/i.test( message ), message );
						}
					} )
					.fail( function () {
						finish( false, '' );
					} );
			}

			function waitlist( info ) {
				var btn = getButton();
				btn.classList.add( 'is-loading' );
				status( info, true )
					.done( function ( s ) {
						btn.classList.remove( 'is-loading' );
						if ( currentInfo !== info ) {
							return;
						}
						if ( ! s || ! s.ok ) {
							openPage( info.url );
						} else if ( s.on_waitlist ) {
							joined[ info.id ] = true;
							render( info );
						} else if ( s.must_login ) {
							showPopup( info, s, 'login' );
						} else if ( s.logged_in && ! s.optin ) {
							join( info, s, s.email );
						} else {
							showPopup( info, s, 'form' );
						}
					} )
					.fail( function () {
						btn.classList.remove( 'is-loading' );
						openPage( info.url );
					} );
			}

			// Productpagina openen via Ajaxify, zodat de muziek doorspeelt.
			function openPage( url ) {
				var a = document.createElement( 'a' );
				a.href = url;
				a.style.display = 'none';
				document.body.appendChild( a );
				a.click();
				document.body.removeChild( a );
			}

			function placePopup() {
				if ( ! popup || ! button ) {
					return;
				}
				// Boven de spelerbalk, uitgelijnd met de knop.
				var r = button.getBoundingClientRect();
				var bar = document.querySelector( '.fap-wrapper .fap-toolbar' );
				var top = bar ? Math.min( bar.getBoundingClientRect().top, r.top ) : r.top;
				var width = popup.offsetWidth;
				popup.style.left = Math.max( 8, Math.min( r.left, window.innerWidth - width - 8 ) ) + 'px';
				popup.style.bottom = Math.max( 8, window.innerHeight - top + 8 ) + 'px';
			}

			function outsideClick( event ) {
				if ( popup && ! popup.contains( event.target ) && ! ( button && button.contains( event.target ) ) ) {
					closePopup();
				}
			}

			function escapeKey( event ) {
				if ( 'Escape' === event.key ) {
					closePopup();
				}
			}

			function closePopup() {
				if ( popup && popup.parentNode ) {
					popup.parentNode.removeChild( popup );
				}
				popup = null;
				document.removeEventListener( 'mousedown', outsideClick, true );
				document.removeEventListener( 'touchstart', outsideClick, true );
				document.removeEventListener( 'keydown', escapeKey, true );
				window.removeEventListener( 'resize', placePopup );
			}

			// mode: 'login' (eerst inloggen), 'form' (e-mailadres en/of toestemming) of 'message'.
			function showPopup( info, s, mode, message ) {
				closePopup();
				popup = document.createElement( 'div' );
				popup.className = 'bordello-wl';
				popup.setAttribute( 'role', 'dialog' );
				popup.setAttribute( 'aria-label', 'Waitlist' );

				var html = '<button type="button" class="bordello-wl-close" aria-label="Close">&times;</button>';
				if ( 'login' === mode ) {
					html += '<p class="bordello-wl-text">Log in or create an account to join the waitlist for this record.</p>' +
						'<a class="bordello-wl-button" href="' + escapeHtml( s.login_url ) + '">Log in / Register</a>';
				} else if ( 'form' === mode ) {
					html += '<form class="bordello-wl-form" novalidate>' +
						'<p class="bordello-wl-text">Get an email as soon as this record is available.</p>' +
						( s.logged_in ? '' : '<input type="email" class="bordello-wl-email" placeholder="Email address" autocomplete="email" aria-label="Email address">' ) +
						( s.optin ? '<label class="bordello-wl-optin"><input type="checkbox"><span>' + escapeHtml( s.optin_text ) + '</span></label>' : '' ) +
						'<button type="submit" class="bordello-wl-button">Join waitlist</button>' +
						'</form>';
				} else {
					html += '<p class="bordello-wl-text">' + escapeHtml( message ) + '</p>';
				}
				html += '<p class="bordello-wl-msg" aria-live="polite"></p>';
				popup.innerHTML = html;
				document.body.appendChild( popup );
				placePopup();

				popup.querySelector( '.bordello-wl-close' ).addEventListener( 'click', closePopup );
				document.addEventListener( 'mousedown', outsideClick, true );
				document.addEventListener( 'touchstart', outsideClick, true );
				document.addEventListener( 'keydown', escapeKey, true );
				window.addEventListener( 'resize', placePopup );

				var login = popup.querySelector( 'a.bordello-wl-button' );
				if ( login ) {
					login.addEventListener( 'click', function () {
						setTimeout( closePopup, 0 );
					} );
				}

				var form = popup.querySelector( 'form' );
				if ( ! form ) {
					return;
				}
				var emailField = form.querySelector( '.bordello-wl-email' );
				var box = form.querySelector( '.bordello-wl-optin input' );
				var submit = form.querySelector( 'button[type="submit"]' );
				var note = popup.querySelector( '.bordello-wl-msg' );
				if ( emailField ) {
					emailField.focus();
				}
				form.addEventListener( 'submit', function ( event ) {
					event.preventDefault();
					var email = s.logged_in ? s.email : $.trim( emailField.value );
					if ( ! s.logged_in && ! /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test( email ) ) {
						note.textContent = pluginText( 'email_error_message', 'Please enter a valid email address.' );
						return;
					}
					if ( box && ! box.checked ) {
						note.textContent = pluginText( 'optin_error_message', 'Please tick the box to agree.' );
						return;
					}
					submit.disabled = true;
					note.textContent = pluginText( 'loading_message', 'Adding you to the waitlist' ) + '…';
					join( info, s, email, function ( ok, text ) {
						submit.disabled = false;
						if ( ok ) {
							form.hidden = true;
							note.textContent = text || 'You have been added to the waitlist for this record.';
							setTimeout( closePopup, 2500 );
						} else {
							note.textContent = text || 'Something went wrong, please try again.';
						}
					} );
				} );
			}

			/* ---------- Klikken op de knop ---------- */

			function onClick( event ) {
				var info = currentInfo;
				// Openen in een nieuw tabblad: gewone link naar de productpagina.
				if ( ! info || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ) {
					return;
				}
				if ( info.buyable ) {
					event.preventDefault();
					event.stopPropagation();
					addToCart( info );
				} else if ( isWaitlist( info ) && info.simple && joined[ info.id ] !== true ) {
					event.preventDefault();
					event.stopPropagation();
					waitlist( info );
				}
				// Anders: gewone link naar de productpagina.
			}

			// Nieuw nummer = nieuwe productlink in de speler. De speler wordt in de gaten gehouden;
			// de controle per seconde vangt het op als de speler zijn titelblok vervangt.
			var observer = new MutationObserver( update );
			var observed = null;

			function watch() {
				// Op een productpagina de gegevens van die plaat alvast ophalen.
				if ( document.body.classList.contains( 'single-product' ) ) {
					prefetch( location.href );
				}
				var meta = document.querySelector( '.fap-wrapper .fap-meta' );
				if ( meta && meta !== observed ) {
					observer.disconnect();
					observer.observe( meta, { subtree: true, childList: true, attributes: true, attributeFilter: [ 'href' ] } );
					observed = meta;
				}
				update();
			}

			watch();
			setInterval( watch, 1000 );
		} )();
		</script>
		<script id="bordello-voorraad-js">
( function () {
	if ( window.bordelloStockBar ) { return; }
	window.bordelloStockBar = true;

	function build() {
		var list = document.querySelector( 'div.woocommerce > ul.products' );
		if ( ! list || list.closest( '.related, .upsells, .cross-sells' ) ) { return; }
		var existing = document.querySelector( '.bordello-stockbar' );
		// Niet op de homepage, de zoekresultaten en een enkel product: alleen op de lijsten.
		var path = location.pathname.replace( /\/+$/, '' );
		if ( path === '' || /^\/(product|cart|checkout|my-account)(\/|$)/.test( path ) || new URL( location.href ).searchParams.has( 's' ) ) {
			if ( existing ) { existing.remove(); }
			return;
		}
		var url = new URL( location.href );
		var on = url.searchParams.get( 'instock' ) === '1';
		if ( on ) { url.searchParams.delete( 'instock' ); } else { url.searchParams.set( 'instock', '1' ); }
		url.pathname = url.pathname.replace( /\/page\/\d+\/?$/, '/' );
		url.searchParams.delete( 'paged' );
		if ( existing && existing.nextElementSibling === list ) {
			var a0 = existing.querySelector( 'a' );
			if ( a0 && a0.getAttribute( 'href' ) === url.href ) { return; }
		}
		if ( existing ) { existing.remove(); }
		var bar = document.createElement( 'div' );
		bar.className = 'bordello-stockbar';
		bar.innerHTML = '<a class="bordello-tgl' + ( on ? ' is-on' : '' ) + '" role="switch" aria-checked="' + ( on ? 'true' : 'false' ) + '" href="' + url.href.replace( /&/g, '&amp;' ) + '"><span class="bordello-track"></span><span>Hide out of stock</span></a>';
		list.parentNode.insertBefore( bar, list );
	}

	build();
	document.addEventListener( 'DOMContentLoaded', build );
	window.addEventListener( 'load', build );
	if ( window.MutationObserver ) {
		new MutationObserver( build ).observe( document.body, { childList: true, subtree: true } );
	}
} )();
</script>
				<style id="bordello-wachtlijst-positie">
		.short-description > .bordello-waitlist-actions {
			display: flex; flex-wrap: wrap; align-items: flex-start;
			gap: 10px 12px; margin: 0 0 16px; clear: both;
		}
		.short-description > .bordello-waitlist-actions > .controls,
		.short-description > .bordello-waitlist-actions > .tinv-wraper {
			float: none !important; margin: 0 !important; flex: 0 0 auto;
		}
		.short-description > .bordello-waitlist-actions > .bordello-waitlist-form {
			float: none !important; clear: none !important;
			width: auto !important; max-width: 100%; margin: 0 !important;
			flex: 0 1 auto;
		}
		.bordello-waitlist-actions .wcwl_elements { margin: 0 !important; }
