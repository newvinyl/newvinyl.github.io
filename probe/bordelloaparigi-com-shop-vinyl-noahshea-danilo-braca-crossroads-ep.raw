       <script>
		   jQuery(function(){

				jQuery( "#tabs" ).tabs();
				console.log('reload');
                



               
                var $wcwl_intro =  jQuery('.wcwl_intro p').text();

                if ($wcwl_intro) {
                    jQuery('.single-product .stock.out-of-stock').text($wcwl_intro);
                }

				jQuery(document).on("click",".showsearch", function (e) {
					console.log('search');
					e.stopImmediatePropagation();
					jQuery( "div.search-pop" ).fadeIn(function(){
                        jQuery( "div.search-pop" ).addClass('searchon');
                    });
					return false;
				});
               
               $('#searchsubmit, .search-text .fa-times').on('click', function(e) {                    
                    jQuery( "div.search-pop" ).fadeOut(function(){
						jQuery( "div.search-pop" ).removeClass('searchon');
					});
                   e.stopImmediatePropagation();
                });            
                jQuery('.search-pop, .search-pop .close').on('click keyup', function(e) {
                    if (e.target == this || e.target.className == 'close' || e.keyCode == 27) {
                        jQuery(this).removeClass('searchon');
                        e.stopImmediatePropagation();
                    }
                }); 
			  

               
               
               
               
			});
		   
		   jQuery(function() {
		
	var $el, $ps, $up, totalHeight;
	jQuery(document).on("click",".short-box .more-button", function (e) {
	

		// IE 7 doesn't even get this far. I didn't feel like dicking with it.
		
		totalHeight = 0

		$el = jQuery(this);
		$p  = $el.parent();
		$up = $p.parent();
		$ps = $up.find("p:not('.show-more')");

		// measure how tall inside should be by adding together heights of all inside paragraphs (except read-more paragraph)
		$ps.each(function() {
			totalHeight += jQuery(this).outerHeight();
			// FAIL totalHeight += $(this).css("margin-bottom");
		});

		$up
			.css({
				// Set height to prevent instant jumpdown when max height is removed
				"height": $up.height(),
				"max-height": 9999
			})
			.animate({
				"height": totalHeight+50
			});

		// fade out read-more
		$p.fadeOut();
		
		
		// prevent jump-down
		return false;
		e.stopImmediatePropagation();
	});

});
		   
	   </script>
<script type="text/javascript">
  /* in order to update info on your checkout page you need to trigger update_checkout function
     so add this in your javascript file for your theme or plugin
  */
    jQuery(document).on('change', '.shipping_method', function(){
        jQuery('body').trigger('update_checkout');
       // console.log('after all callbacks')
    });
  
   /* what this does is update the order review table but what it doesn't do is update shipping costs;
     the calculate_shipping function of your shipping class will not be called again;
     so if you were like me and you made a shipping method plugin and you had to change costs based on payment method then
     this is the only way to ensure it does just that
  */
</script>
