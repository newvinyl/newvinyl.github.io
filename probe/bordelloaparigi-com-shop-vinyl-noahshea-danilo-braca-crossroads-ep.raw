	transition: color .15s ease, background-color .15s ease, border-color .15s ease;
}
#footer.bordello-footer a:hover,
#footer.bordello-footer a:focus-visible {
	color: #fff;
}
#footer.bordello-footer ul {
	list-style: none;
	margin: 0;
	padding: 0;
}
#footer.bordello-footer li {
	margin: 0;
}
#footer.bordello-footer .bf-wrap {
	margin: 0 auto;
	max-width: 1440px;
	padding: 0 clamp(24px, 5.5vw, 80px);
	width: 100%;
}

/* Nieuwsbrief */
#footer.bordello-footer .bf-news {
	align-items: center;
	display: flex;
	gap: 40px;
	justify-content: space-between;
	padding: 56px 0 48px;
}
#footer.bordello-footer .bf-news-copy {
	display: flex;
	flex-direction: column;
	gap: 10px;
}
#footer.bordello-footer .bf-label {
	color: #fff;
	font-family: "Montserrat", sans-serif;
	font-size: 12px;
	font-weight: 600;
	letter-spacing: .16em;
	line-height: 1.4;
	text-transform: uppercase;
}
#footer.bordello-footer .bf-news .bf-label {
	color: #8a8a8a;
}
#footer.bordello-footer .bf-news-text {
	color: #fff;
	font-family: "Montserrat", sans-serif;
	font-size: 30px;
	font-weight: 700;
	line-height: 1.2;
}
#footer.bordello-footer a.bf-pill {
	align-items: center;
	border: 1.5px solid #fff;
	border-radius: 999px;
	color: #fff;
	display: inline-flex;
	flex: none;
	font-family: "Montserrat", sans-serif;
	font-size: 14px;
	font-weight: 600;
	gap: 12px;
	height: 52px;
	padding: 0 28px;
	white-space: nowrap;
}
#footer.bordello-footer a.bf-pill svg {
	display: block;
	fill: none;
	stroke: currentColor;
	stroke-linecap: round;
	stroke-linejoin: round;
	stroke-width: 2;
}
#footer.bordello-footer a.bf-pill:hover,
#footer.bordello-footer a.bf-pill:focus-visible {
	background: #fff;
	color: #000;
}
#footer.bordello-footer .bf-rule {
	background: #262626;
	height: 1px;
}

/* Kolommen */
#footer.bordello-footer .bf-cols {
	column-gap: 48px;
	display: grid;
	grid-template-columns: 1.5fr 1fr 1fr 1fr;
	padding: 72px 0 0;
}
#footer.bordello-footer .bf-brand {
	display: flex;
	flex-direction: column;
	gap: 22px;
}
#footer.bordello-footer .bf-brand-copy {
	display: flex;
	flex-direction: column;
	gap: 10px;
}
#footer.bordello-footer .bf-logo {
	display: block;
	height: auto;
	max-width: 112px;
	opacity: .85;
	width: 112px;
}
#footer.bordello-footer .bf-name {
	color: #fff;
	font-family: "Montserrat", sans-serif;
	font-size: 18px;
	font-weight: 700;
	letter-spacing: .04em;
	text-transform: uppercase;
}
#footer.bordello-footer .bf-tagline {
	color: #bdbdbd;
	font-size: 14px;
	line-height: 1.6;
}
#footer.bordello-footer .bf-connect-label {
	display: none; /* alleen op mobiel zichtbaar */
}
#footer.bordello-footer .bf-social {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
}
#footer.bordello-footer a.bf-social-link {
	align-items: center;
	border: 1.5px solid #fff;
	border-radius: 50%;
	color: #fff;
	display: inline-flex;
	height: 40px;
	justify-content: center;
	width: 40px;
}
#footer.bordello-footer a.bf-social-link svg {
	display: block;
	fill: currentColor;
}
#footer.bordello-footer a.bf-social-link:hover,
#footer.bordello-footer a.bf-social-link:focus-visible {
	background: #fff;
	color: #000;
}
#footer.bordello-footer .bf-col {
	display: flex;
	flex-direction: column;
	gap: 18px;
}
#footer.bordello-footer .bf-links {
	display: flex;
	flex-direction: column;
	gap: 12px;
	font-size: 15px;
	line-height: 1.4;
}
#footer.bordello-footer .bf-search {
	align-items: center;
	background: transparent;
	border: 1.5px solid #3a3a3a;
	border-radius: 999px;
	display: flex;
	height: 44px;
	margin: 6px 0 0;
	padding: 0 6px 0 16px;
	position: relative;
}
#footer.bordello-footer .bf-search:focus-within {
	border-color: #fff;
}
#footer.bordello-footer .bf-search input[type="search"] {
	-webkit-appearance: none;
	appearance: none;
	background: transparent;
	border: 0;
	box-shadow: none;
	color: #fff;
	flex: 1 1 auto;
	font-family: "Open Sans", sans-serif;
	font-size: 14px;
	height: 100%;
	margin: 0;
	min-width: 0;
	outline: 0;
	padding: 0;
	width: auto;
}
#footer.bordello-footer .bf-search input[type="search"]::placeholder {
	color: #8a8a8a;
	opacity: 1;
}
#footer.bordello-footer .bf-search button {
	align-items: center;
	background: #fff;
	border: 0;
	border-radius: 50%;
	cursor: pointer;
	display: inline-flex;
	flex: none;
	height: 32px;
	justify-content: center;
	margin: 0;
	padding: 0;
	width: 32px;
}
#footer.bordello-footer .bf-search button svg {
	display: block;
	fill: none;
	stroke: #000;
	stroke-linecap: round;
	stroke-width: 2.2;
}
#footer.bordello-footer .bf-sr {
	clip: rect(0 0 0 0);
	height: 1px;
	overflow: hidden;
	position: absolute;
	width: 1px;
}

/* Onderbalk */
#footer.bordello-footer .bf-bottom {
	align-items: center;
	border-top: 1px solid #262626;
	color: #8a8a8a;
	display: flex;
	font-size: 13px;
	gap: 24px;
	justify-content: space-between;
	margin-top: 56px;
	padding: 26px 0 32px;
}
#footer.bordello-footer .bf-bottom a {
	color: #8a8a8a;
}
#footer.bordello-footer .bf-bottom a:hover {
	color: #fff;
}
#footer.bordello-footer .bf-bottom-links {
	display: flex;
	gap: 22px;
}

/* Tablet en telefoon */
@media (max-width: 991.98px) {
	#footer.bordello-footer .bf-cols {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		row-gap: 36px;
	}
	#footer.bordello-footer .bf-brand {
		border-top: 1px solid #262626;
		grid-column: 1 / -1;
		order: 5;
		padding-top: 32px;
	}
	#footer.bordello-footer .bf-connect-label {
		display: block;
	}
	#footer.bordello-footer .bf-brand-copy {
		display: none; /* de naam staat al in de nieuwsbriefband en de onderbalk */
	}
