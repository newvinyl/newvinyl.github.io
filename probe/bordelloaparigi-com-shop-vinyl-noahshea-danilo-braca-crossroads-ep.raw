        var $box = $('.wcwl_elements');

        if (!$box.length) return;

        $box.removeClass('wcwl_nojs');

        $box.css({
            display: 'block',
            visibility: 'visible',
            opacity: 1
        });

        $box.find('.wcwl_notice.woocommerce-message').hide();

        $box.find('.wcwl_control').css({
            display: 'inline-block',
            visibility: 'visible',
            opacity: 1
        });
    }

    fixWaitlistVisibility();
    setInterval(fixWaitlistVisibility, 300);

})(jQuery);
</script>
