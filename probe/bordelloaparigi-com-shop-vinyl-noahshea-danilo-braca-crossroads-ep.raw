<script id="bordello-recommended-covers">
(function () {
    'use strict';
    if (window.bordelloRecommendedCovers) return;
    window.bordelloRecommendedCovers = true;

    function fillCovers() {
        document.querySelectorAll('aside ul.products li.product').forEach(function (card) {
            var image = card.querySelector('.prod-thumb img');
            if (!image) return;
            var cover = image.getAttribute('data-src') || image.getAttribute('data-lazy-src') || image.currentSrc || image.getAttribute('src');
            if (!cover || !/^https?:/i.test(new URL(cover, document.baseURI).href) || /^data:/i.test(cover)) return;
            card.querySelectorAll('ul[data-playlist] a.fap-single-track').forEach(function (track) {
                // Fullwidth Audio Player leest de hoes uit rel, ook bij Play playlist.
                if (!(track.getAttribute('rel') || '').trim()) {
                    track.setAttribute('rel', cover);
                }
            });
        });
    }

    // Window capture gaat voor de klikhandlers van de speler en de release-plugin.
    window.addEventListener('click', function (event) {
        var link = event.target && event.target.closest ? event.target.closest('aside .fap-add-playlist, aside .fap-single-track') : null;
        if (link) fillCovers();
    }, true);

    function start() {
        fillCovers();
        if (window.MutationObserver) {
            // Ajaxify kan de volledige inhoud vervangen; de body blijft aanwezig.
            new MutationObserver(fillCovers).observe(document.body, {childList: true, subtree: true});
        }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
})();
</script>
