		<style id="bordello-leesmeer-css">
		/* De omschrijving staat in .short-description > #summary (thema: single-product/short-description.php) */
		/* Ingeklapt: 7 regels, de laatste regel eindigt op ... (geen schaduw) */
		html.bordello-rm .short-description > #summary:not(.rm-open) {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 7;
			line-clamp: 7;
			overflow: hidden;
		}
		/* Eigen regel direct onder de tekst, boven de knoppen (die zweven links en rechts) */
		.short-description > .bordello-rm-toggle {
			display: flex;
			clear: both;
			width: -moz-fit-content;
			width: fit-content;
			align-items: center;
			gap: 6px;
			margin: 6px 0 20px;
			padding: 0;
			border: 0;
			background: none;
			color: #23282d;
			font-family: "Open Sans", sans-serif;
			font-size: 13px;
			font-weight: 600;
			letter-spacing: .02em;
			line-height: 1.4;
			cursor: pointer;
		}
		.short-description > .bordello-rm-toggle:hover span {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
		.short-description > .bordello-rm-toggle .fa {
			font-size: 15px;
			transition: transform .2s ease;
		}
		.short-description > .bordello-rm-toggle[aria-expanded="true"] .fa {
			transform: rotate(180deg);
		}
		</style>
