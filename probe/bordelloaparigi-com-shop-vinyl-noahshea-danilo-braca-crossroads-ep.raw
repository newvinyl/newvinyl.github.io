		<script id="bordello-zoektekst">
( function () {
	if ( window.bordelloSearchText ) {
		return;
	}
	window.bordelloSearchText = true;

	var NEW_TEXT = 'Search...';
	var OLD = /^\s*search products(\.\.\.|\u2026)?\s*$/i;

	function fix() {
		Array.prototype.forEach.call( document.querySelectorAll( 'input[placeholder]' ), function ( input ) {
			if ( OLD.test( input.getAttribute( 'placeholder' ) ) ) {
				input.setAttribute( 'placeholder', NEW_TEXT );
			}
		} );
		Array.prototype.forEach.call( document.querySelectorAll( 'label, .screen-reader-text' ), function ( el ) {
			if ( el.children.length === 0 && OLD.test( el.textContent ) ) {
				el.textContent = 'Search';
			}
		} );
	}

	fix();
	document.addEventListener( 'DOMContentLoaded', fix );
	window.addEventListener( 'load', fix );
	if ( window.MutationObserver ) {
		new MutationObserver( fix ).observe( document.body, { childList: true, subtree: true } );
	}
} )();
</script>
		<script id="bordello-product-quantity">
(function(){
'use strict';
if(window.bordelloProductQuantity)return;
window.bordelloProductQuantity=true;
function setup(){
 document.querySelectorAll('.summary.entry-summary .short-description').forEach(function(description){
  var controls=description.querySelector('span.controls');
  var cart=description.querySelector('form.cart:not(.variations_form)');
  if(!controls||!cart||controls.parentNode!==description||cart.parentNode!==description)return;
  var row=document.createElement('div');row.className='bordello-product-actions';
  description.insertBefore(row,controls);row.appendChild(controls);row.appendChild(cart);
  var heart=description.querySelector(':scope > .tinv-wraper.tinv-wishlist');
  if(heart)row.appendChild(heart);
 });
 document.querySelectorAll('.summary.entry-summary form.cart .quantity').forEach(function(box){
  var input=box.querySelector('input.qty[type="number"]');
  if(!input || input.disabled || input.readOnly || box.querySelector('button,.plus,.minus'))return;
  box.classList.add('bordello-product-quantity');
 });
}
function start(){setup();if(window.MutationObserver)new MutationObserver(setup).observe(document.body,{childList:true,subtree:true});}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start);else start();
})();
</script>


