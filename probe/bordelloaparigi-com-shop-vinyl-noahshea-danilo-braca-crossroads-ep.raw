		height: 48px;
	}
	#footer.bordello-footer .bf-cols {
		column-gap: 24px;
		padding-top: 36px;
	}
	#footer.bordello-footer .bf-bottom {
		align-items: flex-start;
		flex-direction: column;
		gap: 8px;
		margin-top: 36px;
		padding-top: 24px;
	}
