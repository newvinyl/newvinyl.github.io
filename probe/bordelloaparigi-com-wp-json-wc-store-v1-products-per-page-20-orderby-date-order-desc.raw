\/wp-content\/uploads\/2026\/10\/li2-21-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li2-21-100x100.jpg 100w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li2-21.jpg 700w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"li2","alt":""}],"categories":[],"tags":[{"id":7631,"name":"store","slug":"store","link":"https:\/\/bordelloaparigi.com\/tags\/store\/"}],"brands":[],"attributes":[{"id":1,"name":"Artist","taxonomy":"pa_artist","has_variations":false,"terms":[{"id":13162,"name":"Omar Featuring Stevie Wonder","slug":"omar-featuring-stevie-wonder"}]},{"id":5,"name":"Format","taxonomy":"pa_format","has_variations":false,"terms":[{"id":7393,"name":"EP","slug":"ep"}]},{"id":2,"name":"Genre","taxonomy":"pa_genre","has_variations":false,"terms":[{"id":30,"name":"House","slug":"house"}]},{"id":3,"name":"Label","taxonomy":"pa_label","has_variations":false,"terms":[{"id":12670,"name":"Peppermint Jam","slug":"peppermint-jam"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":false,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"Set reminder to be emailed when this product becomes available","class":"out-of-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Read more","description":"Read more about &ldquo;Omar Featuring Stevie Wonder  | The Remixes EP&rdquo;","url":"https:\/\/bordelloaparigi.com\/shop\/vinyl\/omar-featuring-stevie-wonder-the-remixes-ep\/","single_text":"Add to cart","minimum":1,"maximum":9999,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products\/329546","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products?related=329546&per_page=10"}]}},{"id":329542,"name":"Sound Klash | You Had it (Edit) \/ Music Got (Dub) 12&#8243;","slug":"sound-klash-you-had-it-edit-music-got-dub-12","parent":0,"type":"simple","variation":"","permalink":"https:\/\/bordelloaparigi.com\/shop\/vinyl\/sound-klash-you-had-it-edit-music-got-dub-12\/","sku":"SPV20261","short_description":"<p>Underground Institution Stompa Phunk Re-Launches Vinyl Label with Raw, Chi-House-Inspired Energy. After three decades of defining the UK\u2019s underground club landscape, legendary Brighton party collective Stompa Phunk is officially moving from the dancefloor to the wax with the relaunch of Stompa Phunk Records Inc.<\/p>\n<p>The Heritage: From The Warehouse: The releases will directly honour the roots of house music, a genre born in 1977 at Chicago\u2019s legendary nightclub, The Warehouse. As that scene matured, a grittier, faster, and more experimental counterpart emerged. Defined by an uninhibited, bass-heavy style, it was a movement driven by local innovators who pushed drum machines and synthesisers to their breaking point&#8230; It wasn&#8217;t just a genre; it was a collision between pure imagination and raw machines. A true &#8220;sound klash&#8221; transformed the local underground subculture into something global&#8230;<\/p>\n<p>Release 1: You Had It (Edit) \/ Music Got (Dub): Capturing the exact spirit of rough, tape-spliced dubbed cuts. The 12-inch from SP resident Sound Klash pairs a vintage production ethos with old hardware pushed to its limits&#8230;<\/p>\n<p>The Philosophy: This EP perfectly mirrors the exact philosophy that has fueled Stompa Phunk\u2019s dancefloors since 1996: uncompromising electronic music rooted in heavy sample-delia, jackin&#8217; bodies, Acid energy, disco-dub mentality and second-hand technology. Jackinacidiscotech!<\/p>","description":"<p>Underground Institution Stompa Phunk Re-Launches Vinyl Label with Raw, Chi-House-Inspired Energy. After three decades of defining the UK\u2019s underground club landscape, legendary Brighton party collective Stompa Phunk is officially moving from the dancefloor to the wax with the relaunch of Stompa Phunk Records Inc.<\/p>\n<p>The Heritage: From The Warehouse: The releases will directly honour the roots of house music, a genre born in 1977 at Chicago\u2019s legendary nightclub, The Warehouse. As that scene matured, a grittier, faster, and more experimental counterpart emerged. Defined by an uninhibited, bass-heavy style, it was a movement driven by local innovators who pushed drum machines and synthesisers to their breaking point&#8230; It wasn&#8217;t just a genre; it was a collision between pure imagination and raw machines. A true &#8220;sound klash&#8221; transformed the local underground subculture into something global&#8230;<\/p>\n<p>Release 1: You Had It (Edit) \/ Music Got (Dub): Capturing the exact spirit of rough, tape-spliced dubbed cuts. The 12-inch from SP resident Sound Klash pairs a vintage production ethos with old hardware pushed to its limits&#8230;<\/p>\n<p>The Philosophy: This EP perfectly mirrors the exact philosophy that has fueled Stompa Phunk\u2019s dancefloors since 1996: uncompromising electronic music rooted in heavy sample-delia, jackin&#8217; bodies, Acid energy, disco-dub mentality and second-hand technology. Jackinacidiscotech!<\/p>\n<div class=\"tinv-wraper woocommerce tinv-wishlist tinvwl-shortcode-add-to-cart tinvwl-loop-button-wrapper tinvwl-woocommerce_product_get_description\" data-tinvwl_product_id=\"329542\">\n<div class=\"tinv-wishlist-clear\"><\/div>\n<p><a role=\"button\" tabindex=\"0\" name=\"add-to-wishlist\" aria-label=\"Add to Wishlist\" class=\"tinvwl_add_to_wishlist_button tinvwl-icon-heart  tinvwl-position-after tinvwl-loop\" data-tinv-wl-list=\"[]\" data-tinv-wl-product=\"329542\" data-tinv-wl-productvariation=\"0\" data-tinv-wl-productvariations=\"[]\" data-tinv-wl-producttype=\"simple\" data-tinv-wl-action=\"add\"><span class=\"tinvwl_add_to_wishlist-text\">Add to Wishlist<\/span><\/a><\/p>\n<div class=\"tinv-wishlist-clear\"><\/div>\n<div class=\"tinvwl-tooltip\">Add to Wishlist<\/div>\n<\/div>","on_sale":false,"prices":{"price":"1799","regular_price":"1799","sale_price":"1799","price_range":null,"currency_code":"EUR","currency_symbol":"\u20ac","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"\u20ac ","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&euro;<\/span>&nbsp;17.99<\/span><span class=\"price-suffix\"><\/span>","average_rating":"0","review_count":0,"images":[{"id":329545,"src":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7.jpg","thumbnail":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-300x300.jpg","srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7.jpg 700w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-100x100.jpg 100w","sizes":"(max-width: 700px) 100vw, 700px","thumbnail_srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7-100x100.jpg 100w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-7.jpg 700w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"li3","alt":""}],"categories":[],"tags":[{"id":7631,"name":"store","slug":"store","link":"https:\/\/bordelloaparigi.com\/tags\/store\/"}],"brands":[],"attributes":[{"id":1,"name":"Artist","taxonomy":"pa_artist","has_variations":false,"terms":[{"id":13160,"name":"Sound Klash","slug":"sound-klash"}]},{"id":5,"name":"Format","taxonomy":"pa_format","has_variations":false,"terms":[{"id":7416,"name":"12\"","slug":"12"}]},{"id":2,"name":"Genre","taxonomy":"pa_genre","has_variations":false,"terms":[{"id":24,"name":"Edits","slug":"edits"},{"id":30,"name":"House","slug":"house"}]},{"id":3,"name":"Label","taxonomy":"pa_label","has_variations":false,"terms":[{"id":13161,"name":"Stompa Phunk Records Inc","slug":"stompa-phunk-records-inc"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"In stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Add to cart","description":"Add to cart: &ldquo;Sound Klash | You Had it (Edit) \/ Music Got (Dub) 12&#8243;&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?per_page=20&#038;orderby=date&#038;order=desc&#038;add-to-cart=329542","single_text":"Add to cart","minimum":1,"maximum":2,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products\/329542","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products?related=329542&per_page=10"}]}},{"id":329535,"name":"Chris Stussy | A Glimmer of Hope EP","slug":"chris-stussy-a-glimmer-of-hope-ep-2","parent":0,"type":"simple","variation":"","permalink":"https:\/\/bordelloaparigi.com\/shop\/vinyl\/chris-stussy-a-glimmer-of-hope-ep-2\/","sku":"KT022VG","short_description":"<p>Now repressed on Limited Edition green vinyl.<\/p>\n<p>Kerri Chandler\u2019s Kaoz Theory welcomes Amsterdam\u2019s Chris Stussy onto its roster with the \u2018A Glimmer Of Hope\u2019 EP.<\/p>\n<p>Amsterdam based producer and DJ Chris Stussy has become one of the most eminent figures in the contemporary house scene of the Netherlands and across the globe over the past five years, racking up releases on the likes of Eastenderz, Moscow, PIV, Contstant Sound and most recently his own Up The Stuss imprint. Here though he delivers his new four-tracker for Kaoz Theory.<\/p>\n<p>Leading the release is \u2018Central Frenzy\u2019, laid out across six and a half minutes with skippy percussion, a snaking bass groove, intricate synth sequences and sweeping vocal chants. \u2018Riva De Biasio\u2019 follows and tips the focus over to airy atmospherics a jazz-tinged bass groove and squelchy acid licks atop swinging drums.<\/p>\n<p>\u2018Deviant Shadow\u2019 opens the flip-side and merges an amalgamation of expansive dub chords and bouncy sub bass tones with a robust 4\/4 rhythm. Lastly to round things out is title-cut \u2018A Glimmer Of Hope\u2019, wrapping up the release on a deeper tip courtesy of ethereal pad swells, metallic synth licks and shuffled drums.<\/p>","description":"<p>Now repressed on Limited Edition green vinyl.<\/p>\n<p>Kerri Chandler\u2019s Kaoz Theory welcomes Amsterdam\u2019s Chris Stussy onto its roster with the \u2018A Glimmer Of Hope\u2019 EP.<\/p>\n<p>Amsterdam based producer and DJ Chris Stussy has become one of the most eminent figures in the contemporary house scene of the Netherlands and across the globe over the past five years, racking up releases on the likes of Eastenderz, Moscow, PIV, Contstant Sound and most recently his own Up The Stuss imprint. Here though he delivers his new four-tracker for Kaoz Theory.<\/p>\n<p>Leading the release is \u2018Central Frenzy\u2019, laid out across six and a half minutes with skippy percussion, a snaking bass groove, intricate synth sequences and sweeping vocal chants. \u2018Riva De Biasio\u2019 follows and tips the focus over to airy atmospherics a jazz-tinged bass groove and squelchy acid licks atop swinging drums.<\/p>\n<p>\u2018Deviant Shadow\u2019 opens the flip-side and merges an amalgamation of expansive dub chords and bouncy sub bass tones with a robust 4\/4 rhythm. Lastly to round things out is title-cut \u2018A Glimmer Of Hope\u2019, wrapping up the release on a deeper tip courtesy of ethereal pad swells, metallic synth licks and shuffled drums.<\/p>\n<div class=\"tinv-wraper woocommerce tinv-wishlist tinvwl-shortcode-add-to-cart tinvwl-loop-button-wrapper tinvwl-woocommerce_product_get_description\" data-tinvwl_product_id=\"329535\">\n<div class=\"tinv-wishlist-clear\"><\/div>\n<p><a role=\"button\" tabindex=\"0\" name=\"add-to-wishlist\" aria-label=\"Add to Wishlist\" class=\"tinvwl_add_to_wishlist_button tinvwl-icon-heart  tinvwl-position-after tinvwl-loop\" data-tinv-wl-list=\"[]\" data-tinv-wl-product=\"329535\" data-tinv-wl-productvariation=\"0\" data-tinv-wl-productvariations=\"[]\" data-tinv-wl-producttype=\"simple\" data-tinv-wl-action=\"add\"><span class=\"tinvwl_add_to_wishlist-text\">Add to Wishlist<\/span><\/a><\/p>\n<div class=\"tinv-wishlist-clear\"><\/div>\n<div class=\"tinvwl-tooltip\">Add to Wishlist<\/div>\n<\/div>","on_sale":false,"prices":{"price":"1899","regular_price":"1899","sale_price":"1899","price_range":null,"currency_code":"EUR","currency_symbol":"\u20ac","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"\u20ac ","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&euro;<\/span>&nbsp;18.99<\/span><span class=\"price-suffix\"><\/span>","average_rating":"0","review_count":0,"images":[{"id":329541,"src":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6.jpg","thumbnail":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-300x300.jpg","srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6.jpg 700w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-100x100.jpg 100w","sizes":"(max-width: 700px) 100vw, 700px","thumbnail_srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6-100x100.jpg 100w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li3-6.jpg 700w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"li3","alt":""}],"categories":[],"tags":[{"id":7631,"name":"store","slug":"store","link":"https:\/\/bordelloaparigi.com\/tags\/store\/"}],"brands":[],"attributes":[{"id":1,"name":"Artist","taxonomy":"pa_artist","has_variations":false,"terms":[{"id":9538,"name":"Chris Stussy","slug":"chris-stussy"}]},{"id":5,"name":"Format","taxonomy":"pa_format","has_variations":false,"terms":[{"id":7393,"name":"EP","slug":"ep"}]},{"id":2,"name":"Genre","taxonomy":"pa_genre","has_variations":false,"terms":[{"id":30,"name":"House","slug":"house"}]},{"id":3,"name":"Label","taxonomy":"pa_label","has_variations":false,"terms":[{"id":9539,"name":"Kaoz Theory","slug":"kaoz-theory"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"In stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Add to cart","description":"Add to cart: &ldquo;Chris Stussy | A Glimmer of Hope EP&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?per_page=20&#038;orderby=date&#038;order=desc&#038;add-to-cart=329535","single_text":"Add to cart","minimum":1,"maximum":2,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products\/329535","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products?related=329535&per_page=10"}]}},{"id":329528,"name":"Tonarunur | Someone Else EP","slug":"tonarunur-someone-else-ep","parent":0,"type":"simple","variation":"","permalink":"https:\/\/bordelloaparigi.com\/shop\/vinyl\/tonarunur-someone-else-ep\/","sku":"HYR7340","short_description":"<p>Hell Yeah welcomes back Tonarunur for an EP of future-facing Balearica straight out of his native Iceland. Someone Else EP is drawn from vast production archives and reveals two distinct sides to his sound, with artwork from Planet Luke.<\/p>\n<p>Tonarunur last appeared on the label with a track for the Buena Onda compilation in 2021, and has also released his unique blend of electronic boogie and space disco on Citizen of Vice, Eskimo Recordings and Whiskey Disco. Whether laying down horizontal Sunday sounds or soundtracking the dance floor, he always brings a strong sense of personality.<\/p>\n<p>Both A-side cuts feature Norway&#8217;s bass player Arctander, starting with opener &#8216;Someone Else&#8217; is a lithe mid-tempo groove with a playful, wriggling groove and sun-dappled 80s keys. The blissful &#8216;Dawn&#8217; unfolds slowly through liquid rhythms, gently broken beats and cosmic melodies awash with good vibrations. On the flip, &#8216;Lundur 1&#8217; drifts into the stars on shimmering pads and floating grooves and is romantic yet melancholic, before &#8216;Lundur 2&#8217; closes with a more grounded rhythm and wispy melodies tracing patterns across a starry night sky.<\/p>\n<p>Equal parts sunset escapism and after-hours introspection, Someone Else EP drifts effortlessly between the club and the cosmos.<\/p>","description":"<p>Hell Yeah welcomes back Tonarunur for an EP of future-facing Balearica straight out of his native Iceland. Someone Else EP is drawn from vast production archives and reveals two distinct sides to his sound, with artwork from Planet Luke.<\/p>\n<p>Tonarunur last appeared on the label with a track for the Buena Onda compilation in 2021, and has also released his unique blend of electronic boogie and space disco on Citizen of Vice, Eskimo Recordings and Whiskey Disco. Whether laying down horizontal Sunday sounds or soundtracking the dance floor, he always brings a strong sense of personality.<\/p>\n<p>Both A-side cuts feature Norway&#8217;s bass player Arctander, starting with opener &#8216;Someone Else&#8217; is a lithe mid-tempo groove with a playful, wriggling groove and sun-dappled 80s keys. The blissful &#8216;Dawn&#8217; unfolds slowly through liquid rhythms, gently broken beats and cosmic melodies awash with good vibrations. On the flip, &#8216;Lundur 1&#8217; drifts into the stars on shimmering pads and floating grooves and is romantic yet melancholic, before &#8216;Lundur 2&#8217; closes with a more grounded rhythm and wispy melodies tracing patterns across a starry night sky.<\/p>\n<p>Equal parts sunset escapism and after-hours introspection, Someone Else EP drifts effortlessly between the club and the cosmos.<\/p>\n<div class=\"tinv-wraper woocommerce tinv-wishlist tinvwl-shortcode-add-to-cart tinvwl-loop-button-wrapper tinvwl-woocommerce_product_get_description\" data-tinvwl_product_id=\"329528\">\n<div class=\"tinv-wishlist-clear\"><\/div>\n<p><a role=\"button\" tabindex=\"0\" name=\"add-to-wishlist\" aria-label=\"Add to Wishlist\" class=\"tinvwl_add_to_wishlist_button tinvwl-icon-heart  tinvwl-position-after tinvwl-loop\" data-tinv-wl-list=\"[]\" data-tinv-wl-product=\"329528\" data-tinv-wl-productvariation=\"0\" data-tinv-wl-productvariations=\"[]\" data-tinv-wl-producttype=\"simple\" data-tinv-wl-action=\"add\"><span class=\"tinvwl_add_to_wishlist-text\">Add to Wishlist<\/span><\/a><\/p>\n<div class=\"tinv-wishlist-clear\"><\/div>\n<div class=\"tinvwl-tooltip\">Add to Wishlist<\/div>\n<\/div>","on_sale":false,"prices":{"price":"1799","regular_price":"1799","sale_price":"1799","price_range":null,"currency_code":"EUR","currency_symbol":"\u20ac","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"\u20ac ","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&euro;<\/span>&nbsp;17.99<\/span><span class=\"price-suffix\"><\/span>","average_rating":"0","review_count":0,"images":[{"id":329533,"src":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3.jpg","thumbnail":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-300x300.jpg","srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3.jpg 700w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-100x100.jpg 100w","sizes":"(max-width: 700px) 100vw, 700px","thumbnail_srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3-100x100.jpg 100w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-3.jpg 700w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"li1","alt":""}],"categories":[],"tags":[{"id":7631,"name":"store","slug":"store","link":"https:\/\/bordelloaparigi.com\/tags\/store\/"}],"brands":[],"attributes":[{"id":1,"name":"Artist","taxonomy":"pa_artist","has_variations":false,"terms":[{"id":13159,"name":"Tonarunur","slug":"tonarunur"}]},{"id":5,"name":"Format","taxonomy":"pa_format","has_variations":false,"terms":[{"id":7393,"name":"EP","slug":"ep"}]},{"id":2,"name":"Genre","taxonomy":"pa_genre","has_variations":false,"terms":[{"id":228,"name":"Balearic","slug":"balearic"},{"id":1309,"name":"Downtempo","slug":"downtempo"}]},{"id":3,"name":"Label","taxonomy":"pa_label","has_variations":false,"terms":[{"id":9380,"name":"Hell Yeah Recordings","slug":"hell-yeah-recordings"}]},{"id":4,"name":"Status","taxonomy":"pa_status","has_variations":false,"terms":[{"id":6747,"name":"New Arrivals","slug":"new-arrivals"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"In stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Add to cart","description":"Add to cart: &ldquo;Tonarunur | Someone Else EP&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?per_page=20&#038;orderby=date&#038;order=desc&#038;add-to-cart=329528","single_text":"Add to cart","minimum":1,"maximum":4,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products\/329528","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products?related=329528&per_page=10"}]}},{"id":329522,"name":"JKriv | JKriv Edits Vol. 2 EP","slug":"jkriv-jkriv-edits-vol-2-ep","parent":0,"type":"simple","variation":"","permalink":"https:\/\/bordelloaparigi.com\/shop\/vinyl\/jkriv-jkriv-edits-vol-2-ep\/","sku":"rnt067","short_description":"<p>10 years since his first edits outing on RNT, label co-founder JKriv digs into his deep well of reworks for a four-tracker of cheeky dancefloor madness. Coming in hot on the A side, I Feel Amor is modern twist on the disco classic anthem, a peak time weapon of epic proportions with hard-hitting beats and churning synths, and the inimitable sing-along vocal (pero en Espa\u00f1ol). Love Dub is a stripped down deep house affair, a solid driving groove with thunderous bass, synth accents and acapella flourishes. On the B-side, Cuando Bailo is the edit you didn\u2019t know you needed; a callback to a bygone era of one-hit wonder magic, flipped masterfully to be all-club and just a sprinkle of camp. And rounding off the record Dance Sexy takes an obscure purple-hued cover into hypnotic red-light territory, with funky synth stabs riding a pulsing and infectious bass line, in classic JKriv fashion.<\/p>","description":"<p>10 years since his first edits outing on RNT, label co-founder JKriv digs into his deep well of reworks for a four-tracker of cheeky dancefloor madness. Coming in hot on the A side, I Feel Amor is modern twist on the disco classic anthem, a peak time weapon of epic proportions with hard-hitting beats and churning synths, and the inimitable sing-along vocal (pero en Espa\u00f1ol). Love Dub is a stripped down deep house affair, a solid driving groove with thunderous bass, synth accents and acapella flourishes. On the B-side, Cuando Bailo is the edit you didn\u2019t know you needed; a callback to a bygone era of one-hit wonder magic, flipped masterfully to be all-club and just a sprinkle of camp. And rounding off the record Dance Sexy takes an obscure purple-hued cover into hypnotic red-light territory, with funky synth stabs riding a pulsing and infectious bass line, in classic JKriv fashion.<\/p>\n<div class=\"tinv-wraper woocommerce tinv-wishlist tinvwl-shortcode-add-to-cart tinvwl-loop-button-wrapper tinvwl-woocommerce_product_get_description\" data-tinvwl_product_id=\"329522\">\n<div class=\"tinv-wishlist-clear\"><\/div>\n<p><a role=\"button\" tabindex=\"0\" name=\"add-to-wishlist\" aria-label=\"Add to Wishlist\" class=\"tinvwl_add_to_wishlist_button tinvwl-icon-heart  tinvwl-position-after tinvwl-loop\" data-tinv-wl-list=\"[]\" data-tinv-wl-product=\"329522\" data-tinv-wl-productvariation=\"0\" data-tinv-wl-productvariations=\"[]\" data-tinv-wl-producttype=\"simple\" data-tinv-wl-action=\"add\"><span class=\"tinvwl_add_to_wishlist-text\">Add to Wishlist<\/span><\/a><\/p>\n<div class=\"tinv-wishlist-clear\"><\/div>\n<div class=\"tinvwl-tooltip\">Add to Wishlist<\/div>\n<\/div>","on_sale":false,"prices":{"price":"1899","regular_price":"1899","sale_price":"1899","price_range":null,"currency_code":"EUR","currency_symbol":"\u20ac","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"\u20ac ","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencyS