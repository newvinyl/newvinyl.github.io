30,"name":"House","slug":"house"}]},{"id":4,"name":"Status","taxonomy":"pa_status","has_variations":false,"terms":[{"id":6747,"name":"New Arrivals","slug":"new-arrivals"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"In stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Add to cart","description":"Add to cart: &ldquo;Luca Olivotto | Underground Ensemble EP&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?per_page=20&#038;orderby=date&#038;order=desc&#038;add-to-cart=329467","single_text":"Add to cart","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products\/329467","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products?related=329467&per_page=10"}]}},{"id":329461,"name":"Tommy Musto \/ Kenny Dope \/ Mike Delgado \/ Matthias Heilbronn | The Sound Of Sub-Urban Volume 4 EP","slug":"tommy-musto-kenny-dope-mike-delgado-matthias-heilbronn-the-sound-of-sub-urban-volume-4","parent":0,"type":"simple","variation":"","permalink":"https:\/\/bordelloaparigi.com\/shop\/vinyl\/tommy-musto-kenny-dope-mike-delgado-matthias-heilbronn-the-sound-of-sub-urban-volume-4\/","sku":"SU89","short_description":"<p>The Sound Of Sub-Urban Volume 4 carries on the celebrated series, showcasing selections from the legendary Sub-Urban catalogue, bringing together a selection of classic garage house cuts from some of the scene\u2019s most respected names.<\/p>\n<p>Featuring standout tracks from Tommy Musto under both his Tribute &amp; Unifunkation guises, Kenny Dope as well as Matthias Heilbronn &amp; Mike Delgado as Lift, the release captures the soulful, groove-led sound that helped define New York and US garage house throughout the 90s.<\/p>\n<p>Including favourites such as Kenny Dope presents James Rouse\u2019s Dance and Unifunkation featuring Alexander East\u2019s Feel Me, this fourth volume brings together a selection of proven club records in one DJ-friendly vinyl package.<\/p>","description":"<p>The Sound Of Sub-Urban Volume 4 carries on the celebrated series, showcasing selections from the legendary Sub-Urban catalogue, bringing together a selection of classic garage house cuts from some of the scene\u2019s most respected names.<\/p>\n<p>Featuring standout tracks from Tommy Musto under both his Tribute &amp; Unifunkation guises, Kenny Dope as well as Matthias Heilbronn &amp; Mike Delgado as Lift, the release captures the soulful, groove-led sound that helped define New York and US garage house throughout the 90s.<\/p>\n<p>Including favourites such as Kenny Dope presents James Rouse\u2019s Dance and Unifunkation featuring Alexander East\u2019s Feel Me, this fourth volume brings together a selection of proven club records in one DJ-friendly vinyl package.<\/p>\n<div class=\"tinv-wraper woocommerce tinv-wishlist tinvwl-shortcode-add-to-cart tinvwl-loop-button-wrapper tinvwl-woocommerce_product_get_description\" data-tinvwl_product_id=\"329461\">\n<div class=\"tinv-wishlist-clear\"><\/div>\n<p><a role=\"button\" tabindex=\"0\" name=\"add-to-wishlist\" aria-label=\"Add to Wishlist\" class=\"tinvwl_add_to_wishlist_button tinvwl-icon-heart  tinvwl-position-after tinvwl-loop\" data-tinv-wl-list=\"[]\" data-tinv-wl-product=\"329461\" data-tinv-wl-productvariation=\"0\" data-tinv-wl-productvariations=\"[]\" data-tinv-wl-producttype=\"simple\" data-tinv-wl-action=\"add\"><span class=\"tinvwl_add_to_wishlist-text\">Add to Wishlist<\/span><\/a><\/p>\n<div class=\"tinv-wishlist-clear\"><\/div>\n<div class=\"tinvwl-tooltip\">Add to Wishlist<\/div>\n<\/div>","on_sale":false,"prices":{"price":"1799","regular_price":"1799","sale_price":"1799","price_range":null,"currency_code":"EUR","currency_symbol":"\u20ac","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"\u20ac ","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&euro;<\/span>&nbsp;17.99<\/span><span class=\"price-suffix\"><\/span>","average_rating":"0","review_count":0,"images":[{"id":329466,"src":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1.jpg","thumbnail":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-300x300.jpg","srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1.jpg 700w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-100x100.jpg 100w","sizes":"(max-width: 700px) 100vw, 700px","thumbnail_srcset":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-300x300.jpg 300w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-150x150.jpg 150w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-250x250.jpg 250w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-600x600.jpg 600w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1-100x100.jpg 100w, https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li1.jpg 700w","thumbnail_sizes":"(max-width: 300px) 100vw, 300px","name":"li1","alt":""}],"categories":[],"tags":[{"id":7631,"name":"store","slug":"store","link":"https:\/\/bordelloaparigi.com\/tags\/store\/"}],"brands":[],"attributes":[{"id":1,"name":"Artist","taxonomy":"pa_artist","has_variations":false,"terms":[{"id":45,"name":"Various Artists","slug":"various-artists"}]},{"id":5,"name":"Format","taxonomy":"pa_format","has_variations":false,"terms":[{"id":7393,"name":"EP","slug":"ep"}]},{"id":2,"name":"Genre","taxonomy":"pa_genre","has_variations":false,"terms":[{"id":30,"name":"House","slug":"house"}]},{"id":3,"name":"Label","taxonomy":"pa_label","has_variations":false,"terms":[{"id":13146,"name":"Sub-Urban Records","slug":"sub-urban-records"}]}],"variations":[],"grouped_products":[],"has_options":false,"is_purchasable":true,"is_in_stock":true,"is_on_backorder":false,"low_stock_remaining":null,"stock_availability":{"text":"In stock","class":"in-stock"},"sold_individually":false,"weight":"","dimensions":{"length":"","width":"","height":""},"formatted_weight":"N\/A","formatted_dimensions":"N\/A","add_to_cart":{"text":"Add to cart","description":"Add to cart: &ldquo;Tommy Musto \/ Kenny Dope \/ Mike Delgado \/ Matthias Heilbronn | The Sound Of Sub-Urban Volume 4 EP&rdquo;","url":"\/wp-json\/wc\/store\/v1\/products?per_page=20&#038;orderby=date&#038;order=desc&#038;add-to-cart=329461","single_text":"Add to cart","minimum":1,"maximum":1,"multiple_of":1},"is_password_protected":false,"extensions":{},"_links":{"self":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products\/329461","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products"}],"related":[{"embeddable":true,"href":"https:\/\/bordelloaparigi.com\/wp-json\/wc\/store\/v1\/products?related=329461&per_page=10"}]}},{"id":329455,"name":"Manuel Darquart | Edits #1 EP","slug":"manuel-darquart-edits-1","parent":0,"type":"simple","variation":"","permalink":"https:\/\/bordelloaparigi.com\/shop\/vinyl\/manuel-darquart-edits-1\/","sku":"AIP1","short_description":"<p>Four cuts destined to take you on an Adventure In Paradise. No additives, just raw records spliced, diced, and processed through the blender to better feed the dancefloor and DJs alike.<\/p>\n<p>A1 &#8211; If you\u2019re asking yourself if something can be chuggy at 128 bpm then you\u2019re in the right place. Disco-stomping belter ploughing its way down the M20 searching for the port, then the south of France and finally Freddie\u2019s bedroom. Don\u2019t forget the stops for a breather.<\/p>\n<p>A2 &#8211; Four films?? That\u2019s about as insane as this edit; a swaggering, mop-topped and dubbed-out groover boasting a ph-fat flamenco freakout at its klymaxxx. Would Harvey play it? Dunno, but the bootleg variety definitely already does.<\/p>\n<p>B1 &#8211; Shades of Rimini as the pianos set over another rubbery bassline and the Adriatic Sea arpeggiates its ocean spray all over the gaffe. If this ain\u2019t heaven, we\u2019re not sure what is.<\/p>\n<p>B2 &#8211; Nothing like a lashing of nutritious Italo-dance slop to carb-o-load the dancefloor at its peak. Just watch as the crowd devours this Rag\u00fa of musical flavours, with elements of Disco, New Wave, Acid House and Jazz all thrown in the pot.<\/p>","description":"<p>Four cuts destined to take you on an Adventure In Paradise. No additives, just raw records spliced, diced, and processed through the blender to better feed the dancefloor and DJs alike.<\/p>\n<p>A1 &#8211; If you\u2019re asking yourself if something can be chuggy at 128 bpm then you\u2019re in the right place. Disco-stomping belter ploughing its way down the M20 searching for the port, then the south of France and finally Freddie\u2019s bedroom. Don\u2019t forget the stops for a breather.<\/p>\n<p>A2 &#8211; Four films?? That\u2019s about as insane as this edit; a swaggering, mop-topped and dubbed-out groover boasting a ph-fat flamenco freakout at its klymaxxx. Would Harvey play it? Dunno, but the bootleg variety definitely already does.<\/p>\n<p>B1 &#8211; Shades of Rimini as the pianos set over another rubbery bassline and the Adriatic Sea arpeggiates its ocean spray all over the gaffe. If this ain\u2019t heaven, we\u2019re not sure what is.<\/p>\n<p>B2 &#8211; Nothing like a lashing of nutritious Italo-dance slop to carb-o-load the dancefloor at its peak. Just watch as the crowd devours this Rag\u00fa of musical flavours, with elements of Disco, New Wave, Acid House and Jazz all thrown in the pot.<\/p>\n<div class=\"tinv-wraper woocommerce tinv-wishlist tinvwl-shortcode-add-to-cart tinvwl-loop-button-wrapper tinvwl-woocommerce_product_get_description\" data-tinvwl_product_id=\"329455\">\n<div class=\"tinv-wishlist-clear\"><\/div>\n<p><a role=\"button\" tabindex=\"0\" name=\"add-to-wishlist\" aria-label=\"Add to Wishlist\" class=\"tinvwl_add_to_wishlist_button tinvwl-icon-heart  tinvwl-position-after tinvwl-loop\" data-tinv-wl-list=\"[]\" data-tinv-wl-product=\"329455\" data-tinv-wl-productvariation=\"0\" data-tinv-wl-productvariations=\"[]\" data-tinv-wl-producttype=\"simple\" data-tinv-wl-action=\"add\"><span class=\"tinvwl_add_to_wishlist-text\">Add to Wishlist<\/span><\/a><\/p>\n<div class=\"tinv-wishlist-clear\"><\/div>\n<div class=\"tinvwl-tooltip\">Add to Wishlist<\/div>\n<\/div>","on_sale":false,"prices":{"price":"1799","regular_price":"1799","sale_price":"1799","price_range":null,"currency_code":"EUR","currency_symbol":"\u20ac","currency_minor_unit":2,"currency_decimal_separator":".","currency_thousand_separator":",","currency_prefix":"\u20ac ","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&euro;<\/span>&nbsp;17.99<\/span><span class=\"price-suffix\"><\/span>","average_rating":"0","review_count":0,"images":[{"id":329460,"src":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li2-17.jpg","thumbnail":"https:\/\/bordelloaparigi.com\/wp-content\/uploads\/2026\/10\/li2-17-300x300.jpg","srcset":"https:\/\/bordelloaparigi.com\/wp-content