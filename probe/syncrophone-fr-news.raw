<script>
(function() {
function viderChampsRecherche() {
var champs = document.querySelectorAll('input[name="keywords"], .input-text-search, .Head_recherche input');
for (var i = 0; i < champs.length; i++) {
var c = champs[i];
// On vide le champ s'il n'est pas en train d'etre utilise par le visiteur
if (document.activeElement !== c && !c.dataset.snTyping) {
c.value = '';
c.setAttribute('value', '');
c.setAttribute('placeholder', 'Search ...');
}
if (!c.dataset.snInit) {
c.dataset.snInit = '1';
c.addEventListener('input', function() {
this.dataset.snTyping = '1';
});
}
}
}
viderChampsRecherche();
document.addEventListener('DOMContentLoaded', viderChampsRecherche);
window.addEventListener('load', viderChampsRecherche);
setTimeout(viderChampsRecherche, 150);
setTimeout(viderChampsRecherche, 500);
})();
</script>
