class="html-template row no-margin  id-usr-ifryv"	data-uniqid="1787578099"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
(function () {
function placerFleches() {
document.querySelectorAll('.jq-commerce-owl-carousel').forEach(function (car) {
var nav = car.querySelector('.owl-nav');
if (!nav || nav.classList.contains('syncro-navwrap')) return;
// Cherche le titre h2 le plus proche au-dessus du carrousel
var titre = null, p = car;
while (p && !titre) {
p = p.parentElement;
if (p) titre = p.querySelector('h2.title-component, h2.boite1-titre, h2.boite5-titre');
}
if (!titre) return;
nav.classList.add('syncro-navwrap');
titre.appendChild(nav);
titre.classList.add('titre-avec-fleches');
});
}
document.addEventListener('DOMContentLoaded', placerFleches);
window.addEventListener('load', placerFleches);
setTimeout(placerFleches, 1500); // filet de sécurité si Owl s'initialise tard
})();
</script>	</div>
