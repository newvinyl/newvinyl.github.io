}
</style>
<script>
document.addEventListener("DOMContentLoaded", function() {
var catMatch = window.location.pathname.match(/week-c(\d+)\.html/);
var currentCateg = catMatch ? catMatch[1] : null;
document.querySelectorAll(".button-component").forEach(function(btn) {
var link = btn.querySelector("a");
if (!link) return;
try {
var url = new URL(link.href, window.location.href);
var linkCateg = url.searchParams.get("id_categ");
if (currentCateg && linkCateg === currentCateg) {
btn.classList.add("active");
return;
}
if (window.location.pathname === url.pathname) {
btn.classList.add("active");
}
} catch(e) {}
});
});
</script>	</div>
