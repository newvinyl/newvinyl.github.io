<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Anti-flash des pages au style News (v1)
Pose la classe sn-attente sur <html> des le debut du chargement, sur les pages
traitees par le script "Page News". Le CSS (section NEWS, "Anti-flash") masque
alors la liste et le fil d'Ariane d'Oasis jusqu'a ce que le script ait fini
(classe sn-ariane-on), avec un filet de securite de 2 s.
A garder aligne avec la table PAGES du script "Page News" : une page ajoutee
la-bas doit etre ajoutee ici (sinon elle a simplement le flash, rien de casse).
Pages label (/nom-m12345.html) reconnues a leur adresse.
-------------------------------------------------------------------------- */
(function () {
var p = location.pathname;
var L = ['/news/', '/back-in-stock/', '/all-stock/', '/exclusives/', '/presales-exclusives/', '/dj-equipment/', '/genres/', '/artists/'];
for (var i = 0; i < L.length; i++) {
if (p.indexOf(L[i]) === 0) { document.documentElement.className += ' sn-attente'; return; }
}
if (/-m\d+\.html$/.test(p)) document.documentElement.className += ' sn-attente';
})();
</script>	</div>
</div>
</div>
</div>
</div>
