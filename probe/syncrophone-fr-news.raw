<script>
(function () {
function nettoyerDescription() {
var d = document.getElementById('div_description_longue');
if (!d || d.dataset.nettoye) return;
d.querySelectorAll('br').forEach(function (b) {
b.replaceWith(document.createTextNode(' '));
});
d.querySelectorAll('p, div').forEach(function (e) {
if (e.children.length === 0) {
e.textContent = e.textContent.replace(/\s{2,}/g, ' ').trim();
}
});
d.dataset.nettoye = '1';
}
document.addEventListener('DOMContentLoaded', nettoyerDescription);
window.addEventListener('load', nettoyerDescription);
})();
</script>	</div>
