<div
class="html-template row no-margin  id-usr-izroh"	data-uniqid="1790079000"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Badge "Repress" sur le site public (v2)
A coller dans un bloc HTML du footer (present sur toutes les pages).
Pose l'etiquette "Repress" (coin haut droit de la pochette, en face de
New / Preorder) sur tous les disques qui ont le filtre Oasis "Repress"
(groupe 13) : cartes de l'accueil, page News, categories, recherche,
carrousels des fiches, et sur l'image de la fiche du disque elle-meme.
Comment : Oasis ne met pas les filtres dans le code des cartes. Le script
lit donc la liste "All Stock" (et "Presales") filtree sur Repress, en
arriere-plan, et retient les adresses des disques concernes. Cette liste
est gardee MEMOIRE_MINUTES minutes dans le navigateur du visiteur : un
filtre Repress ajoute dans Oasis apparait donc au plus tard apres ce
delai (tout de suite dans une fenetre de navigation privee).
Sur les pages de l'espace B2B, c'est le script B2B qui s'en charge : ce
script-ci n'y fait rien.
v2 : sur telephone, l'etiquette a la meme taille que "New" d'Oasis
(16 px, marges 10 x 18 px) ; sur ordinateur elle l'avait deja (11 px,
marges 6 x 10 px).
-------------------------------------------------------------------------- */
(function () {
if (window.snRepressPublic) return;
window.snRepressPublic = true;
/* Texte de l'etiquette */
var TXT_REPRESS = 'Repress';
/* Valeur du filtre "Repress" dans Oasis (groupe 13) */
var VALEUR_FILTRE = '5459';
/* Listes lues pour trouver les represses (en stock, puis precommandes) */
var SOURCES = ['/exclusives/', '/presales-exclusives/'];
/* Duree de la memoire (minutes) */
var MEMOIRE_MINUTES = 15;
var CLE = 'sn-repress-public';
var liste = null;
var enCours = false;
function lireMemoire() {
try {
var m = JSON.parse(localStorage.getItem(CLE) || 'null');
if (m && m.liens) return m;
} catch (e) {}
return null;
}
/* ---- Lecture des listes filtrees sur Repress ---- */
function page(url) {
return fetch(url, { credentials: 'same-origin' })
.then(function (r) { return r.arrayBuffer(); })
.then(function (b) { return new DOMParser().parseFromString(new TextDecoder('windows-1252').decode(b), 'text/html'); });
}
/* Une source, page apres page. Si le filtre Repress n'existe pas sur
cette liste (aucun disque concerne), Oasis renverrait tout : on verifie
donc que la case Repress est bien cochee dans la reponse. */
function lireSource(base, n, trouves) {
var url = base + '?filtres=' + encodeURIComponent(VALEUR_FILTRE + ';') + (n > 1 ? '&numPage=' + n : '');
return page(url).then(function (d) {
var coche = d.querySelector('input[value="' + VALEUR_FILTRE + '"][checked], input[id$="_' + VALEUR_FILTRE + '"][checked]');
if (!coche) return trouves;
var module = d.querySelector('.with-filters-aside') || d;
var liens = module.querySelectorAll('.boite_produit1 .bp_designation a[href]');
var nouveaux = 0;
for (var i = 0; i < liens.length; i++) {
var p = new URL(liens[i].getAttribute('href'), location.href).pathname;
if (trouves.indexOf(p) < 0) { trouves.push(p); nouveaux++; }
}
if (nouveaux && n < 10) return lireSource(base, n + 1, trouves);
return trouves;
}).catch(function () { return trouves; });
}
function relire() {
if (enCours) return;
enCours = true;
var trouves = [];
var chaine = Promise.resolve(trouves);
SOURCES.forEach(function (s) { chaine = chaine.then(function (t) { return lireSource(s, 1, t); }); });
chaine.then(function (t) {
enCours = false;
liste = t;
try { localStorage.setItem(CLE, JSON.stringify({ t: Date.now(), liens: t })); } catch (e) {}
marquer();
});
}
/* ---- Pose des etiquettes ---- */
function etiquette(classe) {
var s = document.createElement('span');
s.className = 'sn-repress' + (classe ? ' ' + classe : '');
s.textContent = TXT_REPRESS;
return s;
}
function marquer() {
if (!liste || document.body.classList.contains('sn-b2b')) return;
/* Cartes disque */
var cartes = document.querySelectorAll('.boite_produit1');
for (var i = 0; i < cartes.length; i++) {
var lien = cartes[i].querySelector('.bp_designation a[href]');
var image = cartes[i].querySelector('.bp_image');
if (!lien || !image) continue;
var oui = liste.indexOf(lien.pathname) > -1;
var existe = image.querySelector('.sn-repress');
if (oui && !existe) image.appendChild(etiquette(''));
if (!oui && existe) existe.parentNode.removeChild(existe);
}
/* Fiche du disque */
var bloc = document.querySelector('.fa_bloc-image-principale');
if (bloc) {
var ouiF = liste.indexOf(location.pathname) > -1;
var existeF = bloc.querySelector('.sn-repress-fiche');
if (ouiF && !existeF) bloc.appendChild(etiquette('sn-repress-fiche'));
if (!ouiF && existeF) existeF.parentNode.removeChild(existeF);
}
}
/* Cartes ajoutees apres coup (carrousels, filtres, pages suivantes) */
function surveiller() {
if (!window.MutationObserver) return;
var minuterie = null;
new MutationObserver(function (mutations) {
for (var i = 0; i < mutations.length; i++) {
for (var j = 0; j < mutations[i].addedNodes.length; j++) {
var n = mutations[i].addedNodes[j];
if (n.nodeType === 1 && !(n.classList && n.classList.contains('sn-repress'))) {
clearTimeout(minuterie);
minuterie = setTimeout(marquer, 150);
return;
}
}
}
}).observe(document.body, { childList: true, subtree: true });
}
function demarrer() {
var m = lireMemoire();
if (m) { liste = m.liens; marquer(); }
if (!m || Date.now() - m.t > MEMOIRE_MINUTES * 60000) relire();
surveiller();
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', demarrer, { once: true });
else demarrer();
})();
</script>
<style>
/* Etiquette "Repress" (site public) : coin haut droit de la pochette, en
face de New / Preorder, en aplat encre. Memes dimensions que les
etiquettes Oasis. Sur la fiche : coin haut droit de la grande image. */
.boite_produit1 .bp_image { position: relative; }
.boite_produit1 .bp_image .sn-repress,
.fa_bloc-image-principale .sn-repress-fiche {
position: absolute !important;
top: 12px !important;
right: 12px !important;
bottom: auto !important;
left: auto !important;
z-index: 12 !important;
display: inline-block !important;
margin: 0 !important;
padding: 6px 10px !important;
background: #20211f !important;
color: #f9f9f6 !important;
font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
font-size: 11px !important;
font-weight: 400 !important;
line-height: 1 !important;
letter-spacing: 0 !important;
text-transform: none !important;
white-space: nowrap !important;
pointer-events: none;
}
.fa_bloc-image-principale .sn-repress-fiche {
top: 16px !important;
right: 16px !important;
padding: 8px 12px !important;
font-size: 13px !important;
}
/* Telephone : meme taille que "New" d'Oasis sur mobile (16 px, marges
10 x 18 px). En bas a droite de la carte : a cote de New / Preorder, a
cette taille, il ne tiendrait pas sur une petite carte. */
@media screen and (max-width: 640px) {
.boite_produit1 .bp_image .sn-repress {
top: auto !important;
bottom: 10px !important;
right: 10px !important;
padding: 10px 18px !important;
font-size: 16px !important;
line-height: 1.1 !important;
}
}
html body.dark-mode .boite_produit1 .bp_image .sn-repress,
html body.dark-mode .fa_bloc-image-principale .sn-repress-fiche {
background-color: #e8e8e2 !important;
color: #1a1b19 !important;
}
</style>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-igqis"	data-uniqid="1790079763"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Titre des pages categorie (v2)
Probleme : le module "liste de produits" du modele de page categorie
(page 801 d'Oasis) a un titre fixe, "Presales Exclusives". Ce modele sert
a toutes les categories (genres, artistes, All stock...) : elles
affichaient toutes "PRESALES EXCLUSIVES" en titre.
Le vrai nom de la categorie est dans le H1 de la page ("House", "Vakula"),
mais le theme le cache (1 px, couleur du fond) pour le referencement.
Ce script recopie ce nom dans le titre visible du module, en capitales.
v2 : plus de "PRESALES EXCLUSIVES" furtif au chargement. Le titre reste
masque par la feuille de style (section "TITRE DES PAGES CATEGORIE") tant
que ce script n'a pas ecrit le bon nom ; il agit des qu'il est lu, puis
pose la classe sn-titre-ok qui rend le titre visible.
Ne touche pas aux pages B2B (leur titre est fait par le script B2B) ni
aux pages qui ont leur propre module (News, Back in stock).
A coller dans un bloc HTML du footer (present sur toutes les pages).
-------------------------------------------------------------------------- */
(function () {
function titre() {
var h1 = document.querySelector('h1.Head_h1');
var h2 = document.querySelector('.category-commerce-template .template-title h2');
if (h1 && h2) {
var nom = h1.textContent.replace(/\s+/g, ' ').trim();
if (nom && !/page non trouv/i.test(nom)) {
nom = nom.toUpperCase();
if (h2.textContent.replace(/\s+/g, ' ').trim() !== nom) h2.textContent = nom;
}
}
/* Titre pret (ou page sans titre de module) : on le rend visible */
if (h2 || document.readyState !== 'loading') document.documentElement.classList.add('sn-titre-ok');
return !!h2;
}
/* Le bloc est en bas de page : le titre est deja la, on agit tout de suite.
Sinon on attend que la page soit lue. */
if (!titre()) document.addEventListener('DOMContentLoaded', titre, { once: true });
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-i42bx"	data-uniqid="1790080365"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Espace client : page compte /extranet/ et pages internes (v2)
Va avec la section "ESPACE CLIENT" de la feuille de style.
- En-tete dans le dessin des pages News / B2B : point bleu + "Trade
account" (compte pro) ou "Your account", puis "Hello, NOM" en grand ;
a droite, la phrase de bienvenue (reprise du texte Oasis de la page,
donc modifiable dans Oasis) et un lien "Log out".
- Libelles corriges : Datas, Adresses, Mes cartes cadeaux...
- Pose la classe sn-compte-ok quand tout est pret : la feuille de style
garde la page masquee jusque-la (pas de flash de l'ancienne page).
v2 : pages internes de l'espace client (Orders, Backorders, Password...,
adresses /dhtml/...) : en-tete reduit sur toute la largeur (point bleu +
"Trade account", nom de la page, Log out), au lieu du grand "Hello, NOM"
qui se retrouvait dans la colonne etroite du menu. Le grand en-tete reste
reserve a la page compte.
A coller dans un bloc HTML du footer (present sur toutes les pages) :
il ne fait rien en dehors de l'espace client.
-------------------------------------------------------------------------- */
(function () {
/* Textes (modifiables) */
var TXT_SURTITRE_PRO = 'Trade account';
var TXT_SURTITRE = 'Your account';
var TXT_BONJOUR = 'Hello';
var TXT_SORTIE = 'Log out';
/* Libelles d'Oasis a remplacer : 'texte Oasis': 'nouveau texte' */
var LIBELLES = {
'Datas': 'Your details',
'Adresses': 'Addresses',
'Favorite / Wantlist': 'Favorites',
'Mes cartes cadeaux': 'Gift cards',
'Parcel': 'Parcels'
};
function pret() { document.documentElement.classList.add('sn-compte-ok'); }
function nettoyer(t) { return (t || '').replace(/\s+/g, ' ').trim(); }
/* Morceaux communs de l'en-tete */
function surtitre(texte) {
var sur = document.createElement('p');
sur.className = 'sn-compte-surtitre';
var point = document.createElement('span');
point.className = 'sn-compte-point';
sur.appendChild(point);
sur.appendChild(document.createTextNode(texte));
return sur;
}
function lienSortie(sortie) {
var a = document.createElement('a');
a.className = 'sn-compte-sortie';
a.href = sortie.href;
a.textContent = TXT_SORTIE + ' \u2197\uFE0E';
return a;
}
/* Pages internes : en-tete reduit, au-dessus du menu et du contenu */
function pageInterne(menu, pro, sortie) {
var rangee = menu.closest('.contents');
if (!rangee) { pret(); return true; }
var h1 = document.querySelector('h1.Head_h1');
var nomPage = h1 ? nettoyer(h1.textContent) : nettoyer(document.title.split(' - ')[0]);
var tete = document.createElement('div');
tete.className = 'sn-compte-tete sn-compte-tete-page';
var gauche = document.createElement('div');
gauche.className = 'sn-compte-gauche';
gauche.appendChild(surtitre(pro ? TXT_SURTITRE_PRO : TXT_SURTITRE));
var h = document.createElement('h2');
h.className = 'sn-compte-titre';
h.textContent = nomPage;
gauche.appendChild(h);
tete.appendChild(gauche);
if (sortie) {
var droite = document.createElement('div');
droite.className = 'sn-compte-droite';
droite.appendChild(lienSortie(sortie));
tete.appendChild(droite);
}
rangee.insertBefore(tete, rangee.firstChild);
pret();
return true;
}
function construire() {
var menu = document.querySelector('.extranet-menu');
if (!menu) return false;
if (document.querySelector('.sn-compte-tete')) { pret(); return true; }
/* Libelles */
var elements = menu.querySelectorAll('.card-title, a.lien span');
for (var i = 0; i < elements.length; i++) {
var t = nettoyer(elements[i].textContent);
if (LIBELLES[t]) elements[i].textContent = LIBELLES[t];
}
/* Nom du client : lien du compte en haut de page */
var nom = '';
var liensCompte = document.querySelectorAll('.Head_bandeauFond a[href*="extranet"]');
for (var j = 0; j < liensCompte.length; j++) {
var n = nettoyer(liensCompte[j].textContent);
if (n && !/^(account|compte|mon compte)$/i.test(n)) { nom = n; break; }
}
/* Compte pro : le menu du haut est celui de la distribution */
var menuHaut = document.querySelector('.Head_menu');
var pro = !!(menuHaut && /distribution/i.test(menuHaut.textContent));
var sortie = document.querySelector('a[href*="deconnect=1"]');
var accueil = /^\/extranet\/?(index\.php)?$/i.test(location.pathname);
if (!accueil) return pageInterne(menu, pro, sortie);
/* Texte de bienvenue Oasis : le plus long paragraphe du bloc de texte */
var bloc = null;
var textes = document.querySelectorAll('.text-template');
for (var k = 0; k < textes.length; k++) {
if (/hello|welcome/i.test(textes[k].textContent)) { bloc = textes[k]; break; }
}
var intro = '';
if (bloc) {
var ps = bloc.querySelectorAll('p');
for (var p = 0; p < ps.length; p++) {
var tp = nettoyer(ps[p].textContent);
if (tp.length > intro.length) intro = tp;
}
}
/* En-tete */
var tete = document.createElement('div');
tete.className = 'sn-compte-tete';
var gauche = document.createElement('div');
gauche.className = 'sn-compte-gauche';
var sur = surtitre(pro ? TXT_SURTITRE_PRO : TXT_SURTITRE);
var h = document.createElement('h2');
h.className = 'sn-compte-titre';
h.textContent = nom ? TXT_BONJOUR + ', ' + nom : TXT_SURTITRE;
gauche.appendChild(sur);
gauche.appendChild(h);
tete.appendChild(gauche);
if (intro || sortie) {
var droite = document.createElement('div');
droite.className = 'sn-compte-droite';
if (intro) {
var pi = document.createElement('p');
pi.className = 'sn-compte-intro';
pi.textContent = intro;
droite.appendChild(pi);
}
if (sortie) droite.appendChild(lienSortie(sortie));
tete.appendChild(droite);
}
/* A la place du bloc de texte Oasis (ou au-dessus du menu) */
var ancre = bloc ? (bloc.closest('.column-template') || bloc) : menu;
ancre.parentNode.insertBefore(tete, ancre);
if (bloc) bloc.style.setProperty('display', 'none', 'important');
pret();
return true;
}
/* Le bloc est en bas de page : tout est deja la, on agit tout de suite */
var fait = false;
try { fait = construire(); } catch (e) { pret(); }
if (!fait) {
document.addEventListener('DOMContentLoaded', function () {
try { construire(); } catch (e) {}
pret();
}, { once: true });
}
})();
</script>	</div>
</div>
</div>
</div>
