template-content	">
<div class="column">
<script>(function trierFiltres(){
['filters[2][]','filters[12][]'].forEach(function(n){
var inp = document.querySelector('input[name="'+n+'"]');
if(!inp) return;
var box = inp.closest('.default-group-filters');
[].slice.call(box.children)
.sort(function(a,b){ return a.textContent.trim().localeCompare(b.textContent.trim(),'fr',{sensitivity:'base'}); })
.forEach(function(el){ box.appendChild(el); });
});
console.log('Filtres triés &#10004;');
})();</script>	</div>
