<div
class="html-template row no-margin  id-usr-i3fq"	data-uniqid="1780573872"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Decoupage du H1 en artiste + titre
Remplace la version precedente. Les classes .ca-artiste et .ca-titre
sont mises en forme par la section 16.2 de la feuille de style.
Corrections apportees :
1. Un espace separe desormais les deux spans. Sans lui, le textContent
du H1 - donc la valeur lue par les moteurs via itemprop="name" -
renvoyait "Aubrey vs Georgios DSRShifting Phase" en un seul mot.
2. La coupure exige un espace AVANT le tiret. L'ancienne regex coupait
"Jean-Michel Jarre - Oxygene" en "Jean" + "Michel Jarre - Oxygene".
3. Construction par createElement au lieu d'innerHTML : un titre
contenant & ou < ne casse plus le balisage.
4. Attribut "content" pose sur le H1 : en microdonnees il prime sur le
texte affiche, donc le nom transmis reste correct quoi qu'il arrive
a l'affichage.
5. Marqueur data-decoupe : le script ne peut plus s'executer deux fois
sur le meme titre.
-------------------------------------------------------------------------- */
(function () {
function decouperTitre() {
document.querySelectorAll('h1.fa_designation').forEach(function (el) {
if (el.dataset.decoupe) return;
el.dataset.decoupe = '1';
var texte = el.textContent.replace(/\s+/g, ' ').trim();
if (!texte) return;
/* Valeur transmise aux moteurs, independante de l'affichage */
el.setAttribute('content', texte);
/* Espace obligatoire avant le tiret, facultatif apres :
gere "DSR - Shifting Phase" comme "DSR -Shifting Phase" */
var m = texte.match(/^(.*?)\s+-\s*(.*)$/);
/* Pas de tiret : on laisse le titre intact plutot que
de produire un H1 sans structure */
if (!m || !m[1] || !m[2]) return;
var artiste = document.createElement('span');
artiste.className = 'ca-artiste';
artiste.textContent = m[1];
var titre = document.createElement('span');
titre.className = 'ca-titre';
titre.textContent = m[2];
el.textContent = '';
el.appendChild(artiste);
el.appendChild(document.createTextNode(' '));
el.appendChild(titre);
});
}
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', decouperTitre, { once: true });
} else {
decouperTitre();
}
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-ia64k"	data-uniqid="1789029933"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
(function () {
var SEUIL = 640;
function grilleMobile() {
if (window.innerWidth > SEUIL) return;
if (typeof jQuery === 'undefined') return;
jQuery('.jq-products-list.owl-carousel').each(function () {
var $c = jQuery(this);
if ($c.data('syncro-grille')) return;
$c.data('syncro-grille', 1);
$c.trigger('destroy.owl.carousel');
/* Owl laisse la classe owl-carousel, dont la feuille contient
.owl-carousel:not(.owl-loaded) > :not(:first-child){display:none}
Cette regle masque toutes les cartes sauf la premiere. */
$c.removeClass('owl-carousel owl-theme jq-commerce-owl-carousel');
$c.addClass('syncro-grille-mobile');
$c.children('.owl-prev, .owl-next, .owl-nav, .owl-dots, .owl-stage-outer').remove();
$c.siblings('.owl-prev, .owl-next').remove();
});
}
function lancer() { setTimeout(grilleMobile, 1200); }
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', lancer, { once: true });
} else {
lancer();
}
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-ijzbi"	data-uniqid="1789039889"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<div id="syncro-ancres" class="syncro-ancres"></div>
<script>
(function () {
/* Sections a afficher dans la barre. Fragments en minuscules,
la comparaison est partielle : 'disco' attrape 'Disco / Funk'. */
var GARDER = ['news', 'house label'];
function init() {
var nav = document.getElementById('syncro-ancres');
if (!nav) return;
var titres = document.querySelectorAll('h2.title-component');
if (!titres.length) return;
var html = '';
for (var i = 0; i < titres.length; i++) {
var h2 = titres[i];
/* Le texte du titre seul, sans la baseline injectee en CSS */
var texte = '';
if (h2.childNodes[0] && h2.childNodes[0].nodeType === 3) {
texte = h2.childNodes[0].textContent;
} else {
texte = h2.textContent;
}
texte = texte.replace(/\s+/g, ' ').trim();
if (!texte) continue;
/* On ne garde que les sections listees dans GARDER */
var t = texte.toLowerCase();
var ok = false;
for (var j = 0; j < GARDER.length; j++) {
if (t.indexOf(GARDER[j]) > -1) { ok = true; break; }
}
if (!ok) continue;
/* On pose l'ancre sur le conteneur de section le plus haut */
var cible = h2;
var p = h2.parentElement;
var n = 0;
while (p && n < 4) {
if (p.className && p.className.indexOf('row-template') > -1) cible = p;
p = p.parentElement;
n++;
}
var id = 'sect-' + i;
cible.id = id;
html += '<a href="#' + id + '">' + texte + '</a>';
}
nav.innerHTML = html;
/* On remonte la barre juste avant la premiere section */
var premier = titres[0];
var dest = premier;
var q = premier.parentElement;
var k = 0;
while (q && k < 4) {
if (q.className && q.className.indexOf('row-template') > -1) dest = q;
q = q.parentElement;
k++;
}
if (dest.parentNode) dest.parentNode.insertBefore(nav, dest);
}
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', init, { once: true });
} else {
setTimeout(init, 300);
}
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-i2unk"	data-uniqid="1789048207"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Tracklist
Deux ajouts, aucun remplacement : le onclick d'Oasis (changeTrack) et
les attributs data-url / data-image / data-title ne sont pas touches.
1. Le prefixe de position ("A1.", "B2."...) est enveloppe dans un
<span class="mp3-pos">. La regle monospace de la section 15 de la
feuille de style attend cette classe depuis le debut : elle ne
s'appliquait a rien, faute d'element a cibler.
2. Une classe .piste-en-cours est posee sur la piste cliquee et retiree
des autres, pour pouvoir la distinguer visuellement (section 16.9).
Oasis ne fournit aucun marqueur d'etat.
-------------------------------------------------------------------------- */
(function () {
/* Formats reconnus : A1  B2  AA1  C10 ... suivis d'un point */
var POSITION = /^([A-Z]{1,2}\d{1,2})\.\s*/;
function preparerPistes() {
document.querySelectorAll('.mp3_list .piste-mp3').forEach(function (lien) {
if (lien.dataset.pistePrete) return;
lien.dataset.pistePrete = '1';
/* --- Isole le prefixe de position --- */
var texte = lien.textContent.replace(/\s+/g, ' ').trim();
var m = texte.match(POSITION);
if (m) {
var pos = document.createElement('span');
pos.className = 'mp3-pos';
pos.textContent = m[1];
lien.textContent = '';
lien.appendChild(pos);
lien.appendChild(document.createTextNode(texte.slice(m[0].length)));
}
/* --- Marque la piste en cours ---
En capture, pour passer avant le onclick d'Oasis. */
lien.addEventListener('click', function () {
document.querySelectorAll('.mp3_list .piste-en-cours')
.forEach(function (autre) {
autre.classList.remove('piste-en-cours');
});
lien.classList.add('piste-en-cours');
});
});
}
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', preparerPistes, { once: true });
} else {
preparerPistes();
}
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-i9vz8"	data-uniqid="1789049746"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Tags de genre sous le titre
Version 2 : ancrage corrige.
La v1 inserait les pastilles avec titre.parentNode.insertBefore, en
supposant que le H1 avait le bloc prix pour voisin. Faux : le H1 est
une colonne Foundation dont le parent contient aussi le bloc label et
le widget de partage. Les pastilles se retrouvaient tout en haut,
au-dessus du label.
Cette version s'ancre sur .fa_bloc_prix et insere juste avant lui,
donc sous le sous-titre. Repli sur .fa_reference si le bloc prix est
absent, puis sur le parent du titre en dernier recours.
Reprend les valeurs "Style" et "Format" du tableau Features du bas de
fiche (#tableau_carac). Le tableau n'est pas modifie : les valeurs
sont recopiees, pas deplacees.
Aucun caractere chevron dans le corps du script : Oasis les echappe
dans ses champs HTML, ce qui casse le script silencieusement.
Mise en forme : section 16.14 de la feuille de style.
-------------------------------------------------------------------------- */
(function () {
var CLASSE = 'syncro-tags';
/* Libelles a remonter, dans l'ordre d'affichage souhaite.
Comparaison en minuscules et partielle : "style" attrape "Style".
Pour ajouter le pays, mettre 'country' dans la liste. */
var GARDER = ['style', 'format'];
function valeurs() {
var trouve = [];
var lignes = document.querySelectorAll('#tableau_carac li');
if (!lignes.length) return trouve;
for (var g = 0; g !== GARDER.length; g++) {
for (var i = 0; i !== lignes.length; i++) {
var lab = lignes[i].querySelector('.label_carac');
var val = lignes[i].querySelector('.label_valeur');
if (!lab || !val) continue;
var nom = lab.textContent.replace(/\s+/g, ' ').trim().toLowerCase();
if (nom.indexOf(GARDER[g]) === -1) continue;
var texte = val.textContent.replace(/\s+/g, ' ').trim();
if (!texte) continue;
/* Un champ Style peut contenir plusieurs genres */
var parts = texte.split(/[,\/]/);
for (var p = 0; p !== parts.length; p++) {
var t = parts[p].trim();
if (t && trouve.indexOf(t) === -1) trouve.push(t);
}
}
}
return trouve;
}
function poser() {
var titre = document.querySelector('h1.fa_designation');
if (!titre) return false;
/* Deja pose quelque part dans la fiche */
if (document.querySelector('.' + CLASSE)) return true;
var liste = valeurs();
if (!liste.length) return false;
var boite = document.createElement('div');
boite.className = CLASSE;
for (var i = 0; i !== liste.length; i++) {
var tag = document.createElement('span');
tag.textContent = liste[i];
boite.appendChild(tag);
}
/* Ancrage : juste avant le bloc prix, donc sous le sous-titre */
var ancre = document.querySelector('.fa_bloc_prix') ||
document.querySelector('.fa_reference');
if (ancre && ancre.parentNode) {
boite.className = CLASSE + ' column small-12';
ancre.parentNode.insertBefore(boite, ancre);
} else {
titre.parentNode.appendChild(boite);
}
return true;
}
function init() {
/* Le tableau Features peut etre injecte apres le chargement :
on reessaie pendant 3 secondes avant d'abandonner. */
var essais = 0;
var timer = setInterval(function () {
essais++;
if (poser() || essais === 15) clearInterval(timer);
}, 200);
}
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', init, { once: true });
} else {
init();
}
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-icki1"	data-uniqid="1789050113"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
(function () {
function deplacer() {
var prix = document.querySelector('.fa_bloc_prix');
var stock = document.querySelector('.fa_bloc-variante-stock');
if (!prix || !stock) return false;
if (prix.nextSibling === stock) return true;
prix.parentNode.insertBefore(stock, prix.nextSibling);
return true;
}
function init() {
var n = 0;
var t = setInterval(function () {
n++;
if (deplacer() || n === 15) clearInterval(t);
}, 200);
}
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', init, { once: true });
} else { init(); }
})();
</script>
</parameter>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-i6hmk"	data-uniqid="1789138029"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* SYNCROPHONE - Fiche article (maquette)
Colonne gauche : tracklist sous la pochette, avec compteur et pastilles play.
Colonne droite : bloc favoris a cote du bouton panier, titre Features +
tableau (Label, Format, Country, Released, Style), Release description.
Mobile : la tracklist reste sous la pochette (donc avant les details
de la release), "Same Label" passe en grille 2x2 (classe
.syncro-grille-mobile de la section 17).
Tout le style est en section 23 du fichier CSS.
Regle Oasis : aucune balise HTML dans une chaine, toujours createElement.
Etat dans la console : window.syncroFicheEtat */
(function () {
window.syncroFicheEtat = 'charge, pas encore lance';
function el(tag, cls, txt) {
var e = document.createElement(tag);
if (cls) e.className = cls;
if (txt) e.textContent = txt;
return e;
}
/* Mois raccourcis a 3 lettres : "November/December 2026" -> "Nov/Dec 2026".
Ne touche que les noms de mois anglais complets. */
function abregeMois(txt) {
return txt.replace(/\b(January|February|March|April|May|June|July|August|September|October|November|December)\b/gi,
function (m) { return m.substring(0, 3); });
}
/* "Same Label" en grille 2x2 sur mobile. Le theme initialise Owl au "load" :
on repasse apres lui et on retire jq-commerce-owl-carousel pour qu'il ne
le refasse pas. */
function grilleSameLabel() {
if (!window.matchMedia('(max-width: 640px)').matches) return;
var car = document.querySelector('#div_article_meme_marque .cont_gabarit');
if (!car || car.classList.contains('syncro-grille-mobile')) return;
if (car.querySelector('.owl-stage') && window.jQuery && window.jQuery.fn && window.jQuery.fn.owlCarousel) {
window.jQuery(car).trigger('destroy.owl.carousel');
}
car.classList.remove('owl-carousel', 'owl-theme', 'owl-loaded', 'owl-drag', 'jq-commerce-owl-carousel');
car.classList.add('syncro-grille-mobile');
}
function init() {
try {
if (!document.querySelector('.fiche_article')) { window.syncroFicheEtat = 'hors fiche article'; return; }
if (document.querySelector('.syncro-tracklist-gauche')) { window.syncroFicheEtat = 'deja fait'; return; }
var colImage  = document.querySelector('.fa_bloc-image');
var photo     = document.querySelector('#grande-photo');
var galerie   = document.querySelector('.fa_bloc-galerie');
var tracklist = document.querySelector('.mp3_list');
var marqueEl  = document.querySelector('.fa_marque');
var marqueA   = document.querySelector('.fa_marque a');
var bouton    = document.querySelector('.bloc-ajout-bouton');
var carac     = document.querySelector('#div_article_carac');
var descr     = document.querySelector('#div_description_longue');
var nbPistes  = tracklist ? tracklist.querySelectorAll('.mp3_tracks').length : 0;
/* ---------------- Colonne gauche ----------------
Tracklist placee sous la galerie (ou sous la pochette),
a toutes les largeurs d'ecran. */
if (colImage && photo && tracklist) {
var ancre = (galerie && colImage.contains(galerie)) ? galerie : photo;
var wrap = el('div', 'syncro-tracklist-gauche');
ancre.insertAdjacentElement('afterend', wrap);
wrap.appendChild(tracklist);
var titre = tracklist.querySelector('.mp3_list_title');
if (titre) {
titre.textContent = 'Listen';
titre.appendChild(el('span', 'syncro-tracklist-count',
nbPistes + (nbPistes > 1 ? ' tracks' : ' track') + ' \u00b7 online excerpts'));
}
tracklist.querySelectorAll('a.piste-mp3').forEach(function (a) {
if (!a.querySelector('.syncro-play')) a.insertBefore(el('span', 'syncro-play', '\u25B6\uFE0E'), a.firstChild);
});
}
/* ---------------- Colonne droite ---------------- */
if (!bouton) { window.syncroFicheEtat = 'gauche ok, .bloc-ajout-bouton absent'; return; }
var colDroite = bouton.parentElement;
while (colDroite && !colDroite.classList.contains('column') && colDroite.tagName !== 'BODY') {
colDroite = colDroite.parentElement;
}
if (!colDroite || colDroite.tagName === 'BODY') { window.syncroFicheEtat = 'gauche ok, colonne droite introuvable'; return; }
/* Bloc favoris (trois liens, Oasis affiche le bon) a cote du bouton
panier ; picto partage masque */
var favItem = null;
document.querySelectorAll('.fiche_article .favoris_item').forEach(function (f) {
if (!favItem && !f.closest('.boite_produit1')) favItem = f;
});
var partage = document.querySelector('.fiche_article a.picto-partage');
var widget  = document.querySelector('.fiche_article .fa_marques_widget-share');
if (favItem && !bouton.querySelector('.syncro-fav')) {
var favBox = el('div', 'syncro-fav');
favBox.appendChild(favItem);
bouton.appendChild(favBox);
}
if (partage) partage.classList.add('syncro-cache');
if (widget && !widget.querySelector('.favoris_item') && !widget.querySelector('a:not(.syncro-cache)')) {
widget.classList.add('syncro-cache');
}
/* Titre + tableau features : Label, puis les lignes du bloc Features du theme */
var lignes = [], vu = {};
var ajoute = function (lab, val, node) {
if (!lab || (!val && !node) || vu[lab.toLowerCase()]) return;
vu[lab.toLowerCase()] = true;
lignes.push({ lab: lab, val: val, node: node });
};
if (marqueA) ajoute('Label', '', marqueA.cloneNode(true));
else if (marqueEl) ajoute('Label', marqueEl.textContent.trim());
if (carac) {
carac.querySelectorAll('li').forEach(function (li) {
var l = li.querySelector('.label_carac'), v = li.querySelector('.label_valeur');
if (!l || !v) {
var sp = li.querySelectorAll('span');
if (sp.length >= 2) { l = sp[0]; v = sp[1]; }
}
if (l && v) ajoute(l.textContent.replace(/[:\s]+$/, '').trim(), abregeMois(v.textContent.trim()));
});
}
if (lignes.length) {
var dl = el('dl', 'syncro-features');
lignes.forEach(function (x) {
var r = el('div');
r.appendChild(el('dt', '', x.lab));
var dd = el('dd');
if (x.node) dd.appendChild(x.node); else dd.textContent = x.val;
r.appendChild(dd);
dl.appendChild(r);
});
colDroite.appendChild(el('h2', 'syncro-features-titre', 'Features'));
colDroite.appendChild(dl);
}
/* Description : un seul titre */
if (descr) {
var bloc = el('div', 'syncro-description');
bloc.appendChild(descr);
var titres = bloc.querySelectorAll('h1, h2, h3, .cont-onglet-titre');
if (!titres.length) bloc.insertBefore(el('h2', '', 'Release description'), descr);
else for (var i = 1; i < titres.length; i++) titres[i].classList.add('syncro-cache');
colDroite.appendChild(bloc);
}
/* Anciens conteneurs du bas, vides maintenant ("Same Label" reste) */
document.querySelectorAll('.conteneur-onglet-bas > .cont-onglet').forEach(function (cnt) {
if (cnt.classList.contains('cont-onglet-produits')) return;
if (!cnt.querySelector('#div_description_longue') || cnt.querySelector('#div_article_carac')) {
cnt.classList.add('syncro-cache');
}
});
/* Liens "Release description | Features" sous la reference */
var nav = [];
document.querySelectorAll('a, span, li, div').forEach(function (a) {
if (a.children.length > 2) return;
var t = a.textContent.replace(/\s+/g, ' ').trim();
if (/^\|?\s*(Release description|Features)\s*\|?$/.test(t)
&& !a.closest('.syncro-description') && !a.closest('.conteneur-onglet-bas')
&& !a.closest('.syncro-features') && !a.classList.contains('syncro-features-titre')) nav.push(a);
});
if (nav.length) {
var conteneur = null, cur = nav[0].parentElement, n = 0;
while (cur && n < 5) {
var tc = cur.textContent.replace(/\s+/g, ' ').trim();
if (tc.length < 80 && /Release description/.test(tc) && /Features/.test(tc)) { conteneur = cur; break; }
cur = cur.parentElement; n++;
}
if (conteneur) conteneur.classList.add('syncro-cache');
else nav.forEach(function (a) { a.classList.add('syncro-cache'); });
}
/* "Same Label" : maintenant, puis apres le "load" du theme */
grilleSameLabel();
window.addEventListener('load', function () { setTimeout(grilleSameLabel, 300); });
window.syncroFicheEtat = 'ok';
} catch (err) {
window.syncroFicheEtat = 'erreur : ' + err.message;
}
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-iaoxt"	data-uniqid="1789991935"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Page News : barre de filtres au-dessus de la liste (v12)
Reprend les filtres Oasis de la colonne "Filter by" :
- "News per week" devient une rangee d'onglets
- "Genres" devient une rangee de pastilles
- "Sort by" devient un menu deroulant
Chaque bouton clique la vraie case Oasis : le filtrage reste celui d'Oasis.
Les trois groupes repris sont masques dans la colonne (classe .sn-deplace,
section NEWS du CSS). Labels et Artists restent dans la colonne.
v4 : la barre est mise a jour sur place, et apres un filtre ou un tri la
page reste exactement la ou elle etait au moment du clic (Oasis ne la
fait plus descendre, le menu ne passe pas en mode compact).
La pagination garde le comportement normal d'Oasis.
v5 : fil d'Ariane propre "Home / News", aligne sur le debut du menu du haut.
Le bloc News (colonne + liste) est cale sur la largeur du menu du haut.
Haut de page : point bleu + semaine choisie, nombre de disques, phrase d'intro.
v6 : titre + phrase et onglets des semaines passent au-dessus, sur toute la
largeur ; la colonne Labels / Artists et les pastilles de genres commencent
au meme niveau.
v7 : Labels et Artists sont ouverts par defaut. Un groupe ferme a la main
reste ferme pendant la visite.
v8 : mobile repense. Le gros bouton "SORT & FILTER" d'Oasis est remplace par
un bouton "Filters" discret sur la meme ligne que le tri ; les genres
defilent en dessous, sans barre de defilement visible.
v9 : mobile allege ("Filters" et "Sort by" en texte, sans pilules) et
fenetre de filtres repensee : seulement Labels et Artists (semaines, genres
et tri sont deja sur la page), fermes par defaut, dans la police du site.
v10 : "Sort by" soigne : "Sort by  New" + petite fleche fine, a la largeur
du texte ; le vrai menu (invisible) est pose dessus pour garder la liste
native du telephone.
L'original d'Oasis est masque par le CSS (classe sn-ariane-on sur le body).
v11 : correctif du "saut" de la page. Quand on descend un peu, l'en-tete
passe en mode compact (logo et menu sur une ligne) : le lien "News" du
menu se retrouve ~300px plus a droite. Si l'alignement etait recalcule a
ce moment-la, tout le bloc News partait a droite et y restait apres le
retour en haut. Desormais : aucune mesure tant que l'en-tete est compact,
l'alignement deja pose est garde, et il est refait au retour du grand
en-tete.
-------------------------------------------------------------------------- */
(function () {
/* Pages ou le style News s'applique (debut de l'adresse).
ariane = texte du fil d'Ariane, surtitre = texte du point bleu,
intro = phrase a droite du titre, semaines: false = pas d'onglets de semaines.
Pour ajouter une page : ajouter une ligne. */
var PAGES = {
'/news/': {},
'/back-in-stock/': { ariane: 'Back in stock', semaines: false, surtitre: 'Back in the racks', intro: 'Records we have restocked: the titles you kept asking for, back on the shelves.' },
'/all-stock/': { ariane: 'All Stock', semaines: false, surtitre: 'Full catalogue', intro: 'Every record currently in stock at the shop, all genres and labels together.' },
'/exclusives/': { ariane: 'Exclusives', semaines: false, surtitre: 'Distributed by Syncrophone', intro: 'The labels we distribute, from pressing plant to our racks.' },
'/presales-exclusives/': { ariane: 'Presales Exclusives', semaines: false, surtitre: 'Distributed by Syncrophone', intro: 'Upcoming releases from the labels we distribute, to preorder now.' },
'/genres/': { ariane: '*', semaines: false, surtitre: 'Genres', intro: '' },
'/artists/': { ariane: '*', semaines: false, surtitre: 'Artist', intro: '' },
'/dj-equipment/': { ariane: 'DJ Equipment', surtitre: 'Gear', intro: 'Cartridges, headphones, cleaning kits and storage, picked by the shop.' }
};
/* Pages label (adresse du type /nom-m12345.html), reconnues au module marque d'Oasis */
var PAGES_LABEL = { ariane: '*', semaines: false, surtitre: 'Label', intro: '' };
var PAGE = null;
for (var cle in PAGES) { if (location.pathname.indexOf(cle) === 0) PAGE = PAGES[cle]; }
if (!PAGE && document.querySelector('.brand-commerce-template')) PAGE = PAGES_LABEL;
if (!PAGE) return;
/* Textes affiches (modifiables) */
var TXT_TOUTES_SEMAINES = 'All weeks';
var TXT_TOUS_GENRES = 'All';
var TXT_TRI = 'Sort by';
/* Haut de page : phrase a droite du titre, et texte du point bleu
quand aucune semaine n'est choisie ("All weeks") */
var TXT_INTRO = 'Everything that just landed in the racks: new pressings, reissues and preorders, from Chicago house to French disco.';
var TXT_SURTITRE_TOUTES = 'Latest arrivals';
if (PAGE.intro !== undefined) TXT_INTRO = PAGE.intro;
if (PAGE.surtitre) TXT_SURTITRE_TOUTES = PAGE.surtitre;
/* Phrase d'intro : graisse et style (italic / normal) */
var INTRO_GRAISSE = '400';
var INTRO_STYLE = 'italic';
/* Groupes de la colonne (Labels, Artists) ouverts par defaut : true / false */
var OUVRIR_FILTRES = true;
/* Mobile : texte du bouton qui ouvre les filtres d'Oasis */
var TXT_FILTRES = 'Filters';
/* Mobile : Labels et Artists deplies a l'ouverture de la fenetre : true / false */
var DEPLIER_FENETRE = false;
var barre = null;
var haut = null;
var signature = '';
var minuterie = null;
var positionAGarder = null;
var listeRafraichie = false;
/* v11 : alignement saute pendant que l'en-tete etait compact */
var alignementEnAttente = false;
function nettoyer(t) {
return t.replace(/\s+/g, ' ').trim();
}
/* Les cases d'un groupe Oasis (3 = semaines, 1 = genres) */
function cases(groupe) {
var liste = [];
var inputs = document.querySelectorAll('#filter-group-' + groupe + ' input[type=checkbox]');
for (var i = 0; i < inputs.length; i++) {
var label = document.querySelector('label[for="' + inputs[i].id + '"]');
if (label) liste.push({ input: inputs[i], label: label, texte: nettoyer(label.textContent) });
}
return liste;
}
/* "All" : decoche tout le groupe en ne lancant qu'un seul filtrage Oasis */
function toutDecocher(liste) {
var cochees = [];
for (var i = 0; i < liste.length; i++) {
if (liste[i].input.checked) cochees.push(liste[i]);
}
if (!cochees.length) return;
for (var j = 0; j < cochees.length - 1; j++) cochees[j].input.checked = false;
cochees[cochees.length - 1].label.click();
}
function bouton(texte, actif, action) {
var b = document.createElement('button');
b.type = 'button';
b.textContent = texte;
if (actif) b.className = 'sn-on';
b.setAttribute('aria-pressed', actif ? 'true' : 'false');
b.addEventListener('click', action);
return b;
}
function rangee(classe, liste, texteTout, renommer) {
var div = document.createElement('div');
div.className = classe;
var aucune = true;
for (var i = 0; i < liste.length; i++) {
if (liste[i].input.checked) aucune = false;
}
div.appendChild(bouton(texteTout, aucune, function () { toutDecocher(liste); }));
liste.forEach(function (c) {
div.appendChild(bouton(renommer ? renommer(c.texte) : c.texte, c.input.checked, function () { c.label.click(); }));
});
return div;
}
function numero(t) {
var m = t.match(/(\d+)/);
return m ? parseInt(m[1], 10) : 0;
}
/* "Sort by" : texte + valeur + petite fleche, a la largeur du texte.
Le vrai menu est pose dessus, invisible : un toucher ouvre la liste
native du telephone (ou de l'ordinateur). */
function menuTri() {
var radios = document.querySelectorAll('input[name="filter-sorting-type"]');
if (!radios.length) return null;
var bloc = document.createElement('label');
bloc.className = 'sn-tri';
var libelle = document.createElement('span');
libelle.className = 'sn-tri-libelle';
libelle.textContent = TXT_TRI;
var valeur = document.createElement('span');
valeur.className = 'sn-tri-valeur';
var fleche = document.createElement('span');
fleche.className = 'sn-tri-fleche';
fleche.innerHTML = '<svg width="9" height="6" viewBox="0 0 9 6" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>';
var select = document.createElement('select');
select.setAttribute('aria-label', TXT_TRI);
var vus = {};
for (var i = 0; i < radios.length; i++) {
var r = radios[i];
if (vus[r.value]) continue;
vus[r.value] = 1;
var l = document.querySelector('label[for="' + r.id + '"]');
var o = document.createElement('option');
o.value = r.id;
o.textContent = l ? nettoyer(l.textContent) : r.value;
if (r.checked) o.selected = true;
select.appendChild(o);
}
function majValeur() {
var opt = select.options[select.selectedIndex];
valeur.textContent = opt ? opt.textContent : '';
}
majValeur();
select.addEventListener('change', function () {
majValeur();
var l = document.querySelector('label[for="' + select.value + '"]');
if (l) l.click();
});
/* Finitions */
var encre = '#20211f', bleu = '#253ed8';
styler(bloc, { 'position': 'relative', 'display': 'inline-flex', 'align-items': 'center', 'padding': '6px 0', 'font-size': '13px', 'line-height': '1.2', 'color': '#70716c', 'white-space': 'nowrap', 'cursor': 'pointer' });
styler(valeur, { 'margin-left': '6px', 'color': encre, 'font-weight': '500' });
styler(fleche, { 'display': 'inline-flex', 'margin-left': '6px', 'color': encre, 'transition': 'transform .15s' });
styler(select, { 'position': 'absolute', 'top': '0', 'left': '0', 'width': '100%', 'height': '100%', 'margin': '0', 'padding': '0', 'border': '0', 'opacity': '0', 'font-size': '16px', 'cursor': 'pointer', '-webkit-appearance': 'none', 'appearance': 'none', 'background': 'transparent' });
/* Survol : valeur et fleche en bleu */
bloc.addEventListener('mouseenter', function () { styler(valeur, { 'color': bleu }); styler(fleche, { 'color': bleu }); });
bloc.addEventListener('mouseleave', function () { styler(valeur, { 'color': encre }); styler(fleche, { 'color': encre }); });
/* Clavier : cadre bleu autour du tri quand on y arrive avec Tab */
select.addEventListener('focus', function () {
var clavier = true;
try { clavier = select.matches(':focus-visible'); } catch (e) {}
if (clavier) styler(bloc, { 'outline': '2px solid ' + bleu, 'outline-offset': '4px' });
});
select.addEventListener('blur', function () { retirer(bloc, ['outline', 'outline-offset']); });
bloc.appendChild(libelle);
bloc.appendChild(valeur);
bloc.appendChild(fleche);
bloc.appendChild(select);
return bloc;
}
/* Artiste et titre sur deux lignes (memes classes que le module existant).
Refait apres chaque rechargement de la liste par Oasis. */
function decouper() {
var liens = document.querySelectorAll('.bp_designation a');
for (var i = 0; i < liens.length; i++) {
var lien = liens[i];
if (lien.querySelector('.artiste')) continue;
var texte = nettoyer(lien.textContent);
var pos = texte.indexOf(' - ');
if (pos < 1) continue;
lien.innerHTML = '';
var a = document.createElement('span'); a.className = 'artiste'; a.textContent = texte.slice(0, pos);
var s = document.createElement('span'); s.className = 'separator'; s.textContent = ' - ';
var t = document.createElement('span'); t.className = 'titre'; t.textContent = texte.slice(pos + 3);
lien.appendChild(a); lien.appendChild(s); lien.appendChild(t);
}
}
/* Premier groupe de filtres visible dans la colonne (Labels en general) */
function premiereCarte(module) {
var cartes = module.querySelectorAll('.filters-aside .card-filter-group');
for (var i = 0; i < cartes.length; i++) {
if (cartes[i].getBoundingClientRect().width > 0) return cartes[i];
}
return null;
}
/* Cale le bloc News (colonne "Filter by" + liste) sur le menu du haut :
la colonne commence sous "News" du menu, la liste finit sous le panier.
Mesure faite a l'ecran, refaite si la fenetre change de taille. */
function calerBloc() {
var module = document.querySelector('.sn-module.with-filters-aside');
if (!module) return;
module.style.removeProperty('margin-left');
module.style.removeProperty('width');
module.style.removeProperty('max-width');
var lien = document.querySelector('.Head_menu ul.menu-haut > li > a.boutonHautLien');
var rangee = lien ? lien.closest('.row') : null;
if (!rangee) return;
var r = lien.getBoundingClientRect();
var ref = rangee.getBoundingClientRect();
/* Menu cache (mobile) : on laisse la mise en page d'origine */
if (r.width === 0 || ref.width === 0) return;
for (var passe = 0; passe < 2; passe++) {
/* Repere visible de la colonne : le filet du premier groupe (Labels) */
var colonne = premiereCarte(module);
var fin = (barre && document.body.contains(barre)) ? barre : module.querySelector('.jq-products-container');
if (!colonne || !fin) return;
var g = colonne.getBoundingClientRect().left;
var d = fin.getBoundingClientRect().right;
if (!(d > g) || colonne.getBoundingClientRect().width === 0) return;
var m = module.getBoundingClientRect();
var droiteRef = Math.min(ref.right, document.documentElement.clientWidth);
var largeur = m.width + (droiteRef - r.left) - (d - g);
var decalage = r.left - g;
if (Math.abs(decalage) < 1 && Math.abs(largeur - m.width) < 1) return;
if (Math.abs(decalage) > 500 || largeur < 600) return;
var margeActuelle = parseFloat(module.style.marginLeft) || 0;
module.style.setProperty('max-width', 'none', 'important');
module.style.setProperty('width', Math.round(largeur) + 'px', 'important');
module.style.setProperty('margin-left', Math.round(margeActuelle + decalage) + 'px', 'important');
}
}
/* v11 : l'en-tete du haut est-il en mode compact (colle en haut de l'ecran) ?
Foundation met alors la classe is-stuck sur le bloc colle. */
function enteteCompact() {
var colle = document.querySelector('#large-header [data-sticky]');
return !!(colle && colle.classList.contains('is-stuck'));
}
/* v11 : surveille le passage grand en-tete / en-tete compact.
Au retour du grand en-tete, refait l'alignement s'il avait ete saute. */
function surveillerEntete() {
var colle = document.querySelector('#large-header [data-sticky]');
if (!colle || !window.MutationObserver) return;
new MutationObserver(function () {
if (alignementEnAttente && !enteteCompact()) setTimeout(aligner, 50);
}).observe(colle, { attributes: true, attributeFilter: ['class'] });
}
/* Alignements :
- le bloc News se cale sur le menu du haut
- le fil d'Ariane commence au meme endroit que le menu du haut ("News")
- le titre "News" s'aligne sur la barre, si le theme les decale */
function aligner() {
var module = document.querySelector('.sn-module.with-filters-aside');
styleTete(document.querySelector('.sn-module .boite1-titre.sn-tete'));
styleBarre();
/* v11 : en-tete compact = menu deplace. On ne mesure rien et on garde
l'alignement deja pose ; il sera refait au retour du grand en-tete. */
var compact = enteteCompact();
alignementEnAttente = compact;
if (!compact) calerBloc();
/* "Filter by" n'est plus utile : le titre est au-dessus de tout */
if (module) styler(module.querySelector('.filters-aside .view-selected-filters-title'), { 'display': 'none' });
if (!compact) {
/* Reperes : debut de "News" dans le menu, fin du menu (cote panier) */
var lien = document.querySelector('.Head_menu ul.menu-haut > li > a.boutonHautLien');
var rl = lien ? lien.getBoundingClientRect() : null;
var gauche = null, droite = null;
if (rl && rl.width > 0) {
gauche = rl.left;
droite = Math.min(lien.closest('.row').getBoundingClientRect().right, document.documentElement.clientWidth);
}
/* Fil d'Ariane */
var fil = document.querySelector('.sn-ariane');
if (fil) {
fil.style.marginLeft = '0px';
if (gauche !== null) {
var d = gauche - fil.getBoundingClientRect().left;
if (Math.abs(d) < 400) fil.style.marginLeft = Math.round(d) + 'px';
}
}
/* Titre + phrase, puis onglets des semaines : sur toute la largeur du menu */
var blocTitre = document.querySelector('.sn-module .boite1-titre');
if (blocTitre) {
blocTitre.style.removeProperty('padding-left');
var h2 = blocTitre.querySelector('h2');
if (h2) h2.style.paddingLeft = '0px';
caler(blocTitre, h2, gauche, droite);
}
caler(haut, null, gauche, droite);
}
/* Colonne de gauche et pastilles de genres au meme niveau */
if (module) alignerHauts(module);
styleFenetre();
/* Mobile : 20px entre les onglets des semaines et la ligne Filters / Sort by */
if (window.innerWidth <= 640 && haut && barre && document.body.contains(haut) && document.body.contains(barre)) {
var mt = parseFloat(getComputedStyle(barre).marginTop) || 0;
var ecartM = barre.getBoundingClientRect().top - haut.getBoundingClientRect().bottom;
var voulu = 20;
if (Math.abs(ecartM - voulu) > 1 && Math.abs(ecartM) < 300) barre.style.setProperty('margin-top', Math.round(mt + voulu - ecartM) + 'px', 'important');
}
/* "35 articles" aligne sur la barre */
var compte = (barre && barre.parentNode) ? barre.parentNode.querySelector('.sn-barre + .oasis-pagination .products-count') : null;
if (compte) {
compte.style.removeProperty('margin-left');
var dc = barre.getBoundingClientRect().left - compte.getBoundingClientRect().left;
if (Math.abs(dc) > 0.5 && Math.abs(dc) < 80) compte.style.setProperty('margin-left', Math.round(dc) + 'px', 'important');
}
}
/* Cale un element entre deux reperes horizontaux (repere = ce qui doit
commencer pile a gauche ; par defaut l'element lui-meme) */
function caler(el, repere, gauche, droite) {
if (!el) return;
el.style.removeProperty('margin-left');
el.style.removeProperty('width');
el.style.removeProperty('max-width');
if (gauche === null || droite === null) return;
var r = el.getBoundingClientRect();
var rr = (repere || el).getBoundingClientRect();
if (r.width === 0) return;
var d = gauche - rr.left;
if (Math.abs(d) > 500) return;
var m0 = parseFloat(getComputedStyle(el).marginLeft) || 0;
el.style.setProperty('box-sizing', 'border-box', 'important');
el.style.setProperty('max-width', 'none', 'important');
el.style.setProperty('margin-left', Math.round(m0 + d) + 'px', 'important');
el.style.setProperty('width', Math.round(droite - (r.left + d)) + 'px', 'important');
}
/* Le haut de la colonne (filtres actifs ou filet de "Labels") au meme
niveau que la rangee des pastilles de genres */
function alignerHauts(module) {
var cote = module.querySelector('.filters-aside');
if (!cote || !barre || !document.body.contains(barre)) return;
cote.style.removeProperty('margin-top');
barre.style.setProperty('margin-top', '0px', 'important');
if (cote.getBoundingClientRect().width === 0) return;
var repere = null;
var puces = module.querySelectorAll('.filters-aside .view-select-filter-content');
for (var i = 0; i < puces.length; i++) {
if (puces[i].getBoundingClientRect().height > 0) { repere = puces[i]; break; }
}
if (!repere) repere = premiereCarte(module);
if (!repere) return;
var d = barre.getBoundingClientRect().top - repere.getBoundingClientRect().top;
if (Math.abs(d) < 1 || Math.abs(d) > 400) return;
if (d > 0) {
var mc = parseFloat(getComputedStyle(cote).marginTop) || 0;
cote.style.setProperty('margin-top', Math.round(mc + d) + 'px', 'important');
} else {
barre.style.setProperty('margin-top', Math.round(-d) + 'px', 'important');
}
}
/* Passe le titre et les onglets des semaines au-dessus de la colonne et de
la liste, sous le fil d'Ariane. Refait si Oasis recharge le bloc. */
function placerHaut(module) {
var colonne = module.querySelector('.sidebar-left');
var rangeeListe = colonne ? colonne.parentNode : null;
var conteneur = rangeeListe ? rangeeListe.parentNode : null;
if (!conteneur || !module.contains(conteneur)) return;
var titre = module.querySelector('.template-title');
var rangeeTitre = titre ? titre.parentNode : null;
if (rangeeTitre && rangeeTitre !== rangeeListe && !rangeeTitre.contains(rangeeListe) && rangeeTitre.parentNode !== conteneur) {
conteneur.insertBefore(rangeeTitre, rangeeListe);
}
if (haut && (haut.parentNode !== conteneur || haut.nextSibling !== rangeeListe)) {
conteneur.insertBefore(haut, rangeeListe);
styler(haut, { 'margin': '30px 0 26px 0' });
}
}
/* Fil d'Ariane "Home / News" place en haut de la liste, aligne sur la
colonne de gauche. Le texte vient du code de la page (pas de l'affichage),
l'original d'Oasis est masque par le CSS. */
function ariane(module) {
var existant = document.querySelector('.sn-ariane');
if (existant && document.body.contains(existant)) return;
var conteneur = module.firstElementChild;
if (!conteneur) return;
var accueil = document.querySelector('.fil_ariane_fond a');
var morceaux = document.querySelectorAll('.fil_ariane_fond > .fil_ariane');
var ici = morceaux.length ? nettoyer(morceaux[morceaux.length - 1].textContent) : '';
if (!ici || ici === '>' || ici === '/') ici = 'News';
if (PAGE.ariane === '*') ici = nettoyer(document.title.split(' - ')[0]) || ici;
else if (PAGE.ariane) ici = PAGE.ariane;
var nav = document.createElement('nav');
nav.className = 'sn-ariane';
nav.setAttribute('aria-label', 'Breadcrumb');
var lien = document.createElement('a');
lien.href = accueil ? accueil.href : '/';
lien.textContent = accueil ? (nettoyer(accueil.textContent) || 'Home') : 'Home';
var sep = document.createElement('span');
sep.className = 'sn-sep';
sep.textContent = '/';
var cur = document.createElement('span');
cur.className = 'sn-ici';
cur.setAttribute('aria-current', 'page');
cur.textContent = ici;
nav.appendChild(lien);
nav.appendChild(sep);
nav.appendChild(cur);
/* Pages de genre : fil d'Ariane complet repris d'Oasis (Home / Genres / Electro / Electro-Techno) */
if (PAGE.ariane === '*') {
var liensOasis = document.querySelectorAll('.fil_ariane_fond a');
for (var q = 1; q < liensOasis.length; q++) {
var tx = nettoyer(liensOasis[q].textContent);
if (!tx || tx === ici) continue;
var la = document.createElement('a'); la.href = liensOasis[q].href; la.textContent = tx;
var sp = document.createElement('span'); sp.className = 'sn-sep'; sp.textContent = '/';
nav.insertBefore(la, cur); nav.insertBefore(sp, cur);
}
}
conteneur.insertBefore(nav, conteneur.firstChild);
document.body.classList.add('sn-ariane-on');
aligner();
}
/* N'ecrit que si le texte change (evite de relancer la surveillance) */
function ecrire(el, texte) {
if (el.textContent !== texte) el.textContent = texte;
}
/* Texte du point bleu : la ou les semaines choisies */
function texteSemaine(semaines) {
var choisies = [];
for (var i = 0; i < semaines.length; i++) {
if (semaines[i].input.checked) choisies.push(numero(semaines[i].texte));
}
choisies.sort(function (a, b) { return b - a; });
if (!choisies.length) return TXT_SURTITRE_TOUTES;
if (choisies.length === 1) return 'Week ' + choisies[0] + ' arrivals';
return 'Weeks ' + choisies.join(', ') + ' arrivals';
}
/* Pose des styles directement sur un element, en priorite absolue :
le theme Oasis ne peut pas les ecraser */
function styler(el, regles) {
if (!el) return;
for (var k in regles) {
if (el.style.getPropertyValue(k) !== regles[k]) el.style.setProperty(k, regles[k], 'important');
}
}
/* Mise en forme du haut de page (ordinateur : titre a gauche, phrase a
droite ; mobile : la phrase passe sous le titre) */
function styleTete(bloc) {
if (!bloc) return;
var mobile = window.innerWidth <= 640;
var texte = { 'font-weight': '400', 'letter-spacing': '0', 'text-transform': 'none', 'font-style': 'normal' };
styler(bloc, { 'display': 'grid', 'grid-template-columns': mobile ? '1fr' : '1.4fr 1fr', 'column-gap': '7%', 'align-items': 'end' });
styler(bloc.querySelector('h2'), { 'grid-column-start': '1', 'grid-row-start': '2' });
var sur = bloc.querySelector('.sn-surtitre');
styler(sur, texte);
styler(sur, { 'grid-column-start': '1', 'grid-row-start': '1', 'margin': '0 0 18px 0', 'padding': '0', 'font-size': '12px', 'line-height': '1.4', 'color': '#70716c' });
styler(bloc.querySelector('.sn-semaine'), texte);
styler(bloc.querySelector('.sn-semaine'), { 'font-size': '12px', 'line-height': '1.4', 'color': '#70716c' });
styler(bloc.querySelector('.sn-point'), { 'display': 'inline-block', 'width': '6px', 'height': '6px', 'margin': '0 9px 0 0', 'padding': '0', 'border-radius': '50%', 'background': '#253ed8', 'vertical-align': 'middle', 'position': 'relative', 'top': '-1px' });
var intro = bloc.querySelector('.sn-intro');
/* Police du reste du site (pas celle, grasse, du titre du theme), non grasse, en italique */
styler(intro, { 'font-family': getComputedStyle(document.body).fontFamily, 'font-weight': INTRO_GRAISSE, 'font-style': INTRO_STYLE, 'letter-spacing': '0', 'text-transform': 'none' });
styler(intro, { 'max-width': '440px', 'padding': '0', 'line-height': '1.7', 'color': '#70716c', 'text-align': 'left' });
if (mobile) {
styler(intro, { 'grid-column-start': '1', 'grid-row-start': '3', 'grid-row-end': '4', 'align-self': 'start', 'margin': '16px 0 0 0', 'font-size': '14px' });
} else {
styler(intro, { 'grid-column-start': '2', 'grid-row-start': '1', 'grid-row-end': '3', 'align-self': 'end', 'margin': '0 0 8px 0', 'font-size': '16px' });
}
var nb = bloc.querySelector('.sn-nb');
styler(nb, texte);
styler(nb, { 'position': 'relative', 'top': mobile ? '6px' : '10px', 'margin': '0 0 0 8px', 'vertical-align': 'top', 'font-size': mobile ? '14px' : '18px', 'font-weight': '500', 'line-height': '1', 'color': '#70716c' });
}
/* Haut de page : point bleu + semaine au-dessus du titre, nombre de disques
en petit a cote de "News", phrase d'intro a droite */
function tete(module, semaines) {
/* Pages label : Oasis n'affiche pas de titre, on le cree a partir du nom de la page */
if (!module.querySelector('.boite1-titre')) {
var contenu = module.querySelector('.boite1-contenu');
var rangee = contenu ? contenu.parentNode : null;
if (rangee && rangee.parentNode) {
var cadre = document.createElement('div');
cadre.className = 'row expanded';
cadre.innerHTML = '<div class="column small-12 template-title no-margin no-padding"><div class="row expanded"><div class="column small-12 text-center medium-text-left no-margin boite1-titre"><h2 class="no-margin"></h2></div></div></div>';
cadre.querySelector('h2').textContent = nettoyer(document.title.split(' - ')[0]).toUpperCase();
rangee.parentNode.insertBefore(cadre, rangee);
}
}
var bloc = module.querySelector('.boite1-titre');
var h2 = bloc ? bloc.querySelector('h2') : null;
if (!bloc || !h2) return;
if (!bloc.classList.contains('sn-tete')) bloc.classList.add('sn-tete');
var sur = bloc.querySelector('.sn-surtitre');
if (!sur) {
sur = document.createElement('p');
sur.className = 'sn-surtitre';
var point = document.createElement('span');
point.className = 'sn-point';
var txt = document.createElement('span');
txt.className = 'sn-semaine';
sur.appendChild(point);
sur.appendChild(txt);
bloc.insertBefore(sur, h2);
}
ecrire(sur.querySelector('.sn-semaine'), texteSemaine(semaines));
if (TXT_INTRO && !bloc.querySelector('.sn-intro')) {
var intro = document.createElement('p');
intro.className = 'sn-intro';
intro.textContent = TXT_INTRO;
bloc.appendChild(intro);
}
var total = module.querySelector('.total-products-count');
var n = total ? parseInt(nettoyer(total.textContent), 10) : NaN;
var nb = h2.querySelector('.sn-nb');
if (!isNaN(n)) {
if (!nb) {
/* Retire l'espace invisible apres "News", pour coller le nombre au titre */
var dernier = h2.lastChild;
if (dernier && dernier.nodeType === 3) dernier.nodeValue = dernier.nodeValue.replace(/\s+$/, '');
nb = document.createElement('sup');
nb.className = 'sn-nb';
h2.appendChild(nb);
}
ecrire(nb, String(n));
} else if (nb) {
nb.parentNode.removeChild(nb);
}
styleTete(bloc);
}
/* ---- Mobile : bouton "Filters" et mise en page de la barre ---- */
function retirer(el, proprietes) {
if (!el) return;
for (var i = 0; i < proprietes.length; i++) el.style.removeProperty(proprietes[i]);
}
/* Nombre de labels / artistes coches (les semaines et genres sont dans la barre) */
function nbFiltresColonne() {
var n = 0;
var coches = document.querySelectorAll('#product_filters input[type=checkbox]:checked');
for (var i = 0; i < coches.length; i++) {
var g = coches[i].getAttribute('data-group');
if (g !== '3' && g !== '1') n++;
}
return n;
}
/* Bouton "Filters" : ouvre la fenetre de filtres d'Oasis (clic sur son bouton) */
function boutonFiltres() {
var original = document.querySelector('.filters-button .openFiltersSorting a');
if (!original) return null;
var b = document.createElement('button');
b.type = 'button';
b.className = 'sn-filtres';
var n = nbFiltresColonne();
b.innerHTML = '<svg width="13" height="11" viewBox="0 0 13 11" aria-hidden="true"><path d="M0 2h13M0 9h13" stroke="currentColor" stroke-width="1.3"/><circle cx="4" cy="2" r="1.8" fill="#f9f9f6" stroke="currentColor" stroke-width="1.3"/><circle cx="9" cy="9" r="1.8" fill="#f9f9f6" stroke="currentColor" stroke-width="1.3"/></svg>';
b.appendChild(document.createTextNode(TXT_FILTRES + (n ? ' (' + n + ')' : '')));
b.addEventListener('click', function () {
var o = document.querySelector('.filters-button .openFiltersSorting a');
if (o) o.click();
if (DEPLIER_FENETRE) setTimeout(deplierFenetre, 120);
});
return b;
}
/* Mise en page de la barre et des onglets : ordinateur ou mobile */
function styleBarre() {
var mobile = window.innerWidth <= 640;
var ligne = barre ? barre.querySelector('.sn-ligne') : null;
var bouton = ligne ? ligne.querySelector('.sn-filtres') : null;
var cadre = ligne ? ligne.querySelector('.sn-genres-cadre') : null;
var genres = cadre ? cadre.querySelector('.sn-genres') : null;
var tri = ligne ? ligne.querySelector('.sn-tri') : null;
var select = tri ? tri.querySelector('select') : null;
var onglets = haut ? haut.querySelector('.sn-semaines') : null;
var defil = ['flex-wrap', 'overflow-x', 'overflow-y', 'padding-bottom', 'margin-bottom', '-webkit-overflow-scrolling', 'scrollbar-width'];
/* Le gros bouton d'Oasis est remplace par le notre */
var boutonOasis = document.querySelector('.filters-button .show-for-small-only');
if (bouton && boutonOasis) styler(boutonOasis, { 'display': 'none' });
if (mobile) {
styler(ligne, { 'display': 'flex', 'flex-wrap': 'wrap', 'align-items': 'center', 'justify-content': 'space-between' });
/* Une ligne sobre : "Filters" a gauche, "Sort by" a droite, en texte */
styler(bouton, { 'display': 'flex', 'align-items': 'center', 'order': '1', 'height': '34px', 'margin': '0', 'padding': '0', 'border': '0', 'border-radius': '0', 'background': 'transparent', 'color': '#20211f', 'font-size': '13px', 'line-height': '1.2', 'cursor': 'pointer' });
var icone = bouton ? bouton.querySelector('svg') : null;
styler(icone, { 'margin-right': '8px', 'flex-shrink': '0' });
styler(tri, { 'order': '2', 'margin': '0' });
/* La colonne de gauche (vide sur mobile) ne doit pas laisser de trou */
styler(document.querySelector('.sn-module .sidebar-left'), { 'padding-top': '0', 'padding-bottom': '0', 'margin-top': '0', 'margin-bottom': '0', 'min-height': '0' });
styler(document.querySelector('.sn-module .filters-button'), { 'padding': '0', 'margin': '0' });
/* Genres : une ligne qui defile au doigt, barre de defilement cachee */
styler(cadre, { 'order': '3', 'flex': '0 0 100%', 'width': '100%', 'overflow': 'hidden', 'margin': '16px 0 0 0' });
styler(genres, { 'flex-wrap': 'nowrap', 'overflow-x': 'auto', 'overflow-y': 'hidden', 'padding-bottom': '20px', 'margin-bottom': '-20px', '-webkit-overflow-scrolling': 'touch', 'scrollbar-width': 'none' });
/* Onglets des semaines : meme principe, filets portes par le cadre */
styler(haut, { 'overflow': 'hidden', 'border-top': '1px solid #dedfd8', 'border-bottom': '1px solid #dedfd8' });
styler(onglets, { 'border-top': '0', 'border-bottom': '0', 'flex-wrap': 'nowrap', 'overflow-x': 'auto', 'overflow-y': 'hidden', 'padding-bottom': '20px', 'margin-bottom': '-20px', '-webkit-overflow-scrolling': 'touch', 'scrollbar-width': 'none' });
} else {
retirer(ligne, ['display', 'flex-wrap', 'align-items', 'justify-content']);
var pilProps = ['box-sizing', 'flex', 'height', 'margin', 'border', 'border-radius', 'background', 'font-size', 'line-height', 'align-items', 'padding', 'color', 'overflow'];
styler(tri, { 'order': '2', 'margin': '0 0 8px 0' });
retirer(bouton, ['justify-content', 'align-items', 'order', 'padding', 'color', 'cursor'].concat(pilProps));
styler(bouton, { 'display': 'none' });
retirer(document.querySelector('.sn-module .sidebar-left'), ['padding-top', 'padding-bottom', 'margin-top', 'margin-bottom', 'min-height']);
retirer(document.querySelector('.sn-module .filters-button'), ['padding', 'margin']);
styler(cadre, { 'order': '1', 'flex': '1 1 auto', 'overflow': 'visible', 'margin': '0' });
retirer(cadre, ['width']);
retirer(genres, defil);
retirer(haut, ['overflow', 'border-top', 'border-bottom']);
retirer(onglets, ['border-top', 'border-bottom'].concat(defil));
}
}
/* ---- Fenetre de filtres d'Oasis (mobile) ---- */
/* Police du site dans la fenetre (le theme y met sa police de titre, grasse),
et on n'y garde que Labels et Artists : semaines, genres et tri sont
deja sur la page */
function styleFenetre() {
var fenetre = document.querySelector('.modalSetFiltersSorting');
if (!fenetre) return;
var police = getComputedStyle(document.body).fontFamily;
styler(fenetre, { 'font-family': police });
/* Titre : "Filters", comme le bouton qui ouvre la fenetre */
var titreF = fenetre.querySelector('.modal-title-text');
if (titreF) ecrire(titreF, TXT_FILTRES);
var elements = fenetre.querySelectorAll('.modal-title-text, .card-title, .default-filter, .submit-filters-mobile, .label');
for (var i = 0; i < elements.length; i++) styler(elements[i], { 'font-family': police });
/* Bouton de validation d'Oasis : mis en forme seulement s'il a un texte */
var valider = fenetre.querySelector('.submit-filters-mobile');
if (valider && nettoyer(valider.textContent)) {
styler(valider, { 'display': 'block', 'padding': '15px 20px', 'font-size': '14px', 'font-weight': '400', 'text-transform': 'none', 'letter-spacing': '0', 'text-align': 'center', 'color': '#ffffff', 'background': '#20211f', 'border': '0', 'border-radius': '0' });
}
var inutiles = fenetre.querySelectorAll('.col-filter-group-3, .col-filter-group-1');
for (var j = 0; j < inutiles.length; j++) inutiles[j].classList.add('sn-deplace');
masquer(fenetre.querySelector('.sorting-title'));
}
/* A l'ouverture : Labels et Artists deplies */
function deplierFenetre() {
var titres = document.querySelectorAll('.modalSetFiltersSorting .filter-group-title[data-group]');
for (var i = 0; i < titres.length; i++) {
var carte = titres[i].closest('.card-filter-group');
if (!carte || (carte.parentNode && carte.parentNode.classList.contains('sn-deplace'))) continue;
var contenu = carte.querySelector('.card-section');
if (contenu && contenu.getBoundingClientRect().height === 0) titres[i].click();
}
}
/* ---- Colonne de gauche : groupes ouverts par defaut ---- */
/* Groupes fermes a la main pendant la visite (gardes si la page recharge) */
function groupesFermes() {
try { return JSON.parse(sessionStorage.getItem('sn-fermes') || '[]'); } catch (e) { return []; }
}
function estOuvert(carte) {
var bloc = carte.querySelector('.filter-group-block');
return !!bloc && bloc.getBoundingClientRect().height > 0;
}
/* Ouvre un groupe comme le ferait Oasis : classe, fleche, contenu visible */
function ouvrirCarte(carte) {
carte.classList.add('card-filter-group-open');
var fleche = carte.querySelector('.fa-filter-dropdown');
if (fleche) {
fleche.classList.remove('fa-angle-down');
fleche.classList.add('fa-angle-up');
}
var bloc = carte.querySelector('.filter-group-block');
if (bloc && !estOuvert(carte)) bloc.style.display = '';
if (bloc && !estOuvert(carte)) bloc.style.display = 'block';
}
function ouvrirGroupes(module) {
if (!OUVRIR_FILTRES) return;
var fermes = groupesFermes();
var titres = module.querySelectorAll('.filters-aside .filter-group-title');
for (var i = 0; i < titres.length; i++) {
var carte = titres[i].closest('.card-filter-group');
if (!carte || carte.dataset.snVu) continue;
carte.dataset.snVu = '1';
if (carte.parentNode && carte.parentNode.classList.contains('sn-deplace')) continue;
if (fermes.indexOf(titres[i].getAttribute('data-group')) > -1) continue;
if (!estOuvert(carte)) ouvrirCarte(carte);
}
}
/* Retient les groupes que le visiteur ferme ou rouvre lui-meme */
function suivreGroupes() {
document.addEventListener('click', function (e) {
var titre = e.target.closest ? e.target.closest('.filters-aside .filter-group-title') : null;
if (!titre) return;
var carte = titre.closest('.card-filter-group');
var groupe = titre.getAttribute('data-group');
setTimeout(function () {
var fermes = groupesFermes();
var pos = fermes.indexOf(groupe);
if (!estOuvert(carte) && pos === -1) fermes.push(groupe);
if (estOuvert(carte) && pos > -1) fermes.splice(pos, 1);
try { sessionStorage.setItem('sn-fermes', JSON.stringify(fermes)); } catch (err) {}
}, 600);
});
}
/* Masque dans la colonne un groupe repris dans la barre */
function masquer(element) {
if (!element) return;
var carte = element.closest('.card-filter-group');
if (carte && carte.parentNode) carte.parentNode.classList.add('sn-deplace');
}
function construire() {
var module = document.querySelector('.sn-module.with-filters-aside');
if (!module) return;
ariane(module);
decouper();
var semaines = PAGE.semaines === false ? [] : cases(3);
var genres = cases(1);
tete(module, semaines);
placerHaut(module);
if (!semaines.length && !genres.length && !document.querySelector('.sidebar-left .filter-sorting')) return;
masquer(document.getElementById('filter-group-3'));
masquer(document.getElementById('filter-group-1'));
masquer(document.querySelector('.sidebar-left .filter-sorting'));
ouvrirGroupes(module);
/* Ne reconstruit que si l'etat des filtres a change */
var sig = '';
semaines.concat(genres).forEach(function (c) { sig += c.input.id + (c.input.checked ? '1' : '0'); });
var tri = document.querySelector('input[name="filter-sorting-type"]:checked');
sig += tri ? tri.id : '';
sig += '|' + nbFiltresColonne();
var enPlace = barre && document.body.contains(barre);
var hautEnPlace = haut && document.body.contains(haut);
if (sig === signature && enPlace && hautEnPlace) return;
signature = sig;
/* Deja en place : on change le contenu sans retirer (pas de saut) */
if (enPlace) {
while (barre.firstChild) barre.removeChild(barre.firstChild);
} else {
barre = document.createElement('div');
barre.className = 'sn-barre';
}
if (hautEnPlace) {
while (haut.firstChild) haut.removeChild(haut.firstChild);
} else {
haut = document.createElement('div');
haut.className = 'sn-haut';
}
/* Onglets des semaines : au-dessus, sur toute la largeur */
semaines.sort(function (a, b) { return numero(b.texte) - numero(a.texte); });
if (semaines.length) {
var onglets = rangee('sn-semaines', semaines, TXT_TOUTES_SEMAINES, function (t) {
return 'Week ' + numero(t);
});
styler(onglets, { 'margin-bottom': '0' });
haut.appendChild(onglets);
}
var ligne = document.createElement('div');
ligne.className = 'sn-ligne';
var boutonF = boutonFiltres();
if (boutonF) ligne.appendChild(boutonF);
if (genres.length) {
var cadre = document.createElement('div');
cadre.className = 'sn-genres-cadre';
cadre.appendChild(rangee('sn-genres', genres, TXT_TOUS_GENRES));
ligne.appendChild(cadre);
}
var menu = menuTri();
if (menu) ligne.appendChild(menu);
barre.appendChild(ligne);
if (!enPlace) {
/* Place la barre au-dessus du compteur et des pochettes (meme alignement) */
var zone = module.querySelector('.template-content');
if (zone) {
zone.insertBefore(barre, zone.firstChild);
} else {
var titre = module.querySelector('.template-title');
var ancre = titre ? titre.parentNode : null;
if (ancre && ancre.parentNode) ancre.parentNode.insertBefore(barre, ancre.nextSibling);
else module.insertBefore(barre, module.firstChild);
}
}
placerHaut(module);
aligner();
}
/* ---- Position de la page apres un filtrage ---- */
/* Retient la position de la page au moment du clic sur un filtre
(et la garde aussi si Oasis recharge toute la page) */
function garderPosition() {
positionAGarder = window.pageYOffset;
try { sessionStorage.setItem('sn-position', positionAGarder + '|' + Date.now()); } catch (e) {}
}
function replacer(y) {
if (window.jQuery) window.jQuery('html, body').stop(true);
window.scrollTo(0, y);
}
/* Remet la page a la position retenue, puis une seconde fois au cas ou
Oasis la deplace encore juste apres */
function replacerSiDemande() {
var y = positionAGarder;
if (y === null) {
try {
var v = (sessionStorage.getItem('sn-position') || '').split('|');
if (v.length === 2 && (Date.now() - Number(v[1])) < 15000) y = Number(v[0]);
} catch (e) {}
}
if (y === null || isNaN(y)) return;
positionAGarder = null;
try { sessionStorage.removeItem('sn-position'); } catch (e) {}
replacer(y);
setTimeout(function () { replacer(y); }, 700);
}
/* Une mutation vient-elle d'un rechargement de la liste par Oasis ? */
function estRechargement(m) {
var cible = m.target.nodeType === 1 ? m.target : m.target.parentNode;
if (cible && cible.closest && cible.closest('.jq-products-container')) return true;
for (var i = 0; i < m.addedNodes.length; i++) {
var n = m.addedNodes[i];
if (n.nodeType === 1 && (n.classList.contains('jq-products-container') || n.querySelector('.jq-products-container'))) return true;
}
return false;
}
function plusTard(rechargement) {
if (rechargement) listeRafraichie = true;
clearTimeout(minuterie);
minuterie = setTimeout(function () {
construire();
aligner();
if (listeRafraichie) {
listeRafraichie = false;
replacerSiDemande();
}
}, 150);
}
function init() {
/* Espace B2B : son propre script prend la main */
if (document.body.classList.contains('sn-b2b')) return;
var mod = document.querySelector('.novelty-commerce-template, .category-commerce-template, .brand-commerce-template');
if (mod) mod.classList.add('sn-module');
suivreGroupes();
surveillerEntete();
construire();
/* Si Oasis a recharge toute la page apres un filtre */
replacerSiDemande();
/* Filtres et tri : on retient la position, elle sera remise a l'arrivee
de la nouvelle liste */
document.addEventListener('change', function (e) {
var n = e.target && e.target.name ? e.target.name : '';
if (n.indexOf('filters[') === 0 || n === 'filter-sorting-type') {
garderPosition();
plusTard(false);
}
});
/* Pastilles de filtres actifs et "Clear all" */
document.addEventListener('click', function (e) {
if (e.target.closest && e.target.closest('.remove-all-filters, .view-select-filter-content')) {
garderPosition();
}
});
window.addEventListener('resize', function () {
setTimeout(aligner, 200);
});
if (window.MutationObserver) {
new MutationObserver(function (mutations) {
var utile = false;
var rechargement = false;
for (var i = 0; i < mutations.length; i++) {
if (barre && barre.contains(mutations[i].target)) continue;
if (haut && haut.contains(mutations[i].target)) continue;
utile = true;
if (estRechargement(mutations[i])) rechargement = true;
}
/* Nouvelle liste arrivee : on remet la position tout de suite, avant
meme que l'ecran ne se redessine */
if (rechargement && positionAGarder !== null) replacerSiDemande();
if (utile) plusTard(rechargement);
}).observe(document.body, { childList: true, subtree: true });
}
}
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', function () { setTimeout(init, 0); }, { once: true });
} else {
setTimeout(init, 0);
}
})();
</script>	</div>
</div>
</div>
</div>
<div
class="html-template row no-margin  id-usr-is28k"	data-uniqid="1790068818"
>
<div class="column no-padding small-12
">
<div class="row collapse
template-content	">
<div class="column">
<script>
/* --------------------------------------------------------------------------
SYNCROPHONE - Espace B2B : pages des semaines (/weeks-b2b/),
"All presales" (/presales-exclusives/) et "All stock" (/exclusives/) (v8)
v2 : page All presales ajoutee. Son titre, son point bleu et sa phrase
d'intro se reglent dans PAGES. Pas de tri sur cette page (Oasis n'en
propose pas) : la barre ne montre alors que les genres.
v3 : page All stock ajoutee ("News per week" reste dans la colonne).
All presales et All stock existent aussi en version publique (autre
module, sans les boutons des semaines) : sur ces deux pages, le script
ne s'active que si les boutons des semaines sont presents, donc
seulement pour les comptes B2B. Les visiteurs voient la page d'origine.
v4 : une semaine sans disque disparait des onglets et revient des qu'elle
en contient un (reglages MASQUER_VIDES et MEMOIRE_MINUTES).
v5 : etiquette "Repress" sur les pochettes, a partir du filtre Oasis
"Repress" (groupe 13, Catalogue > Filtres / Attribut). Il suffit de
choisir "Repress" dans l'onglet Filtres de l'article. Le filtre devient
aussi une pastille "Repress" au bout de la rangee des genres.
v6 : l'etiquette Repress passe dans le coin haut droit de la pochette
(bas droit sur telephone), en face de New / Preorder.
v7 : la liste des represses est relue a chaque chargement de page (la
memoire sert seulement a afficher les etiquettes sans attendre). Un
filtre Repress ajoute dans Oasis se voit donc des la page suivante.
v8 : plus de pastille "Repress" (PASTILLE_REPRESS a false). Le filtre
n'apparait nulle part (ni colonne, ni fenetre mobile) : il sert seulement
a poser l'etiquette.
Adapte du script de la page News (v11). Meme dessin, avec ces differences :
- Les semaines ne sont pas un filtre Oasis mais des pages separees. Les gros
boutons "ALL PRESALES / LAST WEEK / ... / ALL STOCK", ecrits dans le texte
de chaque categorie, deviennent une rangee d'onglets fins (de vrais liens).
Les boutons d'origine sont masques.
- Le module Oasis n'a pas de titre (le H1 est cache pour le SEO) : le titre
est cree ici a partir du nom de la categorie ("Week #39" -> "Week 39"),
avec les dates de la semaine calculees automatiquement.
- "Genres" devient une rangee de pastilles, "Sort by" un menu deroulant.
Labels et Artists restent dans la colonne, ouverts par defaut.
- La disponibilite (Preorder / In stock), que le theme cache dans le survol
de la pochette, est affichee sous chaque titre.
- Mobile : "Filters" et "Sort by" sur une ligne, genres et onglets qui
defilent au doigt (comme la page News).
Le script ne s'active que sur les adresses de CHEMINS : il peut donc etre
colle dans un bloc HTML present sur toutes les pages categorie.
Il pose la classe sn-b2b sur le body : le CSS "ESPACE B2B" en depend.
-------------------------------------------------------------------------- */
(function () {
/* Adresses concernees (debut du chemin). Une page ajoutee ici hors de
/weeks-b2b/ doit aussi avoir sa ligne dans PAGES plus bas. */
var CHEMINS = ['/weeks-b2b/', '/presales-exclusives/', '/exclusives/'];
var ici = false;
for (var k = 0; k < CHEMINS.length; k++) {
if (location.pathname.indexOf(CHEMINS[k]) === 0) ici = true;
}
if (!ici) return;
/* Textes affiches (modifiables) */
var TXT_TOUS_GENRES = 'All';
var TXT_TRI = 'Sort by';
var TXT_FILTRES = 'Filters';
/* Champ de recherche d'Oasis dans Labels / Artists : "Search labels"... */
var TXT_RECHERCHE = 'Search';
/* Phrase a droite du titre ('' pour la retirer) */
var TXT_INTRO = 'Releases for trade accounts, week by week: presales and titles already in stock. All prices exclude VAT.';
/* Texte du point bleu quand l'onglet actif n'est ni "This week" ni "Last week" */
var TXT_SURTITRE = 'Presales';
/* Pages hors semaines : titre, texte du point bleu et phrase d'intro,
a la place des reglages ci-dessus (intro : '' pour la retirer).
afficherStock: false = pas de "In stock" sous les disques (tout est en
stock sur la page) : seules les precommandes restent signalees. */
var PAGES = {
'/presales-exclusives/': {
titre: 'All presales',
surtitre: 'Presales exclusives',
intro: 'All weeks in one list: exclusive presales for trade accounts. All prices exclude VAT.'
},
'/exclusives/': {
titre: 'All stock',
surtitre: 'Exclusives',
intro: 'Every exclusive title currently in stock, for trade accounts. All prices exclude VAT.',
afficherStock: false
}
};
var PAGE = null;
for (var cle in PAGES) {
if (location.pathname.indexOf(cle) === 0) PAGE = PAGES[cle];
}
if (PAGE && PAGE.intro !== undefined) TXT_INTRO = PAGE.intro;
/* Dates de la semaine a cote du point bleu : true / false */
var AFFICHER_DATES = true;
var MOIS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
/* Disponibilite sous chaque titre ('' pour ne rien afficher) */
var TXT_PRECO = 'Preorder';
var TXT_STOCK = 'In stock';
/* true : un bouton nomme "WEEK #40" s'affiche "This week" pendant la
semaine 40 et "Last week" la semaine suivante, sans rien renommer */
var LIBELLES_RELATIFS = false;
/* Semaines vides masquees dans les onglets : true / false.
Chaque semaine est lue en arriere-plan (sans etre affichee), une a la fois,
apres le chargement de la page. Le resultat est garde MEMOIRE_MINUTES
minutes : une semaine qui se remplit reapparait au plus tard apres ce
delai (tout de suite si le visiteur arrive sur le site). */
var MASQUER_VIDES = true;
var MEMOIRE_MINUTES = 10;
/* Numero du groupe de filtres Oasis "Genres" */
var GROUPE_GENRES = '1';
/* Numero du groupe de filtres Oasis "Repress" ('' pour tout desactiver).
Les disques qui l'ont recoivent l'etiquette TXT_REPRESS sur la pochette. */
var GROUPE_REPRESS = '13';
var TXT_REPRESS = 'Repress';
/* Le filtre Repress en pastille dans la barre, apres les genres :
true / false. Dans tous les cas il est retire de la colonne. */
var PASTILLE_REPRESS = false;
/* Labels et Artists ouverts par defaut dans la colonne : true / false */
var OUVRIR_FILTRES = true;
/* Mobile : Labels et Artists deplies a l'ouverture de la fenetre */
var DEPLIER_FENETRE = false;
/* Le module liste d'Oasis */
var MODULE = '.category-commerce-template.with-filters-aside';
var barre = null;
var haut = null;
var tete = null;
var onglets = null;
var signature = '';
var minuterie = null;
var positionAGarder = null;
var listeRafraichie = false;
var alignementEnAttente = false;
var defilementFait = false;
function nettoyer(t) {
return t.replace(/\s+/g, ' ').trim();
}
function numero(t) {
var m = t.match(/(\d+)/);
return m ? parseInt(m[1], 10) : 0;
}
/* N'ecrit que si le texte change (evite de relancer la surveillance) */
function ecrire(el, texte) {
if (el && el.textContent !== texte) el.textContent = texte;
}
/* Styles poses directement sur l'element, en priorite absolue */
function styler(el, regles) {
if (!el) return;
for (var p in regles) {
if (el.style.getPropertyValue(p) !== regles[p]) el.style.setProperty(p, regles[p], 'important');
}
}
function retirer(el, proprietes) {
if (!el) return;
for (var i = 0; i < proprietes.length; i++) el.style.removeProperty(proprietes[i]);
}
function trouverModule() {
return document.querySelector(MODULE);
}
/* ---- Semaines et dates ---- */
/* "WEEK #40" -> "Week 40", "LAST WEEK" -> "Last week" */
function renommer(t) {
t = nettoyer(t).toLowerCase();
t = t.charAt(0).toUpperCase() + t.slice(1);
return t.replace(/week\s*#?\s*(\d+)/i, 'Week $1');
}
/* Numero de la semaine en cours (norme ISO : du lundi au dimanche) */
function semaineActuelle() {
var a = new Date();
var jeudi = new Date(a.getFullYear(), a.getMonth(), a.getDate() + 3 - (a.getDay() + 6) % 7);
var j4 = new Date(jeudi.getFullYear(), 0, 4);
return 1 + Math.round(((jeudi - j4) / 86400000 - 3 + (j4.getDay() + 6) % 7) / 7);
}
/* Lundi de la semaine n, dans l'annee la plus proche d'aujourd'hui
(gere le passage d'une annee a l'autre) */
function lundi(n) {
var auj = new Date();
var meilleur = null;
for (var an = auj.getFullYear() - 1; an <= auj.getFullYear() + 1; an++) {
var j4 = new Date(an, 0, 4);
var l = new Date(an, 0, 4 - (j4.getDay() + 6) % 7 + (n - 1) * 7);
if (!meilleur || Math.abs(l - auj) < Math.abs(meilleur - auj)) meilleur = l;
}
return meilleur;
}
/* "21-27 Sep" ou "28 Sep - 4 Oct" */
function dates(n) {
var l = lundi(n);
var d = new Date(l.getFullYear(), l.getMonth(), l.getDate() + 6);
if (l.getMonth() === d.getMonth()) return l.getDate() + '\u2013' + d.getDate() + ' ' + MOIS[d.getMonth()];
return l.getDate() + ' ' + MOIS[l.getMonth()] + ' \u2013 ' + d.getDate() + ' ' + MOIS[d.getMonth()];
}
function relatif(texte) {
var m = /^Week (\d+)$/.exec(texte);
if (!LIBELLES_RELATIFS || !m) return texte;
var ecart = parseInt(m[1], 10) - semaineActuelle();
if (ecart === 0) return 'This week';
if (ecart === -1) return 'Last week';
return texte;
}
/* ---- Onglets des semaines ---- */
/* Les boutons Oasis sont ecrits dans le texte de chaque categorie (leur
identifiant change d'une semaine a l'autre) : on repere la colonne qui
contient un lien vers /weeks-b2b/ et on reprend tous ses boutons. */
function preparerOnglets() {
if (onglets) return;
var liens = document.querySelectorAll('.button-component a[href]');
var colonne = null;
for (var i = 0; i < liens.length; i++) {
if (liens[i].pathname.indexOf('/weeks-b2b/') === 0) {
colonne = liens[i].closest('.column-template') || liens[i].parentNode.parentNode;
break;
}
}
if (!colonne) return;
onglets = [];
var tous = colonne.querySelectorAll('.button-component a[href]');
for (var j = 0; j < tous.length; j++) {
var a = tous[j];
var bc = a.closest('.button-component');
onglets.push({
href: a.href,
texte: relatif(renommer(a.textContent)),
actif: a.pathname === location.pathname || !!(bc && bc.classList.contains('active')),
hors: a.pathname.indexOf('/weeks-b2b/') !== 0
});
}
/* Boutons d'origine masques (tout le bloc s'il ne contient qu'eux) */
var bloc = colonne.closest('.row-template') || colonne;
var intro = colonne.closest('.infos_categorie');
if (intro && nettoyer(intro.textContent) === nettoyer(colonne.textContent)) bloc = intro;
bloc.classList.add('sn-deplace');
}
function construireOnglets() {
if (haut || !onglets) return;
haut = document.createElement('div');
haut.className = 'sn-haut';
var nav = document.createElement('nav');
nav.className = 'sn-semaines';
nav.setAttribute('aria-label', 'Weeks');
onglets.forEach(function (o) {
var a = document.createElement('a');
a.href = o.href;
a.textContent = o.texte;
var classes = [];
if (o.actif) {
classes.push('sn-on');
a.setAttribute('aria-current', 'page');
}
if (o.hors) classes.push('sn-hors');
a.className = classes.join(' ');
nav.appendChild(a);
});
haut.appendChild(nav);
}
/* ---- Semaines vides ---- */
var CLE_MEMOIRE = 'sn-b2b-semaines';
var lectureEnCours = false;
function memoire() {
try { return JSON.parse(localStorage.getItem(CLE_MEMOIRE) || '{}'); } catch (e) { return {}; }
}
function retenir(chemin, n) {
var m = memoire();
m[chemin] = { n: n, t: Date.now() };
try { localStorage.setItem(CLE_MEMOIRE, JSON.stringify(m)); } catch (e) {}
}
/* L'onglet de la page affichee n'est jamais masque */
function afficherOnglet(a, n) {
if (n === 0 && !a.classList.contains('sn-on')) styler(a, { 'display': 'none' });
else retirer(a, ['display']);
}
/* Nombre de disques d'une semaine lue en arriere-plan.
null = lecture pas fiable (session B2B perdue, page inattendue) :
l'onglet reste alors visible. */
function compter(html) {
var d = new DOMParser().parseFromString(html, 'text/html');
if (!d.body || !d.body.classList.contains('client_identifie')) return null;
var liste = d.querySelector(MODULE);
if (!liste) return null;
var total = liste.querySelector('.total-products-count');
if (total) return parseInt(nettoyer(total.textContent), 10) || 0;
return liste.querySelectorAll('.product_box').length;
}
function semainesVides(module) {
if (!MASQUER_VIDES || !haut) return;
/* La semaine affichee, sans filtre coche : son nombre est deja connu */
if (location.pathname.indexOf('/weeks-b2b/') === 0 && !document.querySelector('#product_filters input[type=checkbox]:checked')) {
var total = module.querySelector('.total-products-count');
retenir(location.pathname, total ? (parseInt(nettoyer(total.textContent), 10) || 0) : module.querySelectorAll('.product_box').length);
}
var m = memoire();
var aLire = [];
var liens = haut.querySelectorAll('.sn-semaines a');
for (var i = 0; i < liens.length; i++) {
var a = liens[i];
if (a.classList.contains('sn-hors')) continue;
var connu = m[a.pathname];
if (connu) afficherOnglet(a, connu.n);
if (!connu || Date.now() - connu.t > MEMOIRE_MINUTES * 60000) aLire.push(a);
}
if (!aLire.length || lectureEnCours) return;
lectureEnCours = true;
/* Une page a la fois, un peu apres le chargement : le serveur traite les
demandes d'un meme compte l'une apres l'autre, la navigation passe devant */
function suivante() {
var a = aLire.shift();
if (!a) { lectureEnCours = false; return; }
fetch(a.pathname, { credentials: 'same-origin' })
.then(function (r) { return r.ok ? r.text() : ''; })
.then(function (html) {
var n = html ? compter(html) : null;
if (n !== null) {
retenir(a.pathname, n);
afficherOnglet(a, n);
}
suivante();
})
.catch(function () { suivante(); });
}
setTimeout(suivante, 800);
}
/* Mobile : l'onglet actif est ramene dans l'ecran */
function defilerOnglet() {
if (defilementFait || !haut || window.innerWidth > 640) return;
var nav = haut.querySelector('.sn-semaines');
var on = nav ? nav.querySelector('.sn-on') : null;
if (!on || nav.scrollWidth <= nav.clientWidth) return;
defilementFait = true;
nav.scrollLeft += on.getBoundingClientRect().left - nav.getBoundingClientRect().left - 20;
}
/* ---- Haut de page : point bleu + dates, titre, nombre, phrase ---- */
function nomPage() {
if (PAGE && PAGE.titre) return PAGE.titre;
var h1 = document.querySelector('h1.Head_h1');
return renommer(h1 ? h1.textContent : document.title);
}
function texteSurtitre(nom) {
if (PAGE && PAGE.surtitre) return PAGE.surtitre;
var t = TXT_SURTITRE;
for (var i = 0; onglets && i < onglets.length; i++) {
if (onglets[i].actif && !/\d/.test(onglets[i].texte)) t = onglets[i].texte;
}
var n = numero(nom);
if (AFFICHER_DATES && /^Week \d+$/.test(nom) && n >= 1 && n <= 53) t += ', ' + dates(n);
return t;
}
function construireTete(module) {
if (!tete) {
tete = document.createElement('div');
tete.className = 'sn-tete';
var gauche = document.createElement('div');
gauche.className = 'sn-tete-gauche';
var sur = document.createElement('p');
sur.className = 'sn-surtitre';
sur.innerHTML = '<span class="sn-point"></span><span class="sn-semaine"></span>';
var h2 = document.createElement('h2');
h2.className = 'sn-titre';
h2.innerHTML = '<span class="sn-nom"></span>';
gauche.appendChild(sur);
gauche.appendChild(h2);
tete.appendChild(gauche);
if (TXT_INTRO) {
var intro = document.createElement('p');
intro.className = 'sn-intro';
intro.textContent = TXT_INTRO;
tete.appendChild(intro);
}
}
var nom = nomPage();
ecrire(tete.querySelector('.sn-nom'), nom);
ecrire(tete.querySelector('.sn-semaine'), texteSurtitre(nom));
var total = module.querySelector('.total-products-count');
var n = total ? parseInt(nettoyer(total.textContent), 10) : NaN;
var titre = tete.querySelector('.sn-titre');
var nb = titre.querySelector('.sn-nb');
if (!isNaN(n)) {
if (!nb) {
nb = document.createElement('sup');
nb.className = 'sn-nb';
titre.appendChild(nb);
}
ecrire(nb, String(n));
} else if (nb) {
titre.removeChild(nb);
}
}
/* Titre + onglets au-dessus de la colonne et de la liste, sous le fil
d'Ariane. Refait si Oasis recharge le bloc. */
function placerHaut(module) {
var colonne = module.querySelector('.sidebar-left');
var rangeeListe = colonne ? colonne.parentNode : null;
var conteneur = rangeeListe ? rangeeListe.parentNode : null;
if (!conteneur || !module.contains(conteneur)) return;
var blocs = [];
if (tete) blocs.push(tete);
if (haut) blocs.push(haut);
for (var i = 0; i < blocs.length; i++) {
var suivant = blocs[i + 1] || rangeeListe;
if (blocs[i].parentNode !== conteneur || blocs[i].nextSibling !== suivant) {
for (var j = 0; j < blocs.length; j++) conteneur.insertBefore(blocs[j], rangeeListe);
return;
}
}
}
/* Fil d'Ariane "Home / Weeks B2B / Week 39" (le niveau vide d'Oasis est
saute). L'original est masque par le CSS. */
function ariane(module) {
var existant = document.querySelector('.sn-ariane');
if (existant && document.body.contains(existant)) return;
var conteneur = module.firstElementChild;
var fond = document.querySelector('.fil_ariane_fond');
if (!conteneur || !fond) return;
var niveaux = fond.querySelectorAll('a.fil_ariane, a.ariane-thematique-link, span.ariane-thematique-link, .ariane_produit');
var morceaux = [];
for (var i = 0; i < niveaux.length; i++) {
var t = nettoyer(niveaux[i].textContent);
if (t) morceaux.push({ lien: niveaux[i].tagName === 'A' ? niveaux[i].href : '', texte: t });
}
if (!morceaux.length) return;
var nav = document.createElement('nav');
nav.className = 'sn-ariane';
nav.setAttribute('aria-label', 'Breadcrumb');
morceaux.forEach(function (m, i) {
if (i) {
var sep = document.createElement('span');
sep.className = 'sn-sep';
sep.textContent = '/';
nav.appendChild(sep);
}
var dernier = i === morceaux.length - 1;
var el;
if (m.lien && !dernier) {
el = document.createElement('a');
el.href = m.lien;
} else {
el = document.createElement('span');
el.className = 'sn-ici';
el.setAttribute('aria-current', 'page');
}
el.textContent = dernier ? m.texte.replace(/#\s*(\d+)/, '$1') : m.texte;
nav.appendChild(el);
});
conteneur.insertBefore(nav, conteneur.firstChild);
document.body.classList.add('sn-ariane-on');
aligner();
}
/* ---- Cartes ---- */
/* Artiste et titre sur deux lignes, refait apres chaque rechargement */
function decouper() {
var liens = document.querySelectorAll(MODULE + ' .bp_designation a');
for (var i = 0; i < liens.length; i++) {
var lien = liens[i];
if (lien.querySelector('.artiste')) continue;
var texte = nettoyer(lien.textContent);
var pos = texte.indexOf(' - ');
if (pos < 1) continue;
lien.innerHTML = '';
var a = document.createElement('span'); a.className = 'artiste'; a.textContent = texte.slice(0, pos);
var s = document.createElement('span'); s.className = 'separator'; s.textContent = ' - ';
var t = document.createElement('span'); t.className = 'titre'; t.textContent = texte.slice(pos + 3);
lien.appendChild(a); lien.appendChild(s); lien.appendChild(t);
}
}
/* Disponibilite sous le titre. Oasis la met dans le survol de la pochette
(masque par le theme) : .articleRupture = "Preorder now !",
.articleDispo = "In stock". */
function dispo() {
var cartes = document.querySelectorAll(MODULE + ' .boite_produit1');
for (var i = 0; i < cartes.length; i++) {
var carte = cartes[i];
if (carte.querySelector('.sn-dispo')) continue;
var titre = carte.querySelector('.bp_designation');
if (!titre) continue;
var preco = carte.querySelector('.bp_stock .articleRupture');
var stock = carte.querySelector('.bp_stock .articleDispo');
var montrerStock = !(PAGE && PAGE.afficherStock === false);
var texte = preco ? TXT_PRECO : (stock && montrerStock ? TXT_STOCK : '');
if (!texte) continue;
var p = document.createElement('p');
p.className = 'sn-dispo ' + (preco ? 'sn-dispo-preco' : 'sn-dispo-stock');
p.textContent = texte;
titre.parentNode.insertBefore(p, titre.nextSibling);
}
}
/* ---- Etiquette Repress ---- */
/* Oasis ne met pas les filtres dans le code des cartes. Le script lit donc
la meme page filtree sur "Repress" (adresse ?filtres=...), en
arriere-plan, une fois par chargement de page. La derniere liste lue est
gardee en memoire pour poser les etiquettes tout de suite, puis corrigee
des que la nouvelle lecture arrive. Si la page n'a pas le filtre Repress
(aucun repress dedans), rien n'est lu. */
var CLE_REPRESS = 'sn-b2b-repress';
var repressEnCours = false;
var repressRelu = false;
function memoireRepress() {
try { return JSON.parse(localStorage.getItem(CLE_REPRESS) || '{}'); } catch (e) { return {}; }
}
function retenirRepress(chemin, valeur, liens) {
var m = memoireRepress();
m[chemin] = { v: valeur, liens: liens, t: Date.now() };
try { localStorage.setItem(CLE_REPRESS, JSON.stringify(m)); } catch (e) {}
}
/* Pose ou retire l'etiquette sur chaque carte de la liste */
function etiqueterRepress(module, liens) {
var cartes = module.querySelectorAll('.boite_produit1');
for (var i = 0; i < cartes.length; i++) {
var carte = cartes[i];
var lien = carte.querySelector('.bp_designation a');
if (!lien) continue;
var est = liens.indexOf(lien.pathname) > -1;
var tag = carte.querySelector('.sn-repress');
if (est && !tag) {
/* Posee sur la pochette elle-meme, independante des etiquettes Oasis
(New, Preorder) qui restent a gauche */
tag = document.createElement('span');
tag.className = 'sn-repress';
tag.textContent = TXT_REPRESS;
(carte.querySelector('.bp_image') || carte).appendChild(tag);
} else if (!est && tag) {
tag.parentNode.removeChild(tag);
}
}
}
function repress(module) {
if (!GROUPE_REPRESS) return;
var input = document.querySelector('#filter-group-' + GROUPE_REPRESS + ' input[type=checkbox]');
if (!input) {
etiqueterRepress(module, []);
return;
}
var valeur = input.value;
var connu = memoireRepress()[location.pathname];
if (connu && connu.v === valeur) etiqueterRepress(module, connu.liens);
if (repressRelu || repressEnCours) return;
repressEnCours = true;
repressRelu = true;
var liens = [];
function lirePage(n) {
var url = location.pathname + '?filtres=' + encodeURIComponent(valeur + ';') + (n > 1 ? '&numPage=' + n : '');
fetch(url, { credentials: 'same-origin' })
.then(function (r) { return r.ok ? r.text() : ''; })
.then(function (html) {
var d = html ? new DOMParser().parseFromString(html, 'text/html') : null;
var liste = d ? d.querySelector(MODULE) : null;
if (!liste || !d.body.classList.contains('client_identifie')) {
repressEnCours = false;
return;
}
var titres = liste.querySelectorAll('.boite_produit1 .bp_designation a');
for (var i = 0; i < titres.length; i++) liens.push(titres[i].pathname);
var total = liste.querySelector('.total-products-count');
var nb = total ? (parseInt(nettoyer(total.textContent), 10) || 0) : liens.length;
/* Plus de disques que sur une page : on lit la page suivante */
if (titres.length && liens.length < nb && n < 20) {
lirePage(n + 1);
return;
}
retenirRepress(location.pathname, valeur, liens);
repressEnCours = false;
var mod = trouverModule();
if (mod) etiqueterRepress(mod, liens);
})
.catch(function () { repressEnCours = false; });
}
setTimeout(function () { lirePage(1); }, 300);
}
/* ---- Filtres : genres en pastilles, tri en menu ---- */
/* Les cases d'un groupe Oasis */
function cases(groupe) {
var liste = [];
var inputs = document.querySelectorAll('#filter-group-' + groupe + ' input[type=checkbox]');
for (var i = 0; i < inputs.length; i++) {
var label = document.querySelector('label[for="' + inputs[i].id + '"]');
if (label) liste.push({ input: inputs[i], label: label, texte: nettoyer(label.textContent) });
}
return liste;
}
/* "All" : decoche tout le groupe en ne lancant qu'un seul filtrage Oasis */
function toutDecocher(liste) {
var cochees = [];
for (var i = 0; i < liste.length; i++) {
if (liste[i].input.checked) cochees.push(liste[i]);
}
if (!cochees.length) return;
for (var j = 0; j < cochees.length - 1; j++) cochees[j].input.checked = false;
cochees[cochees.length - 1].label.click();
}
function bouton(texte, actif, action) {
var b = document.createElement('button');
b.type = 'button';
b.textContent = texte;
if (actif) b.className = 'sn-on';
b.setAttribute('aria-pressed', actif ? 'true' : 'false');
b.addEventListener('click', action);
return b;
}
function rangee(classe, liste, texteTout) {
var div = document.createElement('div');
div.className = classe;
var aucune = true;
for (var i = 0; i < liste.length; i++) {
if (liste[i].input.checked) aucune = false;
}
div.appendChild(bouton(texteTout, aucune, function () { toutDecocher(liste); }));
liste.forEach(function (c) {
div.appendChild(bouton(c.texte, c.input.checked, function () { c.label.click(); }));
});
return div;
}
/* "Sort by  New" + petite fleche, a la largeur du texte. Le vrai menu est
pose dessus, invisible : un toucher ouvre la liste native. Les couleurs
sont dans le CSS (dark mode). */
function menuTri() {
var radios = document.querySelectorAll('input[name="filter-sorting-type"]');
if (!radios.length) return null;
var bloc = document.createElement('label');
bloc.className = 'sn-tri';
var libelle = document.createElement('span');
libelle.className = 'sn-tri-libelle';
libelle.textContent = TXT_TRI;
var valeur = document.createElement('span');
valeur.className = 'sn-tri-valeur';
var fleche = document.createElement('span');
fleche.className = 'sn-tri-fleche';
fleche.innerHTML = '<svg width="9" height="6" viewBox="0 0 9 6" aria-hidden="true"><path d="M1 1l3.5 3.5L8 1" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>';
var select = document.createElement('select');
select.setAttribute('aria-label', TXT_TRI);
var vus = {};
for (var i = 0; i < radios.length; i++) {
var r = radios[i];
if (vus[r.value]) continue;
vus[r.value] = 1;
var l = document.querySelector('label[for="' + r.id + '"]');
var o = document.createElement('option');
o.value = r.id;
o.textContent = l ? nettoyer(l.textContent) : r.value;
if (r.checked) o.selected = true;
select.appendChild(o);
}
function majValeur() {
var opt = select.options[select.selectedIndex];
valeur.textContent = opt ? opt.textContent : '';
}
majValeur();
select.addEventListener('change', function () {
majValeur();
var lab = document.querySelector('label[for="' + select.value + '"]');
if (lab) lab.click();
});
styler(bloc, { 'position': 'relative', 'display': 'inline-flex', 'align-items': 'center', 'padding': '6px 0', 'font-size': '13px', 'line-height': '1.2', 'white-space': 'nowrap', 'cursor': 'pointer' });
styler(valeur, { 'margin-left': '6px', 'font-weight': '500' });
styler(fleche, { 'display': 'inline-flex', 'margin-left': '6px' });
styler(select, { 'position': 'absolute', 'top': '0', 'left': '0', 'width': '100%', 'height': '100%', 'margin': '0', 'padding': '0', 'border': '0', 'opacity': '0', 'font-size': '16px', 'cursor': 'pointer', '-webkit-appearance': 'none', 'appearance': 'none', 'background': 'transparent' });
/* Clavier : cadre bleu autour du tri quand on y arrive avec Tab */
select.addEventListener('focus', function () {
var clavier = true;
try { clavier = select.matches(':focus-visible'); } catch (e) {}
if (clavier) styler(bloc, { 'outline': '2px solid #253ed8', 'outline-offset': '4px' });
});
select.addEventListener('blur', function () { retirer(bloc, ['outline', 'outline-offset']); });
bloc.appendChild(libelle);
bloc.appendChild(valeur);
bloc.appendChild(fleche);
bloc.appendChild(select);
return bloc;
}
/* Nombre de labels / artistes coches (les genres sont dans la barre) */
function nbFiltresColonne() {
var n = 0;
var coches = document.querySelectorAll('#product_filters input[type=checkbox]:checked');
for (var i = 0; i < coches.length; i++) {
var g = coches[i].getAttribute('data-group');
if (g !== GROUPE_GENRES && g !== GROUPE_REPRESS) n++;
}
return n;
}
/* Mobile : bouton "Filters", ouvre la fenetre de filtres d'Oasis */
function boutonFiltres() {
var original = document.querySelector('.filters-button .openFiltersSorting a');
if (!original) return null;
var b = document.createElement('button');
b.type = 'button';
b.className = 'sn-filtres';
var n = nbFiltresColonne();
b.innerHTML = '<svg width="13" height="11" viewBox="0 0 13 11" aria-hidden="true"><path d="M0 2h13M0 9h13" stroke="currentColor" stroke-width="1.3"/><circle cx="4" cy="2" r="1.8" fill="#f9f9f6" stroke="currentColor" stroke-width="1.3"/><circle cx="9" cy="9" r="1.8" fill="#f9f9f6" stroke="currentColor" stroke-width="1.3"/></svg>';
b.appendChild(document.createTextNode(TXT_FILTRES + (n ? ' (' + n + ')' : '')));
b.addEventListener('click', function () {
var o = document.querySelector('.filters-button .openFiltersSorting a');
if (o) o.click();
if (DEPLIER_FENETRE) setTimeout(deplierFenetre, 120);
});
return b;
}
/* Mise en page de la barre et des onglets : ordinateur ou mobile */
function styleBarre() {
var mobile = window.innerWidth <= 640;
var ligne = barre ? barre.querySelector('.sn-ligne') : null;
var boutonF = ligne ? ligne.querySelector('.sn-filtres') : null;
var cadre = ligne ? ligne.querySelector('.sn-genres-cadre') : null;
var genres = cadre ? cadre.querySelector('.sn-genres') : null;
var tri = ligne ? ligne.querySelector('.sn-tri') : null;
var nav = haut ? haut.querySelector('.sn-semaines') : null;
var defil = ['flex-wrap', 'overflow-x', 'overflow-y', 'padding-bottom', 'margin-bottom', '-webkit-overflow-scrolling', 'scrollbar-width'];
var boutonOasis = document.querySelector(MODULE + ' .filters-button .show-for-small-only');
if (boutonF && boutonOasis) styler(boutonOasis, { 'display': 'none' });
if (mobile) {
styler(ligne, { 'display': 'flex', 'flex-wrap': 'wrap', 'align-items': 'center', 'justify-content': 'space-between' });
styler(boutonF, { 'display': 'flex', 'align-items': 'center', 'order': '1', 'height': '34px', 'margin': '0', 'padding': '0', 'border': '0', 'border-radius': '0', 'background': 'transparent', 'font-size': '13px', 'line-height': '1.2', 'cursor': 'pointer' });
styler(boutonF ? boutonF.querySelector('svg') : null, { 'margin-right': '8px', 'flex-shrink': '0' });
styler(tri, { 'order': '2', 'margin': '0' });
styler(document.querySelector(MODULE + ' .sidebar-left'), { 'padding-top': '0', 'padding-bottom': '0', 'margin-top': '0', 'margin-bottom': '0', 'min-height': '0' });
styler(document.querySelector(MODULE + ' .filters-button'), { 'padding': '0', 'margin': '0' });
styler(cadre, { 'order': '3', 'flex': '0 0 100%', 'width': '100%', 'overflow': 'hidden', 'margin': '16px 0 0 0' });
styler(genres, { 'flex-wrap': 'nowrap', 'overflow-x': 'auto', 'overflow-y': 'hidden', 'padding-bottom': '20px', 'margin-bottom': '-20px', '-webkit-overflow-scrolling': 'touch', 'scrollbar-width': 'none' });
styler(haut, { 'overflow': 'hidden', 'border-top': '1px solid #dedfd8', 'border-bottom': '1px solid #dedfd8' });
styler(nav, { 'border-top': '0', 'border-bottom': '0', 'flex-wrap': 'nowrap', 'overflow-x': 'auto', 'overflow-y': 'hidden', 'padding-bottom': '20px', 'margin-bottom': '-20px', '-webkit-overflow-scrolling': 'touch', 'scrollbar-width': 'none' });
} else {
retirer(ligne, ['display', 'flex-wrap', 'align-items', 'justify-content']);
styler(tri, { 'order': '2', 'margin': '0 0 8px 0' });
retirer(boutonF, ['align-items', 'order', 'height', 'margin', 'padding', 'border', 'border-radius', 'background', 'font-size', 'line-height', 'cursor']);
styler(boutonF, { 'display': 'none' });
retirer(document.querySelector(MODULE + ' .sidebar-left'), ['padding-top', 'padding-bottom', 'margin-top', 'margin-bottom', 'min-height']);
retirer(document.querySelector(MODULE + ' .filters-button'), ['padding', 'margin']);
styler(cadre, { 'order': '1', 'flex': '1 1 auto', 'overflow': 'visible', 'margin': '0' });
retirer(cadre, ['width']);
retirer(genres, defil);
retirer(haut, ['overflow', 'border-top', 'border-bottom']);
retirer(nav, ['border-top', 'border-bottom'].concat(defil));
}
}
/* ---- Fenetre de filtres d'Oasis (mobile) ---- */
/* Police du site, titre "Filters", et seulement Labels et Artists
(genres et tri sont deja sur la page) */
function styleFenetre() {
var fenetre = document.querySelector('.modalSetFiltersSorting');
if (!fenetre) return;
var police = getComputedStyle(document.body).fontFamily;
styler(fenetre, { 'font-family': police });
var titreF = fenetre.querySelector('.modal-title-text');
if (titreF) ecrire(titreF, TXT_FILTRES);
var elements = fenetre.querySelectorAll('.modal-title-text, .card-title, .default-filter, .submit-filters-mobile, .label');
for (var i = 0; i < elements.length; i++) styler(elements[i], { 'font-family': police });
var valider = fenetre.querySelector('.submit-filters-mobile');
if (valider && nettoyer(valider.textContent)) {
styler(valider, { 'display': 'block', 'padding': '15px 20px', 'font-size': '14px', 'font-weight': '400', 'text-transform': 'none', 'letter-spacing': '0', 'text-align': 'center', 'color': '#ffffff', 'background': '#20211f', 'border': '0', 'border-radius': '0' });
}
var inutiles = fenetre.querySelectorAll('.col-filter-group-' + GROUPE_GENRES + (GROUPE_REPRESS ? ', .col-filter-group-' + GROUPE_REPRESS : ''));
for (var j = 0; j < inutiles.length; j++) inutiles[j].classList.add('sn-deplace');
masquer(fenetre.querySelector('.sorting-title'));
}
function deplierFenetre() {
var titres = document.querySelectorAll('.modalSetFiltersSorting .filter-group-title[data-group]');
for (var i = 0; i < titres.length; i++) {
var carte = titres[i].closest('.card-filter-group');
if (!carte || (carte.parentNode && carte.parentNode.classList.contains('sn-deplace'))) continue;
var contenu = carte.querySelector('.card-section');
if (contenu && contenu.getBoundingClientRect().height === 0) titres[i].click();
}
}
/* ---- Colonne de gauche : Labels et Artists ouverts par defaut ---- */
function groupesFermes() {
try { return JSON.parse(sessionStorage.getItem('sn-b2b-fermes') || '[]'); } catch (e) { return []; }
}
function estOuvert(carte) {
var bloc = carte.querySelector('.filter-group-block');
return !!bloc && bloc.getBoundingClientRect().height > 0;
}
function ouvrirCarte(carte) {
carte.classList.add('card-filter-group-open');
var fleche = carte.querySelector('.fa-filter-dropdown');
if (fleche) {
fleche.classList.remove('fa-angle-down');
fleche.classList.add('fa-angle-up');
}
var bloc = carte.querySelector('.filter-group-block');
if (bloc && !estOuvert(carte)) bloc.style.display = '';
if (bloc && !estOuvert(carte)) bloc.style.display = 'block';
}
function ouvrirGroupes(module) {
if (!OUVRIR_FILTRES) return;
var fermes = groupesFermes();
var titres = module.querySelectorAll('.filters-aside .filter-group-title');
for (var i = 0; i < titres.length; i++) {
var carte = titres[i].closest('.card-filter-group');
if (!carte || carte.dataset.snVu) continue;
carte.dataset.snVu = '1';
if (carte.parentNode && carte.parentNode.classList.contains('sn-deplace')) continue;
if (fermes.indexOf(titres[i].getAttribute('data-group')) > -1) continue;
if (!estOuvert(carte)) ouvrirCarte(carte);
}
}
/* Retient les groupes que le visiteur ferme ou rouvre lui-meme */
function suivreGroupes() {
document.addEventListener('click', function (e) {
var titre = e.target.closest ? e.target.closest('.filters-aside .filter-group-title') : null;
if (!titre) return;
var carte = titre.closest('.card-filter-group');
var groupe = titre.getAttribute('data-group');
setTimeout(function () {
var fermes = groupesFermes();
var pos = fermes.indexOf(groupe);
if (!estOuvert(carte) && pos === -1) fermes.push(groupe);
if (estOuvert(carte) && pos > -1) fermes.splice(pos, 1);
try { sessionStorage.setItem('sn-b2b-fermes', JSON.stringify(fermes)); } catch (err) {}
}, 600);
});
}
/* Longues listes (All stock) : Oasis ajoute un champ de recherche dont le
texte d'invite est en francais ("Rechercher"). Remplace par "Search labels",
"Search artists" (colonne et fenetre mobile). */
function champsRecherche() {
var champs = document.querySelectorAll('.filters_group_search_input');
for (var i = 0; i < champs.length; i++) {
var carte = champs[i].closest('.card-filter-group');
var titre = carte ? carte.querySelector('.card-title') : null;
var texte = TXT_RECHERCHE + (titre ? ' ' + nettoyer(titre.textContent).toLowerCase() : '');
if (champs[i].placeholder !== texte) champs[i].placeholder = texte;
}
}
/* Filet sous le dernier groupe visible de la colonne. Le CSS le pose sur
le dernier groupe d'Oasis, qui peut etre Repress (masque) : on le reporte
sur le dernier groupe affiche, dans la couleur des autres filets. */
function filetDuBas(module) {
var cartes = module.querySelectorAll('.filters-aside .card-filter-group');
var derniere = null;
for (var i = 0; i < cartes.length; i++) {
if (cartes[i].getBoundingClientRect().height > 0) derniere = cartes[i];
}
for (var j = 0; j < cartes.length; j++) {
if (cartes[j] !== derniere) retirer(cartes[j], ['border-bottom']);
}
if (derniere) styler(derniere, { 'border-bottom': '1px solid ' + getComputedStyle(derniere).borderTopColor });
}
/* Masque dans la colonne un groupe repris dans la barre */
function masquer(element) {
if (!element) return;
var carte = element.closest('.card-filter-group');
if (carte && carte.parentNode) carte.parentNode.classList.add('sn-deplace');
}
/* ---- Alignements (repris de News v11) ---- */
/* Premier lien visible du menu du haut (le menu B2B n'en a qu'un) */
function lienMenu() {
var liens = document.querySelectorAll('.Head_menu ul.menu-haut > li > a.boutonHautLien');
for (var i = 0; i < liens.length; i++) {
if (liens[i].getBoundingClientRect().width > 0) return liens[i];
}
return null;
}
function premiereCarte(module) {
var cartes = module.querySelectorAll('.filters-aside .card-filter-group');
for (var i = 0; i < cartes.length; i++) {
if (cartes[i].getBoundingClientRect().width > 0) return cartes[i];
}
return null;
}
/* Cale le bloc (colonne + liste) sur le menu du haut */
function calerBloc() {
var module = trouverModule();
if (!module) return;
module.style.removeProperty('margin-left');
module.style.removeProperty('width');
module.style.removeProperty('max-width');
var lien = lienMenu();
var rangeeMenu = lien ? lien.closest('.row') : null;
if (!rangeeMenu) return;
var r = lien.getBoundingClientRect();
var ref = rangeeMenu.getBoundingClientRect();
if (r.width === 0 || ref.width === 0) return;
for (var passe = 0; passe < 2; passe++) {
var colonne = premiereCarte(module);
var fin = (barre && document.body.contains(barre)) ? barre : module.querySelector('.jq-products-container');
if (!colonne || !fin) return;
var g = colonne.getBoundingClientRect().left;
var d = fin.getBoundingClientRect().right;
if (!(d > g) || colonne.getBoundingClientRect().width === 0) return;
var m = module.getBoundingClientRect();
var droiteRef = Math.min(ref.right, document.documentElement.clientWidth);
var largeur = m.width + (droiteRef - r.left) - (d - g);
var decalage = r.left - g;
if (Math.abs(decalage) < 1 && Math.abs(largeur - m.width) < 1) return;
if (Math.abs(decalage) > 500 || largeur < 600) return;
var margeActuelle = parseFloat(module.style.marginLeft) || 0;
module.style.setProperty('max-width', 'none', 'important');
module.style.setProperty('width', Math.round(largeur) + 'px', 'important');
module.style.setProperty('margin-left', Math.round(margeActuelle + decalage) + 'px', 'important');
}
}
/* En-tete compact (colle en haut) : le menu est deplace, on ne mesure rien */
function enteteCompact() {
var colle = document.querySelector('#large-header [data-sticky]');
return !!(colle && colle.classList.contains('is-stuck'));
}
function surveillerEntete() {
var colle = document.querySelector('#large-header [data-sticky]');
if (!colle || !window.MutationObserver) return;
new MutationObserver(function () {
if (alignementEnAttente && !enteteCompact()) setTimeout(aligner, 50);
}).observe(colle, { attributes: true, attributeFilter: ['class'] });
}
/* Cale un element entre deux reperes horizontaux */
function caler(el, repere, gauche, droite) {
if (!el) return;
el.style.removeProperty('margin-left');
el.style.removeProperty('width');
el.style.removeProperty('max-width');
if (gauche === null || droite === null) return;
var r = el.getBoundingClientRect();
var rr = (repere || el).getBoundingClientRect();
if (r.width === 0) return;
var d = gauche - rr.left;
if (Math.abs(d) > 500) return;
var m0 = parseFloat(getComputedStyle(el).marginLeft) || 0;
el.style.setProperty('box-sizing', 'border-box', 'important');
el.style.setProperty('max-width', 'none', 'important');
el.style.setProperty('margin-left', Math.round(m0 + d) + 'px', 'important');
el.style.setProperty('width', Math.round(droite - (r.left + d)) + 'px', 'important');
}
/* Haut de la colonne au niveau de la rangee des pastilles de genres */
function alignerHauts(module) {
var cote = module.querySelector('.filters-aside');
if (!cote || !barre || !document.body.contains(barre)) return;
cote.style.removeProperty('margin-top');
barre.style.setProperty('margin-top', '0px', 'important');
if (cote.getBoundingClientRect().width === 0) return;
var repere = null;
var puces = module.querySelectorAll('.filters-aside .view-select-filter-content');
for (var i = 0; i < puces.length; i++) {
if (puces[i].getBoundingClientRect().height > 0) { repere = puces[i]; break; }
}
if (!repere) repere = premiereCarte(module);
if (!repere) return;
var d = barre.getBoundingClientRect().top - repere.getBoundingClientRect().top;
if (Math.abs(d) < 1 || Math.abs(d) > 400) return;
if (d > 0) {
var mc = parseFloat(getComputedStyle(cote).marginTop) || 0;
cote.style.setProperty('margin-top', Math.round(mc + d) + 'px', 'important');
} else {
barre.style.setProperty('margin-top', Math.round(-d) + 'px', 'important');
}
}
function aligner() {
var module = trouverModule();
styleBarre();
var compact = enteteCompact();
alignementEnAttente = compact;
if (!compact) calerBloc();
/* "Filter by" n'est plus utile : le titre est au-dessus de tout */
if (module) styler(module.querySelector('.filters-aside .view-selected-filters-title'), { 'display': 'none' });
if (!compact) {
var lien = lienMenu();
var rl = lien ? lien.getBoundingClientRect() : null;
var gauche = null, droite = null;
if (rl && rl.width > 0) {
gauche = rl.left;
droite = Math.min(lien.closest('.row').getBoundingClientRect().right, document.documentElement.clientWidth);
}
var fil = document.querySelector('.sn-ariane');
if (fil) {
fil.style.marginLeft = '0px';
if (gauche !== null) {
var d = gauche - fil.getBoundingClientRect().left;
if (Math.abs(d) < 400) fil.style.marginLeft = Math.round(d) + 'px';
}
}
caler(tete, null, gauche, droite);
caler(haut, null, gauche, droite);
}
if (module) alignerHauts(module);
styleFenetre();
/* Mobile : 20px entre les onglets et la ligne Filters / Sort by */
if (window.innerWidth <= 640 && haut && barre && document.body.contains(haut) && document.body.contains(barre)) {
var mt = parseFloat(getComputedStyle(barre).marginTop) || 0;
var ecart = barre.getBoundingClientRect().top - haut.getBoundingClientRect().bottom;
if (Math.abs(ecart - 20) > 1 && Math.abs(ecart) < 300) barre.style.setProperty('margin-top', Math.round(mt + 20 - ecart) + 'px', 'important');
}
/* "6 articles" aligne sur la barre */
var compte = (barre && barre.parentNode) ? barre.parentNode.querySelector('.sn-barre + .oasis-pagination .products-count') : null;
if (compte) {
compte.style.removeProperty('margin-left');
var dc = barre.getBoundingClientRect().left - compte.getBoundingClientRect().left;
if (Math.abs(dc) > 0.5 && Math.abs(dc) < 80) compte.style.setProperty('margin-left', Math.round(dc) + 'px', 'important');
}
defilerOnglet();
}
/* ---- Construction ---- */
function construire() {
var module = trouverModule();
if (!module) return;
/* Le module Oasis et sa colonne ont un fond #fafafa : on garde le fond
papier de la page (#f9f9f6), sinon un aplat se voit derriere la liste */
styler(module, { 'background': 'transparent' });
styler(module.parentNode, { 'background': 'transparent' });
ariane(module);
decouper();
dispo();
/* Titre du module Oasis (affiche seulement sans connexion) : remplace */
var titreOasis = module.querySelector('.template-title');
if (titreOasis && !titreOasis.classList.contains('sn-deplace')) titreOasis.classList.add('sn-deplace');
preparerOnglets();
construireOnglets();
construireTete(module);
placerHaut(module);
semainesVides(module);
var genres = cases(GROUPE_GENRES);
masquer(document.getElementById('filter-group-' + GROUPE_GENRES));
var casesRepress = (GROUPE_REPRESS && PASTILLE_REPRESS) ? cases(GROUPE_REPRESS) : [];
/* Le groupe Repress sert a l'etiquette : jamais dans la colonne */
if (GROUPE_REPRESS) masquer(document.getElementById('filter-group-' + GROUPE_REPRESS));
repress(module);
masquer(module.querySelector('.sidebar-left .filter-sorting'));
ouvrirGroupes(module);
champsRecherche();
filetDuBas(module);
/* Ne reconstruit la barre que si l'etat des filtres a change */
var sig = '';
genres.concat(casesRepress).forEach(function (c) { sig += c.input.id + (c.input.checked ? '1' : '0'); });
var tri = document.querySelector('input[name="filter-sorting-type"]:checked');
sig += tri ? tri.id : '';
sig += '|' + nbFiltresColonne();
var enPlace = barre && document.body.contains(barre);
if (sig === signature && enPlace) return;
signature = sig;
if (enPlace) {
while (barre.firstChild) barre.removeChild(barre.firstChild);
} else {
barre = document.createElement('div');
barre.className = 'sn-barre';
}
var ligne = document.createElement('div');
ligne.className = 'sn-ligne';
var boutonF = boutonFiltres();
if (boutonF) ligne.appendChild(boutonF);
if (genres.length || casesRepress.length) {
var cadre = document.createElement('div');
cadre.className = 'sn-genres-cadre';
var pastilles = genres.length ? rangee('sn-genres', genres, TXT_TOUS_GENRES) : document.createElement('div');
pastilles.className = 'sn-genres';
/* Pastille Repress, apres les genres : filtre independant */
casesRepress.forEach(function (c) {
var b = bouton(TXT_REPRESS, c.input.checked, function () { c.label.click(); });
b.classList.add('sn-pastille-repress');
pastilles.appendChild(b);
});
cadre.appendChild(pastilles);
ligne.appendChild(cadre);
}
var menu = menuTri();
if (menu) ligne.appendChild(menu);
barre.appendChild(ligne);
if (!enPlace) {
/* Au-dessus du compteur et des pochettes */
var zone = module.querySelector('.template-content');
var liste = module.querySelector('.jq-products-container');
if (zone) zone.insertBefore(barre, zone.firstChild);
else if (liste && liste.parentNode) liste.parentNode.insertBefore(barre, liste);
}
placerHaut(module);
aligner();
}
/* ---- Position de la page apres un filtrage ---- */
function garderPosition() {
positionAGarder = window.pageYOffset;
try { sessionStorage.setItem('sn-b2b-position', positionAGarder + '|' + Date.now()); } catch (e) {}
}
function replacer(y) {
if (window.jQuery) window.jQuery('html, body').stop(true);
window.scrollTo(0, y);
}
function replacerSiDemande() {
var y = positionAGarder;
if (y === null) {
try {
var v = (sessionStorage.getItem('sn-b2b-position') || '').split('|');
if (v.length === 2 && (Date.now() - Number(v[1])) < 15000) y = Number(v[0]);
} catch (e) {}
}
if (y === null || isNaN(y)) return;
positionAGarder = null;
try { sessionStorage.removeItem('sn-b2b-position'); } catch (e) {}
replacer(y);
setTimeout(function () { replacer(y); }, 700);
}
function estRechargement(m) {
var cible = m.target.nodeType === 1 ? m.target : m.target.parentNode;
if (cible && cible.closest && cible.closest('.jq-products-container')) return true;
for (var i = 0; i < m.addedNodes.length; i++) {
var n = m.addedNodes[i];
if (n.nodeType === 1 && (n.classList.contains('jq-products-container') || n.querySelector('.jq-products-container'))) return true;
}
return false;
}
function plusTard(rechargement) {
if (rechargement) listeRafraichie = true;
clearTimeout(minuterie);
minuterie = setTimeout(function () {
construire();
aligner();
if (listeRafraichie) {
listeRafraichie = false;
replacerSiDemande();
}
}, 150);
}
/* Version publique d'All presales / All stock : on ne touche a rien */
function pagePublique() {
preparerOnglets();
return !!PAGE && !onglets;
}
function init() {
if (pagePublique()) return;
document.body.classList.add('sn-b2b');
suivreGroupes();
surveillerEntete();
construire();
replacerSiDemande();
document.addEventListener('change', function (e) {
var n = e.target && e.target.name ? e.target.name : '';
if (n.indexOf('filters[') === 0 || n === 'filter-sorting-type') {
garderPosition();
plusTard(false);
}
});
document.addEventListener('click', function (e) {
if (e.target.closest && e.target.closest('.remove-all-filters, .view-select-filter-content')) {
garderPosition();
}
});
window.addEventListener('resize', function () {
setTimeout(aligner, 200);
});
if (window.MutationObserver) {
new MutationObserver(function (mutations) {
var utile = false;
var rechargement = false;
for (var i = 0; i < mutations.length; i++) {
var t = mutations[i].target;
if (barre && barre.contains(t)) continue;
if (haut && haut.contains(t)) continue;
if (tete && tete.contains(t)) continue;
utile = true;
if (estRechargement(mutations[i])) rechargement = true;
}
if (rechargement && positionAGarder !== null) replacerSiDemande();
if (utile) plusTard(rechargement);
}).observe(document.body, { childList: true, subtree: true });
}
}
/* Classe sn-b2b et boutons d'origine masques tout de suite (le script est
place apres eux dans la page) : pas de clignotement au chargement */
function marquer() {
if (pagePublique()) return;
document.body.classList.add('sn-b2b');
}
if (document.body) marquer();
else document.addEventListener('DOMContentLoaded', marquer, { once: true });
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', init, { once: true });
} else {
init();
}
})();
</script>	</div>
</div>
</div>
